---
import { Image } from "astro:assets";
import maria4 from "../assets/images/maria4.webp";
import CtaBand from "../components/CtaBand.astro";
import Frase from "../components/Frase.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import Sello from "../components/Sello.astro";
import Layout from "../layouts/Layout.astro";

const comoTrabajamos = [
	{
		title: "1. Primer contacto",
		text: "No tienes que traer nada preparado ni preocuparte por decir lo correcto. No existen respuestas perfectas ni formas «ideales» de empezar: estamos aquí para construir juntos ese camino.",
	},
	{
		title: "2. ¿Qué puedes esperar?",
		text: "En esta primera sesión, nuestro objetivo es conocerte. Nos enfocamos en comprender que es lo que te ha traido a consulta, con el objetivo de dar tus primeros pasos hacia el bienestar emocional .",
	},
	{
		title: "3. Estableciendo objetivos",
		text: "Te ayudamos a identificar tus necesidades y expectativas. Juntos definimos los primeros objetivos, para que el proceso terapéutico tenga un rumbo claro y adaptado a ti desde el inicio.",
	},
	{
		title: "4. Tu espacio seguro",
		text: "Tú marcas el ritmo de cada encuentro. Te acompañamos, te guiamos y te cuidamos, ofreciéndote un espacio seguro donde puedes expresarte libremente y sentirte acogido/a.",
	},
];

const beneficios = [
	{
		title: "Bienestar emocional",
		text: "La terapia te ayuda a encontrar tu equilibrio interior, te permite comprender, aceptar, y gestionar las emociones de forma saludable. Para que te sientas capaz de afrontar los retos de la vida con serenidad, flexibilidad y autocompasión.",
	},
	{
		title: "Autoconocimiento",
		text: "La terapia te guía en la exploración y comprensión de tus emociones, pensamientos, necesidades, fortalezas. De esta manera, desarrollarás una mayor claridad interior, y podrás tomar decisiones más coherentes, mejorar las relaciones y vivir de una manera plena.",
	},
	{
		title: "Herramientas",
		text: "Aprenderás estrategias y recursos prácticos para enfrentar retos personales, superar obstáculos y resolver conflictos de manera efectiva.",
	},
	{
		title: "Cambio duradero",
		text: "La terapia te ayuda a lograr mejoras duraderas, consolidando hábitos y recursos que te permiten mantener tu bienestar emocional a largo plazo.",
	},
];

const areas = [
	{
		title: "Gestión emocional, autoestima y autocofianza",
		text: "Aprender a identificar, comprender y regular las emociones. Fortalecer la relación contigo mismo/a, desarrollar una imagen más realista y amable, superando la autocrítica.",
	},
	{
		title: "Ansiedad y estrés",
		text: "Reducir dicha sintomatología física, junto con aquellas preocupaciones, pensamientos y creencias no funcionales.",
	},
	{
		title: "Depresión y desanimo",
		text: "Comprender las causas del malestar emocional, recuperar la motivación y reconstruir el sentido vital.",
	},
	{
		title: "Relaciones interpersonales",
		text: "Mejorar la comunicación, establecer límites saludables y cultivar vínculos más seguros y equiibrados.",
	},
	{
		title: "Duelos y pérdidas. Traumas y experiencias difíciles",
		text: "Acompañar en el proceso de la aceptación y adaptación ante una pérdida o cambio significativo, integrando el dolor y dando paso a una nueva etapa de vida. Poder reconstruir la sensación de seguridad y confianza en ti mismo/a y los demás, así como reducir la sintomatología que acompaña a estas experiencias.",
	},
	{
		title: "Autoconocimiento y crecimiento personal",
		text: "Explorar tu historia, tus valores y tus metas, para vivir de manera más consciente y coherente contigo mismo/a.",
	},
];
---

<Layout
	title="Nuestro Método Terapéutico | Cómo Trabajamos y Beneficios de la Terapia en Pamplona y Online"
	description="Descubre nuestro método de trabajo: un enfoque cercano, integrador y basado en la evidencia. Conoce cómo es la terapia, sus beneficios y en qué áreas puede ayudarte, tanto presencial en Pamplona como online."
>
	<PageHero
		title="Nuestro método terapéutico"
		lead="Un espacio seguro y acompañamiento profesional que integra técnicas basadas en evidencia científica para alcanzar el bienestar que buscas."
		cta={{ href: "/contacto", label: "Reserva tu cita" }}
	/>

	<section class="py-20 lg:py-28">
		<div class="shell grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
			<div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
				<h2 class="text-headline font-extrabold">Como trabajamos</h2>
				<div class="relative mt-10 rounded-card bg-papel p-3 shadow-card sm:p-4">
					<Image
						src={maria4}
						alt="María Sánchez Cobos de pie, con chaqueta verde"
						widths={[400, 640, 864]}
						sizes="(min-width: 1024px) 34vw, 100vw"
						class="aspect-4/5 w-full rounded-sm object-cover object-top"
					/>
					<Sello class="absolute right-2 -bottom-8 size-28 sm:-right-5 sm:size-32" rotate={-12} />
				</div>
			</div>

			{/* One route line joins the four waypoints of the first sessions. */}
			<ol role="list" class="relative grid gap-12 pl-14 sm:pl-20">
				<span
					aria-hidden="true"
					class="absolute top-4 bottom-4 left-4.25 w-1.5 rounded-full bg-[repeating-linear-gradient(to_bottom,var(--color-flecha)_0_1.25rem,transparent_1.25rem_2rem)] sm:left-6.25"
				></span>
				{
					comoTrabajamos.map((paso) => (
						<li class="relative">
							<span
								aria-hidden="true"
								class="absolute top-0 -left-14 grid size-10 place-items-center rounded-full bg-camino text-white ring-4 ring-piedra sm:-left-20 sm:size-14"
							>
								<Icon name="arrow-down" class="size-5 sm:size-6" strokeWidth={2.5} />
							</span>
							<h3 class="text-title">{paso.title}</h3>
							<p class="measure mt-3 text-lead text-tinta-suave">{paso.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<CtaBand
		title="Ahora es tu oportunidad. Comienza a priorizarte."
		text="Ahora es tu oportunidad de dar el primer paso y comenzar a priorizarte, cuidando tu bienestar y dedicando tiempo a lo que realmente necesitas."
		label="Dar el primer paso"
	/>

	<section class="py-20 lg:py-28">
		<div class="shell">
			<div class="grid gap-6 lg:grid-cols-2 lg:items-end">
				<h2 class="text-headline font-extrabold">Los beneficios de nuestro método</h2>
				<p class="measure text-lead text-tinta-suave">
					Descubre cómo otras personas han transformado su vida y bienestar
					emocional gracias a nuestro acompañamiento profesional.
				</p>
			</div>
			<ul role="list" class="mt-12 grid border-t-2 border-tinta md:grid-cols-2 md:gap-x-16">
				{
					beneficios.map((beneficio) => (
						<li class="border-b border-linea py-8 lg:py-10">
							<h3 class="text-title">{beneficio.title}</h3>
							<p class="measure mt-3 text-tinta-suave">{beneficio.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="on-camino bg-camino py-20 text-white lg:py-28">
		<div class="shell">
			<div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
				<h2 class="text-headline font-extrabold">
					Áreas en las que la terapia puede ayudarte
				</h2>
				<p class="measure text-lead text-camino-claro">
					La terapia psicológica es un espacio de acompañamiento, comprensión y
					crecimiento personal. A través del proceso terapéutico, puedes aprender
					a conocerte mejor, gestionar tus emociones y mejorar tu salud mental y
					relacional. Algunas de las áreas más comunes en las que la terapia te
					puede ayudar, son las siguientes:
				</p>
			</div>
			<ul
				role="list"
				class="mt-12 grid border-t-2 border-white md:grid-cols-2 md:gap-x-16"
			>
				{
					areas.map((area) => (
						<li class="border-b border-camino-claro/40 py-8 lg:py-10">
							<h3 class="text-title">{area.title}</h3>
							<p class="measure mt-3 text-camino-claro">{area.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<Frase
		title="La terapia es un espacio donde puedes reencontrarte contigo mismo/a y descubrir nuevas formas de crecer y sanar."
	/>
</Layout>
