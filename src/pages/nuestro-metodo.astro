         </Col>
      </Row>
   </Section> -->

   <Frases
      title="La terapia es un espacio donde puedes reencontrarte contigo mismo/a y descubrir nuevas formas de crecer y sanar."
      classes="lg:pb-15! pl-0!"
      type="block"
   />
</Layout>
