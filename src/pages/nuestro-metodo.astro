---
// Services Page
// ------------
// Description: The services page is a page that displays all the services.

// Components
// - Layout
import Layout from '../layouts/Layout.astro';
// - Blocks
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import Hero from '../components/custom/BasicHeroCTA.astro';
import Frases from '../components/custom/Frases.astro';
import JoinBox from '../components/custom/JoinBox.astro';
import TitleSection from '../components/custom/TitleSection.astro';
import Card from '../components/ui/cards/Card.astro';
import Col from '../components/ui/Col.astro';
import Row from '../components/ui/Row.astro';
import Section from '../components/ui/Section.astro';

const SEO = {
   title: 'Nuestro Método Terapéutico | Cómo Trabajamos y Beneficios de la Terapia en Pamplona y Online',
   description:
      'Descubre nuestro método de trabajo: un enfoque cercano, integrador y basado en la evidencia. Conoce cómo es la terapia, sus beneficios y en qué áreas puede ayudarte, tanto presencial en Pamplona como online.',
};

const preguntas = [
   {
      question: '¿La terapia es presencial, online o ambas?',
      answer: 'Es tanto terapia presencial y online. Depende de lo que quieras.',
   },

   {
      question: '¿Qué tipos de terapia ofrecen?',
      answer:
         'Depende de cada persona y sus necesidades. Desde INALA el abordaje es integral, por lo que se ajusta a cada persona.',
   },
   {
      question: '¿Con qué frecuencia recomiendas asistir a terapia?',
      answer: 'Depende de cada persona y la situación en la que se encuentre.',
   },
   {
      question: '¿Cuánto dura cada sesión?',
      answer: '60 minutos',
   },
   {
      question: '¿Trabajan con adultos, adolescentes y/o niños?',
      answer: 'Si, trabajamos tanto con con niños/as, adolescentes y adultos',
   },
];
---

<Layout title={SEO.title} description={SEO.description}>
   <Hero
      title="Nuestro método terapéutico"
      text="Un espacio seguro y acompañamiento profesional que integra técnicas basadas en evidencia científica para alcanzar el bienestar que buscas."
   />

   <Section classes="mt-0! pt-0!">
      <TitleSection title="Como trabajamos" text="" classes="lg:pb-15! pl-0!" />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6">
            <Card>
               <Image
                  src={'/assets/images/maria4.webp'}
                  alt={'imagen 02'}
                  width={800}
                  height={800}
                  inferSize
                  class="aspect-[3/4] object-cover"
               />
            </Card>
         </Col>
         <Col span="6" classes="flex flex-col gap-5">
            <Card>
               <div class="text-lg">
                  <h3>1. Primer contacto</h3>
                  <p class="">
                     No tienes que traer nada preparado ni preocuparte por decir lo correcto. No
                     existen respuestas perfectas ni formas «ideales» de empezar: estamos aquí para
                     construir juntos ese camino.
                  </p>
               </div>
            </Card>

            <Card>
               <div class="text-lg">
                  <h3>2. ¿Qué puedes esperar?</h3>
                  <p class="">
                     En esta primera sesión, nuestro objetivo es conocerte. Nos enfocamos en
                     comprender que es lo que te ha traido a consulta, con el objetivo de dar tus
                     primeros pasos hacia el bienestar emocional .
                  </p>
               </div>
            </Card>

            <Card>
               <div class="text-lg">
                  <h3>3. Estableciendo objetivos</h3>
                  <p class="">
                     Te ayudamos a identificar tus necesidades y expectativas. Juntos definimos los
                     primeros objetivos, para que el proceso terapéutico tenga un rumbo claro y
                     adaptado a ti desde el inicio.
                  </p>
               </div>
            </Card>

            <Card>
               <div class="text-lg">
                  <h3>4. Tu espacio seguro</h3>
                  <p class="">
                     Tú marcas el ritmo de cada encuentro. Te acompañamos, te guiamos y te cuidamos,
                     ofreciéndote un espacio seguro donde puedes expresarte libremente y sentirte
                     acogido/a.
                  </p>
               </div>
            </Card>
         </Col>
      </Row>
   </Section>

   <JoinBox
      title="Ahora es tu oportunidad. Comienza a priorizarte."
      subtitle="Ahora es tu oportunidad de dar el primer paso y comenzar a priorizarte, cuidando tu bienestar y dedicando tiempo a lo que realmente necesitas."
      buttonText="Dar el primer paso"
   />

   <Section classes="">
      <TitleSection
         title="Los beneficios de nuestro método"
         text="Descubre cómo otras personas han transformado su vida y bienestar emocional gracias a nuestro acompañamiento profesional."
         classes="lg:pb-15! pl-0!"
      />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6" classes="flex flex-col gap-5">
            <Card>
               <div class="mb-4 flex items-center gap-4">
                  <Icon
                     name="check-circle"
                     class="testimonial__quote"
                     size={40}
                     width={40}
                     height={40}
                  />
                  <h3>Bienestar emocional</h3>
               </div>

               <p class="">
                  La terapia te ayuda a encontrar tu equilibrio interior, te permite comprender,
                  aceptar, y gestionar las emociones de forma saludable. Para que te sientas capaz
                  de afrontar los retos de la vida con serenidad, flexibilidad y autocompasión.
               </p>
            </Card>
            <Card>
               <div class="mb-4 flex items-center gap-4">
                  <Icon
                     name="check-circle"
                     class="testimonial__quote"
                     size={40}
                     width={40}
                     height={40}
                  />
                  <h3>Autoconocimiento</h3>
               </div>
               <p class="">
                  La terapia te guía en la exploración y comprensión de tus emociones, pensamientos,
                  necesidades, fortalezas. De esta manera, desarrollarás una mayor claridad
                  interior, y podrás tomar decisiones más coherentes, mejorar las relaciones y vivir
                  de una manera plena.
               </p>
            </Card>
            <Card>
               <div class="mb-4 flex items-center gap-4">
                  <Icon
                     name="check-circle"
                     class="testimonial__quote"
                     size={40}
                     width={40}
                     height={40}
                  />
                  <h3>Herramientas</h3>
               </div>
               <p class="">
                  Aprenderás estrategias y recursos prácticos para enfrentar retos personales,
                  superar obstáculos y resolver conflictos de manera efectiva.
               </p>
            </Card>
            <Card>
               <div class="mb-4 flex items-center gap-4">
                  <Icon
                     name="check-circle"
                     class="testimonial__quote"
                     size={40}
                     width={40}
                     height={40}
                  />
                  <h3>Cambio duradero</h3>
               </div>
               <p class="">
                  La terapia te ayuda a lograr mejoras duraderas, consolidando hábitos y recursos
                  que te permiten mantener tu bienestar emocional a largo plazo.
               </p>
            </Card>
         </Col>
         <Col span="6">
            <Card>
               <Image
                  src={'/assets/images/image7.png'}
                  alt={'imagen 02'}
                  width={800}
                  height={800}
                  inferSize
                  class={'object-cover aspect-[3/4]'}
               />
            </Card>
         </Col>
      </Row>
   </Section>

   <Section type="alt">
      <TitleSection
         title="Áreas en las que la terapia puede ayudarte"
         text="La terapia psicológica es un espacio de acompañamiento, comprensión y crecimiento personal. A través del proceso terapéutico, puedes aprender a conocerte mejor, gestionar tus emociones y mejorar tu salud mental y relacional. Algunas de las áreas más comunes en las que la terapia te puede ayudar, son las siguientes:"
         classes="lg:pb-15! pl-0!"
      />
      <Row classes="mb-5">
         <Col span="4">
            <Card>
               <Icon name="bell" class="size-15 pb-3" />
               <h3>Gestión emocional, autoestima y autocofianza</h3>
               <p class="last:mb-0">
                  Aprender a identificar, comprender y regular las emociones. Fortalecer la relación
                  contigo mismo/a, desarrollar una imagen más realista y amable, superando la
                  autocrítica.
               </p>
            </Card>
         </Col>
         <Col span="4">
            <Card>
               <Icon name="bell" class="size-15 pb-3" />
               <h3>Ansiedad y estrés</h3>
               <p class="last:mb-0">
                  Reducir dicha sintomatología física, junto con aquellas preocupaciones,
                  pensamientos y creencias no funcionales.
               </p>
            </Card>
         </Col>
         <Col span="4">
            <Card>
               <Icon name="bell" class="size-15 pb-3" />
               <h3>Depresión y desanimo</h3>
               <p class="last:mb-0">
                  Comprender las causas del malestar emocional, recuperar la motivación y
                  reconstruir el sentido vital.
               </p>
            </Card>
         </Col>
      </Row>
      <Row>
         <Col span="4">
            <Card>
               <Icon name="bell" class="size-15 pb-3" />
               <h3>Relaciones interpersonales</h3>
               <p class="last:mb-0">
                  Mejorar la comunicación, establecer límites saludables y cultivar vínculos más
                  seguros y equiibrados.
               </p>
            </Card>
         </Col>
         <Col span="4">
            <Card>
               <Icon name="bell" class="size-15 pb-3" />
               <h3>Duelos y pérdidas. Traumas y experiencias difíciles</h3>
               <p class="last:mb-0">
                  Acompañar en el proceso de la aceptación y adaptación ante una pérdida o cambio
                  significativo, integrando el dolor y dando paso a una nueva etapa de vida. Poder
                  reconstruir la sensación de seguridad y confianza en ti mismo/a y los demás, así
                  como reducir la sintomatología que acompaña a estas experiencias.
               </p>
            </Card>
         </Col>
         <Col span="4">
            <Card>
               <Icon name="bell" class="size-15 pb-3" />
               <h3>Autoconocimiento y crecimiento personal</h3>
               <p class="last:mb-0">
                  Explorar tu historia, tus valores y tus metas, para vivir de manera más consciente
                  y coherente contigo mismo/a.
               </p>
            </Card>
         </Col>
      </Row>
   </Section>

