---
import processImage from "../assets/images/maria3.webp";
import therapistImage from "../assets/images/maria4.webp";
import heroImage from "../assets/images/nuestro_metodo.jpeg";
import officeImage from "../assets/images/oficina.webp";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Figure from "../components/ui/Figure.astro";
import Icon from "../components/ui/Icon.astro";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import TopicList from "../components/ui/TopicList.astro";
import {
	address,
	addressCenter,
	addressCity,
	contactHref,
	ctaLabel,
	ctaNote,
	email,
	licenseNumber,
} from "../data/site";
import Layout from "../layouts/Layout.astro";

const title = "Cómo trabajo: terapia integradora en Pamplona y online | Inala";

const description =
	"Cómo trabajo en terapia: un enfoque cercano, integrador y basado en la evidencia. Qué esperar de la primera sesión, cómo avanza el proceso y las modalidades presencial en Pamplona y online.";

const heroStats = [
	{ value: "Pamplona", label: "y online" },
	{ value: "60 min", label: "por sesión" },
	{ value: licenseNumber, label: "Nº de colegiada", wide: true },
];

const heroBadges = [
	{ icon: "science", label: "Basado en la evidencia" },
	{ icon: "verified_user", label: "Sin juicios" },
];

const pillars = [
	{
		icon: "psychology",
		title: "Enfoque integrador y basado en la evidencia",
		text: "Combino distintos enfoques con respaldo científico y elijo en cada caso los que mejor encajan con tu historia y con lo que necesitas.",
		tag: "Adaptado a ti",
	},
	{
		icon: "favorite",
		title: "Una relación de confianza",
		text: "La relación entre tú y yo es lo que hace posible el cambio. Aquí puedes hablar con libertad, sin juicios y con total confidencialidad.",
		tag: "Sin juicios",
	},
	{
		icon: "self_improvement",
		title: "Herramientas prácticas",
		text: "Desde las primeras sesiones te llevas recursos concretos para entender y manejar tus emociones en tu día a día.",
		tag: "Para el día a día",
	},
];

const steps = [
	{
		number: "01",
		icon: "chat_bubble_outline",
		title: "Primer contacto",
		text: "No tienes que traer nada preparado ni preocuparte por decir lo correcto. No existen respuestas perfectas ni formas «ideales» de empezar: ese camino lo construimos juntos.",
	},
	{
		number: "02",
		icon: "visibility",
		title: "Primera sesión",
		text: "En la primera sesión mi objetivo es conocerte y entender qué te ha traído a consulta. Tú decides cuánto quieres contar.",
	},
	{
		number: "03",
		icon: "flag",
		title: "Estableciendo objetivos",
		text: "Te ayudo a poner en palabras lo que necesitas y lo que esperas de la terapia. Juntos definimos los primeros objetivos para que el proceso tenga un rumbo claro desde el inicio.",
	},
	{
		number: "04",
		icon: "shield_with_heart",
		title: "A tu ritmo",
		text: "Tú marcas el ritmo de cada sesión. Te acompaño, te guío y revisamos juntos cómo vas avanzando.",
	},
];

const benefits = [
	{
		icon: "favorite",
		title: "Bienestar emocional",
		text: "Aprender a comprender, aceptar y gestionar tus emociones, para afrontar los retos del día a día con más serenidad y menos autoexigencia.",
	},
	{
		icon: "psychology",
		title: "Autoconocimiento",
		text: "Entender mejor tus emociones, pensamientos, necesidades y fortalezas, para tomar decisiones más coherentes contigo y cuidar tus relaciones.",
	},
	{
		icon: "handyman",
		title: "Herramientas",
		text: "Estrategias y recursos prácticos para afrontar dificultades y resolver conflictos en tu día a día.",
	},
	{
		icon: "eco",
		title: "Autonomía",
		text: "Consolidar lo aprendido para que puedas seguir cuidándote por tu cuenta cuando termine la terapia.",
	},
];

const therapistHighlights = [
	{
		icon: "favorite",
		label: "Acompañamiento respetuoso y sin juicios",
	},
	{
		icon: "science",
		label: "Enfoque integrador basado en la evidencia",
	},
	{
		icon: "pace",
		label: "Atención personalizada, a tu ritmo",
	},
];

const modalities = [
	{
		badge: "Presencial · Pamplona",
		image: officeImage,
		imageAlt:
			"Consulta de Inala en Pamplona: escritorio blanco con dos sillas verde agua, armarios a juego y luz natural.",
		title: "En mi consulta de Pamplona",
		text: "Una consulta tranquila y con luz natural, dentro del Centro Yssana.",
		features: [
			{
				icon: "location_on",
				label: `${address}, ${addressCity}`,
			},
			{
				icon: "apartment",
				label: addressCenter,
			},
		],
		cta: ctaLabel,
	},
	{
		badge: "Online",
		visualTitle: "Terapia online",
		visualText: "Por videollamada",
		title: "Por videollamada, desde donde estés",
		text: "Útil si vives lejos de Pamplona, viajas a menudo o te resulta más cómodo desde casa. Trabajo igual que en la consulta presencial.",
		features: [
			{
				icon: "lock",
				label: "Plataforma segura y cifrada que cumple la normativa de protección de datos",
			},
			{
				icon: "sync_alt",
				label: "Puedes combinar sesiones online y presenciales",
			},
		],
		cta: ctaLabel,
	},
];
---

<Layout title={title} description={description}>
	<PageHero
		backgroundImage={heroImage}
		label="Enfoque integrador y basado en la evidencia"
	>
		<Fragment slot="title">
			Cómo trabajo: cercanía y{" "}
			<span>a tu propio ritmo</span>
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Combino una relación de confianza con enfoques respaldados por la
			investigación. El objetivo: que entiendas lo que te pasa y tengas
			herramientas para sentirte mejor, sin prisas.
		</p>
		<div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
			<Button href={contactHref} icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
			<Button href="#proceso" variant="secondary" arrow>
				<span>Ver cómo es el proceso</span>
			</Button>
		</div>
		<figure class="mt-4 flex flex-col gap-5 border-t border-line pt-6">
			<figcaption class="text-label font-semibold text-teal">
				<span>Mi compromiso</span>
			</figcaption>
			<blockquote class="font-display text-subheading font-normal text-ink">
				«No creo en fórmulas estándar: adapto la terapia a ti, nunca a la
				inversa.»
			</blockquote>
			<dl class="flex flex-wrap gap-x-10 gap-y-4">
				{
					heroStats.map((stat) => (
						<div class="flex flex-col-reverse">
							<dt class="text-label text-ink-muted">{stat.label}</dt>
							<dd class="text-small font-semibold text-ink tabular-nums">
								{stat.value}
							</dd>
						</div>
					))
				}
			</dl>
		</figure>
		<div slot="media" class="flex flex-col gap-6">
			<ul class="flex flex-wrap gap-2">
				{
					heroBadges.map((badge) => (
						<li class="inline-flex min-h-9 items-center gap-2 rounded-full border border-line-strong px-4 text-label font-semibold text-ink">
							<Icon name="check" class="text-teal" />
							{badge.label}
						</li>
					))
				}
			</ul>
			<div class="flex flex-col gap-2 border-t border-line pt-5">
				<p class="text-small font-semibold text-ink">
					El vínculo como motor de cambio
				</p>
				<p class="text-body text-ink-muted">
					La confianza entre tú y yo es la base para construir recursos que
					te sirvan a largo plazo.
				</p>
			</div>
		</div>
	</PageHero>

	<!-- Pilares del método -->
	<Section tone="white">
		<SectionHeader
			title="Tres principios de mi forma de trabajar"
			label="En qué me baso"
		/>
		<TopicList
			items={pillars.map((pillar) => ({ ...pillar, note: pillar.tag }))}
			columns={3}
			class="mt-14"
		/>
	</Section>

	<!-- Cómo es el proceso -->
	<Section id="proceso">
		<SectionHeader title="Cómo es el proceso" label="Paso a paso" />
		<div class="mt-14 grid gap-x-16 gap-y-12 lg:grid-cols-12 lg:items-start">
			<div class="flex flex-col gap-6 lg:col-span-5">
				<Figure
					src={processImage}
					alt="María Sánchez sonriendo, de pie ante una pared blanca, con chaleco negro y blusa blanca."
					ratio="portrait"
				>
					<Icon name="verified" class="text-teal" />
					<span>Acompañamiento cercano y personalizado</span>
				</Figure>
				<div class="flex flex-col gap-3 border-t border-line pt-5">
					<p class="flex flex-col">
						<span class="font-display text-subheading text-ink"
							>María Sánchez</span
						>
						<span class="text-label text-ink-muted"
							>Psicóloga general sanitaria</span
						>
					</p>
					<p class="font-display text-lead text-teal">
						«Te acompaño con rigor y calidez para que encuentres un lugar
						donde ser tú mismo/a»
					</p>
				</div>
			</div>
			<ol class="lg:col-span-7">
				{
					steps.map((step) => (
						<li class="flex gap-6 border-t border-line py-8 first:border-t-0 first:pt-0">
							<span class="w-10 shrink-0 font-display text-heading leading-none text-teal tabular-nums">
								{step.number}
							</span>
							<div class="flex flex-col gap-2.5">
								<h3 class="text-lead font-semibold text-ink">
									{step.title}
								</h3>
								<p class="text-body text-ink-muted">{step.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</Section>

	<!-- Beneficios -->
	<Section tone="white">
		<SectionHeader
			title="Lo que la terapia puede ayudarte a trabajar"
			label="Qué puedes trabajar"
		>
			<p>
				Estos son algunos de los cambios que se trabajan en terapia. Cada
				proceso es distinto y avanza a su ritmo.
			</p>
		</SectionHeader>
		<TopicList items={benefits} columns={2} class="mt-14 lg:grid-cols-4" />
	</Section>

	<!-- Conoce a tu terapeuta -->
	<Section>
		<div class="grid gap-x-16 gap-y-12 lg:grid-cols-12 lg:items-center">
			<div class="flex flex-col gap-6 lg:order-2 lg:col-span-7">
				<SectionHeader
					title="Cercanía, rigor y una mirada humana"
					label="Quién te acompaña"
					layout="stack"
				>
					<p>
						Me llamo María y soy quien te atenderá en Inala. Mi propósito
						es acompañarte con empatía, rigor y presencia en cada paso de
						tu proceso.
					</p>
					<p class="mt-4">
						Antes de la psicología trabajé en la empresa, y eso me ayuda a
						entender de cerca el estrés y la autoexigencia.
					</p>
				</SectionHeader>
				<ul class="flex flex-col gap-3">
					{
						therapistHighlights.map((item) => (
							<li class="flex items-start gap-3 text-body text-ink">
								<Icon name="check" class="mt-0.5 text-teal" />
								<span>{item.label}</span>
							</li>
						))
					}
				</ul>
				<a
					href="/sobre-mi"
					class="group inline-flex min-h-11 items-center gap-2 self-start text-small font-semibold text-teal underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color] duration-200 hover:text-teal-strong hover:decoration-current"
				>
					<span>Conocer mi trayectoria</span>
					<Icon
						name="arrow_forward"
						class="transition-[translate] duration-200 ease-out motion-safe:group-hover-fine:translate-x-0.5"
					/>
				</a>
			</div>
			<Figure
				src={therapistImage}
				alt="María Sánchez sonriendo, de pie, con traje verde salvia y camiseta gris."
				ratio="portrait"
				class="lg:order-1 lg:col-span-5"
			>
				<Icon name="verified" class="text-teal" />
				<span>
					<span class="block">
						Formación en terapia familiar y de pareja y en salud perinatal
					</span>
					<span class="block font-semibold text-ink">María Sánchez</span>
					<span class="block"
						>Psicóloga general sanitaria · Nº col. {licenseNumber}</span
					>
				</span>
			</Figure>
		</div>
	</Section>

	<!-- Modalidades de consulta -->
	<Section tone="white">
		<SectionHeader title="Dónde son las sesiones" label="Presencial u online">
			<p>
				Elige la opción que mejor encaje con tu vida. Las sesiones duran 60
				minutos en ambos casos.
			</p>
		</SectionHeader>
		<ul class="mt-14 grid gap-x-12 gap-y-14 md:grid-cols-2">
			{
				modalities.map((modality, index) => (
					<li class="flex flex-col gap-6">
						{modality.image ? (
							<Figure
								src={modality.image}
								alt={modality.imageAlt ?? ""}
								ratio="wide"
								sizes="(min-width: 768px) 45vw, 100vw"
							>
								<Icon name="location_on" class="text-teal" />
								<span class="font-semibold text-ink">
									{modality.badge}
								</span>
							</Figure>
						) : (
							<div class="flex flex-col gap-3">
								<div class="flex aspect-16/10 flex-col items-start justify-end gap-2 rounded-frame bg-cypress p-8 text-on-dark">
									<Icon name="videocam" class="size-10 text-seafoam" />
									<span class="font-display text-heading">
										{modality.visualTitle}
									</span>
									<span class="text-small text-on-dark-muted">
										{modality.visualText}
									</span>
								</div>
								<p class="flex items-center gap-2 text-label">
									<Icon name="videocam" class="text-teal" />
									<span class="font-semibold text-ink">
										{modality.badge}
									</span>
								</p>
							</div>
						)}
						<div class="flex flex-1 flex-col gap-3">
							<h3 class="font-display text-subheading font-normal text-ink">
								{modality.title}
							</h3>
							<p class="text-body text-ink-muted">{modality.text}</p>
							<ul class="mt-2 flex flex-col gap-2 border-t border-line pt-4">
								{modality.features.map((feature) => (
									<li class="flex items-start gap-3 text-small text-ink">
										<Icon name="check" class="mt-0.5 text-teal" />
										<span>{feature.label}</span>
									</li>
								))}
							</ul>
						</div>
						<div>
							<Button
								href={contactHref}
								variant={index === 0 ? "secondary" : "primary"}
								arrow
							>
								<span>{modality.cta}</span>
							</Button>
						</div>
					</li>
				))
			}
		</ul>
	</Section>

	<CtaBand label="Cuando lo sientas" title="¿Te gustaría empezar?">
		<p>
			En la primera sesión nos conocemos, hablamos de tu momento y valoramos
			juntos cómo puedo acompañarte. {ctaNote}
		</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
			<Button href={`mailto:${email}`} variant="inverse-outline" icon="mail">
				<span>Escribirme a {email}</span>
			</Button>
		</Fragment>
	</CtaBand>
</Layout>
