---
import processImage from "../assets/images/maria3.webp";
import heroImage from "../assets/images/nuestro_metodo.jpeg";
import officeImage from "../assets/images/oficina.webp";
import OtherServices from "../components/OtherServices.astro";
import PageHero from "../components/PageHero.astro";
import SessionExpect from "../components/SessionExpect.astro";
import Button from "../components/ui/Button.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Figure from "../components/ui/Figure.astro";
import Icon from "../components/ui/Icon.astro";
import type { IconName } from "../components/ui/icons";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import {
	address,
	addressCenter,
	addressCity,
	contactHref,
	ctaLabel,
	email,
	licenseNumber,
} from "../data/site";
import Layout from "../layouts/Layout.astro";

const title = "Cómo trabajo: terapia integradora en Pamplona | Inala Psicoterapia";

const description =
	"Un enfoque cercano, integrador y basado en la evidencia: qué esperar de la primera sesión y cómo avanza el proceso, en Pamplona y online.";

const pillars: { icon: IconName; title: string; text: string; tag: string }[] = [
	{
		icon: "psychology",
		title: "Enfoque integrador y basado en la evidencia",
		text: "Combino distintos enfoques con respaldo científico y elijo en cada caso los que mejor encajan con tu historia y con lo que necesitas.",
		tag: "Adaptado a ti",
	},
	{
		icon: "favorite",
		title: "Una relación de confianza",
		text: "La relación entre tú y yo es lo que hace posible el cambio. Aquí puedes hablar con libertad, sin juicios y con total confidencialidad.",
		tag: "Sin juicios",
	},
	{
		icon: "self_improvement",
		title: "Herramientas prácticas",
		text: "Desde las primeras sesiones te llevas recursos concretos para entender y manejar tus emociones en tu día a día.",
		tag: "Para el día a día",
	},
];

const steps = [
	{
		number: "01",
		icon: "chat_bubble_outline",
		title: "Primer contacto",
		text: "No tienes que traer nada preparado ni preocuparte por decir lo correcto. No existen respuestas perfectas ni formas «ideales» de empezar: ese camino lo construimos juntos.",
	},
	{
		number: "02",
		icon: "visibility",
		title: "Primera sesión",
		text: "En la primera sesión mi objetivo es conocerte y entender qué te ha traído a consulta. Tú decides cuánto quieres contar.",
	},
	{
		number: "03",
		icon: "flag",
		title: "Estableciendo objetivos",
		text: "Te ayudo a poner en palabras lo que necesitas y lo que esperas de la terapia. Juntos definimos los primeros objetivos para que el proceso tenga un rumbo claro desde el inicio.",
	},
	{
		number: "04",
		icon: "shield_with_heart",
		title: "A tu ritmo",
		text: "Tú marcas el ritmo de cada sesión. Te acompaño, te guío y revisamos juntos cómo vas avanzando.",
	},
];

const sessionSteps: {
	icon: IconName;
	title: string;
	text: string;
	tag: string;
}[] = [
	{
		icon: "hearing",
		title: "Escucha activa real",
		text: "Sin prisas, interrupciones ni diagnósticos apresurados. Escucho tu historia con atención y respeto.",
		tag: "Un espacio para ti",
	},
	{
		icon: "explore",
		title: "Claridad y dirección",
		text: "Te explicaré en qué punto estamos, qué estamos trabajando y hacia dónde vamos.",
		tag: "Transparencia activa",
	},
	{
		icon: "build_circle",
		title: "Herramientas aplicables",
		text: "No nos quedamos en la teoría: trabajaremos recursos prácticos que puedas usar en tu día a día.",
		tag: "Autonomía vital",
	},
	{
		icon: "hourglass_empty",
		title: "Respeto a tus tiempos",
		text: "Jamás te forzaré a abrir recuerdos o heridas para los que tu sistema nervioso aún no esté preparado. Caminamos a tu velocidad.",
		tag: "Seguridad primero",
	},
];

const benefits: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "favorite",
		title: "Bienestar emocional",
		text: "Aprender a comprender, aceptar y gestionar tus emociones, para afrontar los retos del día a día con más serenidad y menos autoexigencia.",
	},
	{
		icon: "psychology",
		title: "Autoconocimiento",
		text: "Entender mejor tus emociones, pensamientos, necesidades y fortalezas, para tomar decisiones más coherentes contigo y cuidar tus relaciones.",
	},
	{
		icon: "handyman",
		title: "Herramientas",
		text: "Estrategias y recursos prácticos para afrontar dificultades y resolver conflictos en tu día a día.",
	},
	{
		icon: "eco",
		title: "Autonomía",
		text: "Consolidar lo aprendido para que puedas seguir cuidándote por tu cuenta cuando termine la terapia.",
	},
];

const therapistHighlights = [
	{
		icon: "favorite",
		label: "Acompañamiento respetuoso y sin juicios",
	},
	{
		icon: "science",
		label: "Enfoque integrador basado en la evidencia",
	},
	{
		icon: "pace",
		label: "Atención personalizada, a tu ritmo",
	},
];

const modalities = [
	{
		badge: "Presencial · Pamplona",
		image: officeImage,
		imageAlt:
			"Consulta de Inala en Pamplona: escritorio blanco con dos sillas verde agua, armarios a juego y luz natural.",
		title: "En mi consulta de Pamplona",
		text: "Una consulta tranquila y con luz natural, dentro del Centro Yssana.",
		features: [
			{
				icon: "location_on",
				label: `${address}, ${addressCity}`,
			},
			{
				icon: "apartment",
				label: addressCenter,
			},
		],
		cta: ctaLabel,
	},
	{
		badge: "Online",
		visualTitle: "Terapia online",
		visualText: "Por videollamada",
		title: "Por videollamada, desde donde estés",
		text: "Útil si vives lejos de Pamplona, viajas a menudo o te resulta más cómodo desde casa. Trabajo igual que en la consulta presencial.",
		features: [
			{
				icon: "lock",
				label: "Plataforma segura y cifrada que cumple la normativa de protección de datos",
			},
			{
				icon: "sync_alt",
				label: "Puedes combinar sesiones online y presenciales",
			},
		],
		cta: ctaLabel,
	},
];
---

<Layout title={title} description={description} heroFont>
	<PageHero
		size="display"
		accent
		backgroundImage={heroImage}
		mobileBackground="corner"
	>
		<Fragment slot="title">
			{
				/* Below lg each run is its own line, sized from the viewport width so
			  the lead is the larger and both always fit on one line. */
			}
			<span class="max-lg:block max-lg:text-hero-lead">Cómo trabajo:</span
			>{" "}
			<span class="hero-accent max-lg:block max-lg:text-hero-run"
				>cercanía y a tu propio ritmo</span
			>
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Combino una relación de confianza con enfoques respaldados por la
			investigación. El objetivo: que entiendas lo que te pasa y tengas
			herramientas para sentirte mejor, sin prisas.
		</p>

		<div class="flex flex-wrap gap-3 pt-2">
			<Button href={contactHref} icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
		</div>
	</PageHero>

	<!-- Pilares del método: three discs joined by a thread that draws on scroll (global.css, .pillars). -->
	<Section tone="white">
		<SectionHeader title="Tres principios de mi forma de trabajar" />
		<ul class="pillars mt-14 grid gap-12 lg:grid-cols-3 lg:gap-x-10">
			{
				pillars.map((pillar, index) => (
					<li class="pillar relative flex gap-6 lg:flex-col lg:gap-8" style={`--i: ${index}`}>
						<span class="pillar-disc relative z-10 grid size-16 shrink-0 place-items-center rounded-full bg-seafoam-soft text-heading text-teal lg:size-24">
							<Icon name={pillar.icon} class="pillar-icon" />
						</span>
						<div class="pillar-copy flex flex-col gap-3 pt-3 lg:pt-0 lg:pr-4">
							<h3 class="font-display text-subheading font-normal text-ink">
								{pillar.title}
							</h3>
							<p class="text-body text-ink-muted">{pillar.text}</p>
							<p class="mt-1 flex items-center gap-3 text-small font-semibold text-teal">
								<span class="h-px w-8 bg-seafoam" aria-hidden="true" />
								<span>{pillar.tag}</span>
							</p>
						</div>
					</li>
				))
			}
		</ul>
	</Section>

	<!-- Cómo es el proceso: a rail that fills to the reading line, lighting each step (global.css, .process). -->
	<Section id="proceso">
		<SectionHeader title="Cómo es el proceso" />
		<div class="mt-14 grid gap-x-16 gap-y-12 lg:grid-cols-12 lg:items-start">
			<div class="flex flex-col gap-6 lg:col-span-5">
				<Figure src={heroImage} alt="" ratio="portrait">
					<Icon name="verified" class="text-teal" />
					<span>Acompañamiento cercano y personalizado</span>
				</Figure>
				<div class="flex flex-col gap-3 border-t border-line pt-5">
					<p class="flex flex-col">
						<span class="font-display text-subheading text-ink"
							>María Sánchez</span
						>
						<span class="text-label text-ink-muted"
							>Psicóloga general sanitaria</span
						>
					</p>
					<p class="font-display text-lead text-teal">
						«Te acompaño con rigor y calidez para que encuentres un lugar
						donde ser tú mismo/a»
					</p>
				</div>
			</div>
			<ol class="process -mt-8 lg:col-span-7">
				{
					steps.map((step) => (
						<li class="process-step relative flex gap-5 py-8 lg:gap-8">
							<span
								class="process-node relative z-10 mt-1 size-6 shrink-0 rounded-full border border-line-strong bg-paper lg:mt-2.5"
								aria-hidden="true"
							/>
							<div class="flex flex-col gap-3">
								<div class="flex items-baseline gap-4">
									<span class="font-display text-heading leading-none text-teal tabular-nums">
										{step.number}
									</span>
									<h3 class="font-display text-subheading font-normal text-ink">
										{step.title}
									</h3>
								</div>
								<p class="text-body text-ink-muted">{step.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</Section>

	<!-- Qué esperar en sesión: a pinned slider the scroll carries across (SessionExpect.astro, global.css). -->
	<Section tone="mist" class="overflow-x-clip scroll-driven:py-0">
		<SessionExpect items={sessionSteps}>
			<SectionHeader
				slot="header"
				title="¿Qué puedes esperar en sesión conmigo?"
			
			>
				<p>
					La psicoterapia no es un monólogo ni un proceso misterioso. Es una
					conversación en la que trabajamos juntas o juntos, con objetivos claros.
				</p>
			</SectionHeader>
		</SessionExpect>
	</Section>

	<!-- Beneficios: swipeable on phones, panels unfold on scroll, discs light on hover (global.css, .benefits). -->
	<Section tone="white">
		<SectionHeader
			title="Lo que la terapia puede ayudarte a trabajar"
			label="Qué puedes trabajar"
		>
			<p>
				Estos son algunos de los cambios que se trabajan en terapia. Cada
				proceso es distinto y avanza a su ritmo.
			</p>
		</SectionHeader>
		<ul
			class="benefits -mx-5 mt-14 flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain px-5 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4"
		>
			{
				benefits.map((benefit, index) => (
					<li
						class="benefit group flex shrink-0 basis-4/5 snap-center flex-col gap-5 rounded-frame bg-paper p-7 sm:basis-auto"
						style={`--i: ${index}`}
					>
						<span class="benefit-disc relative grid size-16 place-items-center rounded-full bg-seafoam-soft text-heading text-teal">
							<Icon name={benefit.icon} class="benefit-icon relative" />
						</span>
						<div class="flex flex-col gap-2.5">
							<h3 class="font-display text-subheading font-normal text-ink hyphens-auto">
								{benefit.title}
							</h3>
							<p class="text-body text-ink-muted">{benefit.text}</p>
						</div>
					</li>
				))
			}
		</ul>
	</Section>

	<!-- Conoce a tu terapeuta: the photo drifts in its frame, the highlights tick in on scroll (global.css). -->
	<Section>
		<div class="grid gap-x-16 gap-y-12 lg:grid-cols-12 lg:items-center">
			<div class="therapist-copy flex flex-col gap-6 lg:order-2 lg:col-span-7">
				<SectionHeader
					title="Cercanía, rigor y una mirada humana"
					label="Quién te acompaña"
					layout="stack"
				>
					<p>
						Me llamo María y soy quien te atenderá en Inala. Mi propósito
						es acompañarte con empatía, rigor y presencia en cada paso de
						tu proceso.
					</p>
					<p class="mt-4">
						Antes de la psicología trabajé en la empresa, y eso me ayuda a
						entender de cerca el estrés y la autoexigencia.
					</p>
				</SectionHeader>
				<ul class="highlights flex flex-col gap-3">
					{
						therapistHighlights.map((item, index) => (
							<li class="flex items-start gap-3 text-body text-ink" style={`--i: ${index}`}>
								<span class="highlight-tick grid size-7 shrink-0 place-items-center rounded-full bg-seafoam-soft text-teal">
									<Icon name="check" class="highlight-check" />
								</span>
								<span class="highlight-label pt-0.5">{item.label}</span>
							</li>
						))
					}
				</ul>
				<a
					href="/sobre-mi"
					class="group inline-flex min-h-11 items-center gap-2 self-start text-small font-semibold text-teal underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color] duration-200 hover:text-teal-strong hover:decoration-current"
				>
					<span>Conocer mi trayectoria</span>
					<Icon
						name="arrow_forward"
						class="transition-[translate] duration-200 ease-out motion-safe:group-hover-fine:translate-x-0.5"
					/>
				</a>
			</div>
			<Figure
				src={processImage}
				alt="María Sánchez sonriendo, de pie, con traje verde salvia y camiseta gris."
				ratio="portrait"
				class="lg:order-1 lg:col-span-5"
				imgClass="therapist-photo"
			>
				<Icon name="verified" class="text-teal" />
				<span>
					<span class="block">
						Formación en terapia familiar y de pareja y en salud perinatal
					</span>
					<span class="block font-semibold text-ink">María Sánchez</span>
					<span class="block"
						>Psicóloga general sanitaria · Nº col. {licenseNumber}</span
					>
				</span>
			</Figure>
		</div>
	</Section>
<CtaBand label="Cuando lo sientas" title="¿Te gustaría empezar?">
		<p>
			En la primera sesión nos conocemos, hablamos de tu momento y valoramos
			juntos cómo puedo acompañarte.
		</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
			<Button href={`mailto:${email}`} variant="inverse-outline" icon="mail">
				<span>Escribirme a {email}</span>
			</Button>
		</Fragment>
	</CtaBand>

	<!-- Modalidades de consulta -->
	<Section tone="white">
		<SectionHeader title="Dónde son las sesiones" label="Presencial u online">
			<p>
				Elige la opción que mejor encaje con tu vida. Las sesiones duran 60
				minutos en ambos casos.
			</p>
		</SectionHeader>
		<ul class="mt-14 grid gap-x-12 gap-y-14 md:grid-cols-2">
			{
				modalities.map((modality, index) => (
					<li class="flex flex-col gap-6">
						{modality.image ? (
							<Figure
								src={modality.image}
								alt={modality.imageAlt ?? ""}
								ratio="wide"
								sizes="(min-width: 768px) 45vw, 100vw"
							>
								<Icon name="location_on" class="text-teal" />
								<span class="font-semibold text-ink">
									{modality.badge}
								</span>
							</Figure>
						) : (
							<div class="flex flex-col gap-3">
								<div class="flex aspect-16/10 flex-col items-start justify-end gap-2 rounded-frame bg-cypress p-8 text-on-dark">
									<Icon name="videocam" class="size-10 text-seafoam" />
									<span class="font-display text-heading">
										{modality.visualTitle}
									</span>
									<span class="text-small text-on-dark-muted">
										{modality.visualText}
									</span>
								</div>
								<p class="flex items-center gap-2 text-label">
									<Icon name="videocam" class="text-teal" />
									<span class="font-semibold text-ink">
										{modality.badge}
									</span>
								</p>
							</div>
						)}
						<div class="flex flex-1 flex-col gap-3">
							<h3 class="font-display text-subheading font-normal text-ink">
								{modality.title}
							</h3>
							<p class="text-body text-ink-muted">{modality.text}</p>
							<ul class="mt-2 flex flex-col gap-2 border-t border-line pt-4">
								{modality.features.map((feature) => (
									<li class="flex items-start gap-3 text-small text-ink">
										<Icon name="check" class="mt-0.5 text-teal" />
										<span>{feature.label}</span>
									</li>
								))}
							</ul>
						</div>
						<div>
							<Button
								href={contactHref}
								variant={index === 0 ? "secondary" : "primary"}
								arrow
							>
								<span>{modality.cta}</span>
							</Button>
						</div>
					</li>
				))
			}
		</ul>
	</Section>
	<OtherServices heading="Servicios" />
</Layout>
