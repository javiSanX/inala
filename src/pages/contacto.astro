---
import {
	address,
	addressCenter,
	addressCity,
	crisisNotice,
	email,
	legalLinks,
	licenseNumber,
	phoneHref,
	services as siteServices,
	therapistName,
	whatsappNumber,
	whatsappUrl,
} from "../data/site";
import Layout from "../layouts/Layout.astro";

const title =
	"Contacto y primera cita | Psicóloga sanitaria en Pamplona y online";
const description = `Contacta con ${therapistName}, psicóloga general sanitaria en Pamplona. Solicita tu primera cita, presencial u online, por formulario, email o WhatsApp.`;

const mapsUrl =
	"https://www.google.com/maps/search/?api=1&query=Calle+Mar%C3%ADa+Lacunza+6+Pamplona";
const privacyHref =
	legalLinks.find((link) => link.name === "Política de privacidad")?.href ??
	"/";

// Same names as the rest of the site, plus a general enquiry option.
const services = [
	...siteServices.map((service) => ({ label: service.name, wide: false })),
	{ label: "Consulta general / Información", wide: true },
];

const modalities = [
	{
		value: "presencial",
		icon: "location_on",
		label: "Presencial en Pamplona",
		note: `(${addressCenter})`,
	},
	{
		value: "online",
		icon: "videocam",
		label: "Online",
		note: "(Videollamada)",
	},
	{
		value: "indiferente",
		icon: "tune",
		label: "Me da igual",
		note: "(Lo valoramos juntos)",
	},
];

const faqs = [
	{
		question: "¿Cómo sé si me conviene la modalidad presencial u online?",
		answer:
			"Depende de lo que te resulte más cómodo. Si te ayuda venir a un espacio distinto de tu casa, la consulta de Pamplona es una buena opción. Si tienes poco tiempo o vives lejos, la videollamada te evita desplazamientos. También puedes combinar ambas, y si dudas lo hablamos en el primer contacto.",
		open: true,
	},
	{
		question:
			"¿Qué confidencialidad tienen los datos que envío por este formulario?",
		answer:
			"Todo lo que me cuentes está protegido por el secreto profesional y se trata conforme al RGPD. Ten en cuenta que el formulario no envía nada por sí solo: prepara un mensaje en tu aplicación de correo y eres tú quien lo envía desde tu cuenta. Si prefieres no dar detalles por escrito, basta con tu nombre y tu teléfono.",
	},
	{
		question: "¿Cuánto tardas en responder?",
		answer:
			"Respondo personalmente cada mensaje, normalmente en [PENDIENTE: plazo habitual de respuesta].",
	},
];

const card =
	"bg-surface-container-lowest rounded-2xl p-6 sm:p-7 shadow-[0_4px_24px_rgba(36,105,91,0.06)] border border-border-subtle";
const fieldLabel =
	"block font-label-lg text-xs sm:text-sm font-semibold text-on-surface";
const groupLegend = "block font-label-lg text-sm font-semibold text-on-surface";
const fieldInput =
	"w-full px-4 py-3 rounded-xl bg-surface-container-low border border-transparent focus:border-primary focus:bg-surface-container-lowest text-on-surface placeholder:text-outline text-sm transition-all duration-200 focus:outline-none";
// The radio is visually hidden, so its focus ring is drawn on the card.
const choiceFocus =
	"peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary";
const serviceChoice = `p-3 text-center rounded-xl bg-surface-container-low text-on-surface-variant font-label-lg text-xs sm:text-sm border border-transparent peer-checked:border-primary peer-checked:bg-primary peer-checked:text-on-primary peer-checked:shadow-sm transition-all duration-200 hover:bg-surface-container ${choiceFocus}`;
const modalityChoice = `p-3.5 text-center rounded-xl bg-surface-container-low text-on-surface-variant font-label-lg text-xs sm:text-sm border border-transparent peer-checked:border-secondary peer-checked:bg-secondary peer-checked:text-white peer-checked:shadow-sm transition-all duration-200 hover:bg-surface-container flex flex-col items-center justify-center gap-1 ${choiceFocus}`;
---

<Layout title={title} description={description}>
	<div class="flex flex-col w-full">
		<div class="relative w-full overflow-hidden">
			<div
				class="absolute -top-36 left-1/2 -translate-x-1/2 w-[900px] h-[400px] bg-accent-glow/25 rounded-full blur-[110px] pointer-events-none"
			>
			</div>

			<!-- 1. Hero -->
			<section
				class="relative z-10 w-full px-6 lg:px-margin pt-12 lg:pt-16 pb-10 text-center"
			>
				<div class="max-w-4xl mx-auto flex flex-col items-center">
					<h1
						class="font-display-xl text-3xl sm:text-4xl lg:text-display-xl text-primary font-medium tracking-tight leading-[1.15] mb-6 text-balance"
					>
						Pide tu primera cita o resuelve tus dudas
					</h1>
					<p
						class="font-body-lg text-base md:text-body-lg text-on-surface-variant max-w-2xl leading-relaxed"
					>
						Cuéntame brevemente qué buscas y te responderé para acordar día, hora
						y modalidad (Pamplona u online). No hace falta que sepas explicarlo
						todo: con unas líneas es suficiente. Puedes usar el formulario,
						WhatsApp, el teléfono o el correo, lo que te resulte más cómodo.
					</p>
				</div>
			</section>

			<!-- 2. Contact channels & form -->
			<section class="w-full px-6 lg:px-margin py-8 lg:py-12 relative z-10" id="formulario">
				<div
					class="max-w-[1240px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start"
				>
					<!-- Left column: human contact & direct channels -->
					<div class="lg:col-span-5 flex flex-col gap-6">
						<div class:list={[card, "relative overflow-hidden"]}>
							<div
								class="absolute -right-8 -top-8 w-32 h-32 bg-secondary-container/40 rounded-full blur-2xl pointer-events-none"
							>
							</div>
							<div class="flex items-center gap-5 mb-5">
								<div
									class="w-20 h-20 rounded-full overflow-hidden shrink-0 ring-4 ring-secondary-container/60 shadow-md"
								>
									<img
										alt="María Sánchez, psicóloga general sanitaria"
										class="w-full h-full object-cover object-top"
										src="/maria2.webp"
										width="1200"
										height="1600"
									/>
								</div>
								<div>
									<h2
										class="font-headline-md text-xl md:text-2xl text-on-surface font-semibold leading-tight"
									>
										María Sánchez
									</h2>
									<p class="font-body-sm text-xs md:text-body-sm text-slate-muted">
										Psicóloga general sanitaria
									</p>
									<p class="font-label-sm text-[11px] text-primary mt-0.5">
										Nº col. {licenseNumber}
									</p>
								</div>
							</div>
							<div class="bg-surface-container-low/70 rounded-xl p-4">
								<p
									class="font-body-md text-sm sm:text-body-md text-on-surface-variant italic leading-relaxed"
								>
									«Leo y respondo yo misma cada mensaje. Si tienes dudas antes de
									empezar, pregúntame sin compromiso.»
								</p>
							</div>
						</div>

						<!-- Direct channels -->
						<div class:list={[card, "flex flex-col gap-4"]}>
							<h2
								class="font-title-md text-lg text-primary font-semibold flex items-center gap-2"
							>
								<span class="material-symbols-outlined text-[22px]"
									>contact_support</span
								>Otras formas de contactar
							</h2>
							<div
								class="flex items-center justify-between p-3.5 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors group"
							>
								<div class="flex items-center gap-3.5">
									<div
										class="w-11 h-11 rounded-xl bg-secondary-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform"
									>
										<span class="material-symbols-outlined text-[22px]">mail</span>
									</div>
									<div>
										<p
											class="font-label-sm text-[11px] uppercase tracking-wider text-slate-muted"
										>
											Email
										</p>
										<a
											class="font-title-md text-sm sm:text-base text-primary font-medium hover:underline block"
											href={`mailto:${email}`}>{email}</a
										>
									</div>
								</div>
								<button
									aria-label="Copiar email"
									class="copy-email p-2 rounded-lg bg-surface-container-lowest text-slate-muted hover:text-primary shadow-sm hover:scale-105 transition-all"
									data-email={email}
									title="Copiar email"
									type="button"
								>
									<span class="material-symbols-outlined text-[19px]" aria-hidden="true"
										>content_copy</span
									>
								</button>
							</div>
							<div
								class="flex items-center justify-between p-3.5 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors group"
							>
								<div class="flex items-center gap-3.5">
									<div
										class="w-11 h-11 rounded-xl bg-primary-fixed flex items-center justify-center text-primary group-hover:scale-105 transition-transform"
									>
										<span class="material-symbols-outlined text-[22px]"
											>phone_in_talk</span
										>
									</div>
									<div>
										<p
											class="font-label-sm text-[11px] uppercase tracking-wider text-slate-muted"
										>
											Teléfono y WhatsApp
										</p>
										<a
											class="font-title-md text-sm sm:text-base text-primary font-medium hover:underline"
											href={phoneHref}>{whatsappNumber}</a
										>
									</div>
								</div>
								<a
									aria-label="Abrir WhatsApp (se abre en una pestaña nueva)"
									class="p-2 px-3 rounded-lg bg-primary text-on-primary font-label-sm text-xs hover:bg-on-primary-container transition-all flex items-center gap-1 shadow-sm"
									href={whatsappUrl}
									rel="noopener noreferrer"
									target="_blank">Chat</a
								>
							</div>
							<div
								class="p-4 rounded-xl bg-sand-warm/75 border border-border-subtle flex items-start gap-3.5 text-on-surface"
							>
								<div
									class="w-9 h-9 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary shrink-0 mt-0.5 shadow-sm"
								>
									<span class="material-symbols-outlined text-[20px]">pace</span>
								</div>
								<div class="font-body-sm text-xs sm:text-body-sm">
									<p class="font-label-lg text-primary font-semibold mb-0.5">
										Horario de atención
									</p>
									<p class="text-on-surface-variant">
										[PENDIENTE: días y horario de atención]
									</p>
								</div>
							</div>
						</div>

						<!-- Crisis notice: this practice does not handle emergencies -->
						<div
							class="p-4 rounded-xl bg-surface-container-high border border-border-subtle flex items-start gap-3 text-on-surface"
							role="note"
						>
							<span
								class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5"
								aria-hidden="true">emergency</span
							>
							<p class="font-body-sm text-body-sm">{crisisNotice}</p>
						</div>
					</div>

					<!-- Right column: booking form -->
					<div
						class="lg:col-span-7 bg-surface-container-lowest rounded-2xl p-6 sm:p-9 shadow-[0_8px_32px_rgba(36,105,91,0.08)] border border-border-subtle"
					>
						<div class="mb-7 pb-5 border-b border-border-subtle">
							<h2
								class="font-headline-md text-2xl sm:text-3xl text-primary font-medium tracking-tight"
							>
								Solicita tu primera cita
							</h2>
							<p
								class="font-body-md text-sm sm:text-body-md text-on-surface-variant mt-2 leading-relaxed"
							>
								Completa este formulario y se preparará un mensaje en tu aplicación
								de correo para que lo envíes. Te responderé para acordar día, hora y
								modalidad.
							</p>
						</div>
						<form
							class="space-y-6"
							id="contact-booking-form"
							data-email={email}
						>
							<fieldset class="space-y-2.5">
								<legend class={groupLegend}>
									1. ¿Qué servicio te interesa? <span
										class="text-primary"
										aria-hidden="true">*</span
									>
								</legend>
								<div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
									{
										services.map((service) => (
											<label
												class:list={["cursor-pointer", { "sm:col-span-2": service.wide }]}
											>
												<input
												class="peer sr-only"
												name="service_type"
												required
												type="radio"
													value={service.label}
												/>
												<div class={serviceChoice}>{service.label}</div>
											</label>
										))
									}
								</div>
							</fieldset>
							<fieldset class="space-y-2.5">
								<legend class={groupLegend}>
									2. Modalidad de terapia preferida <span
										class="text-primary"
										aria-hidden="true">*</span
									>
								</legend>
								<div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
									{
										modalities.map((modality) => (
											<label class="cursor-pointer">
												<input
												class="peer sr-only"
												name="treatment_modality"
												required
												type="radio"
													value={modality.label}
												/>
												<div class={modalityChoice}>
													<span
														class="material-symbols-outlined text-[20px]"
														aria-hidden="true"
													>
														{modality.icon}
													</span>
													<span class="font-medium">{modality.label}</span>
													<span class="text-[11px] opacity-80">{modality.note}</span>
												</div>
											</label>
										))
									}
								</div>
							</fieldset>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div class="space-y-1.5">
									<label class={fieldLabel} for="form-name"
										>Nombre y apellidos <span class="text-primary" aria-hidden="true"
											>*</span
										></label
									>
									<input
										class={fieldInput}
										id="form-name"
										name="name"
										autocomplete="name"
										placeholder="Ej. Clara Santos Ruiz"
										required
										type="text"
									/>
								</div>
								<div class="space-y-1.5">
									<label class={fieldLabel} for="form-email"
										>Correo electrónico <span class="text-primary" aria-hidden="true"
											>*</span
										></label
									>
									<input
										class={fieldInput}
										id="form-email"
										name="email"
										autocomplete="email"
										placeholder="clara@ejemplo.com"
										required
										type="email"
									/>
								</div>
							</div>
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div class="space-y-1.5">
									<label class={fieldLabel} for="form-phone"
										>Teléfono de contacto <span
											class="text-slate-muted text-xs font-normal">(recomendado)</span
										></label
									>
									<input
										class={fieldInput}
										id="form-phone"
										name="phone"
										autocomplete="tel"
										placeholder="+34 600 000 000"
										type="tel"
									/>
								</div>
								<div class="space-y-1.5">
									<label class={fieldLabel} for="form-slot">Preferencia de horario</label>
									<select class={fieldInput} id="form-slot" name="slot">
										<option value="Flexible / Cualquier franja"
											>Flexible / Cualquier franja</option
										>
										<option value="Mañanas">Mañanas</option>
										<option value="Tardes">Tardes</option>
									</select>
								</div>
							</div>
							<div class="space-y-1.5">
								<label class={fieldLabel} for="form-message"
									>¿Qué te gustaría contarme o consultarme? <span
									class="text-slate-muted text-xs font-normal">(opcional)</span
									></label
								>
								<textarea
									class={`${fieldInput} py-3.5 resize-none leading-relaxed`}
									id="form-message"
									name="message"
									placeholder="Por ejemplo: qué te trae a consulta o qué dudas tienes antes de empezar. Puedes dejarlo en blanco."
									rows="4"></textarea>
							</div>
							<div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-container-low/60">
								<input
									class="mt-1 w-4 h-4 text-primary rounded border-outline focus:ring-primary cursor-pointer shrink-0"
									id="form-rgpd"
									required
									type="checkbox"
								/>
								<label
									class="font-body-sm text-xs text-on-surface-variant cursor-pointer leading-relaxed"
									for="form-rgpd"
									>He leído y acepto la <a
										class="text-primary font-medium underline hover:text-on-primary-container"
										href={privacyHref}>política de privacidad</a
										>.</label
								>
							</div>
							<!-- Shown after the visitor's mail app opens with the prepared message -->
							<div
								class="p-4 rounded-xl bg-primary-fixed text-on-primary-fixed text-sm flex items-start gap-3 border border-primary/20"
								id="booking-confirmation-banner"
								hidden
								role="status"
								tabindex="-1"
							>
								<span
									class="material-symbols-outlined text-primary text-[22px] shrink-0 mt-0.5"
									aria-hidden="true">mail</span
								>
								<div>
									<p class="font-semibold text-primary">
										He preparado tu mensaje en tu aplicación de correo
									</p>
									<p class="text-xs sm:text-sm text-on-primary-fixed-variant mt-0.5">
										Revísalo y pulsa enviar para que me llegue. Si no se ha abierto,
										escríbeme directamente a {email}.
									</p>
								</div>
							</div>
							<div class="pt-2 flex flex-col items-center gap-3">
								<button
									class="w-full inline-flex items-center justify-center gap-2 py-4 px-8 rounded-full bg-primary text-on-primary font-label-lg text-base shadow-[0_4px_18px_rgba(36,105,91,0.25)] hover:bg-on-primary-container hover:shadow-[0_6px_26px_rgba(36,105,91,0.35)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 font-semibold cursor-pointer"
									type="submit"
									><span class="material-symbols-outlined text-[20px]" aria-hidden="true"
										>send</span
									>Preparar mensaje y solicitar cita</button
								>
								<p class="text-xs text-slate-muted text-center max-w-md leading-relaxed">
									Al pulsar, se abrirá tu aplicación de correo con el mensaje
									preparado. Si prefieres no dar detalles por escrito, basta con tu
									nombre y tu teléfono.
								</p>
							</div>
						</form>
					</div>
				</div>
			</section>

			<!-- 3. Office in Pamplona -->
			<section class="w-full px-6 lg:px-margin py-12 lg:py-16 relative">
				<div class="max-w-[1240px] mx-auto">
					<div
						class="bg-surface-container-lowest rounded-3xl overflow-hidden shadow-[0_6px_36px_rgba(36,105,91,0.06)] border border-border-subtle grid grid-cols-1 lg:grid-cols-12 items-stretch"
					>
						<div class="lg:col-span-6 relative min-h-[340px] lg:min-h-[520px] overflow-hidden">
							<img
								alt="María Sánchez en su consulta de Pamplona, junto a una planta y una mesa auxiliar."
								class="w-full h-full object-cover object-center transition-transform duration-700 hover:scale-105"
								src="/maria1.webp"
								loading="lazy"
							/>
						</div>
						<div class="lg:col-span-6 p-6 sm:p-10 lg:p-12 flex flex-col justify-between gap-6">
							<div class="space-y-4">
								<h2
									class="font-headline-lg text-2xl sm:text-3xl text-primary font-medium tracking-tight"
								>
									La consulta, en el {addressCenter} (Pamplona)
								</h2>
								<p
									class="font-body-md text-sm sm:text-body-md text-on-surface-variant leading-relaxed"
								>
									Una consulta tranquila y con luz natural. Si te resulta más cómodo,
									también podemos vernos por videollamada.
								</p>
								<div class="space-y-2.5 pt-2 border-t border-border-subtle">
									<div class="flex items-start gap-3">
										<span
											class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5"
											>location_on</span
										>
										<address class="text-sm not-italic">
											<strong class="text-on-surface block font-medium">{address}</strong>
											<span class="text-slate-muted">{addressCity} · {addressCenter}</span>
										</address>
									</div>
									<div class="flex items-start gap-3">
										<span
											class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5"
											>directions_bus</span
										>
										<div class="text-sm text-on-surface-variant">
											<strong class="text-on-surface font-medium">Cómo llegar:</strong>
											[PENDIENTE: transporte público y aparcamiento cercanos]
										</div>
									</div>
								</div>
							</div>
							<div class="pt-2">
								<a
									class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-secondary text-white font-label-lg text-sm font-semibold hover:bg-primary shadow-sm transition-all duration-200"
									href={mapsUrl}
									rel="noopener noreferrer"
									target="_blank"
									><span class="material-symbols-outlined text-[18px]" aria-hidden="true">map</span>Ver
									la ubicación en Google Maps</a
								>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 4. Online & FAQ -->
			<section
				class="w-full px-6 lg:px-margin py-10 lg:py-16 bg-surface-container-low/50 border-y border-border-subtle"
				id="online"
			>
				<div
					class="max-w-[1240px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start"
				>
					<div class="lg:col-span-5 space-y-4">
						<h2
							class="font-headline-lg text-2xl sm:text-3xl text-primary font-medium tracking-tight"
						>
							¿Prefieres hacer la terapia online?
						</h2>
						<p
