---
// Blog Page
// ------------
// Description: The blog page is a page that displays all the blog posts.

// Components
// - Layout
import Layout from '../../layouts/Layout.astro';
// - Blocks
import BlogMasonryGrid from '../../components/blocks/blog/BlogMasonryGrid.astro';
import Hero from '../../components/custom/BasicHeroCTA.astro';
// - Collection
import { getCollection } from 'astro:content';
export async function getStaticPaths({ paginate }: any) {
   const allPosts = await getCollection('blog', ({ id }) => id);
   return paginate(allPosts, { pageSize: 6 });
}
const { page } = Astro.props as any;

// Content
// - SEO
const SEO = {
   title: 'Blog de Psicología | Inala Psicoterapia - Artículos y consejos de salud mental',
   description:
      'Blog especializado en psicología y salud mental. Artículos, consejos y recursos sobre terapia individual, de pareja, familiar y psicología perinatal en Pamplona y online.',
};
---

<Layout title={SEO.title} description={SEO.description} noindex={page.currentPage > 1}>
   <Hero
      title="Blog de Psicología y Salud Mental"
      text="Explora nuestras últimas publicaciones sobre psicología y todo lo relacionado con la salud mental."
      classes="pb-0!"
   />
   <BlogMasonryGrid
      data={page.data}
      {...page.lastPage === 1
         ? {}
         : {
              pagination: {
                 first: page.url.first,
                 current: page.url.current,
                 length: page.lastPage,
                 prev: page.url.prev,
                 next: page.url.next,
                 last: page.url.last,
                 size: page.size,
                 total: page.total,
              },
           }}
   />
</Layout>
