---
// Blog Author Page
// ------------
// Description: The blog author page is a page that displays all the blog posts written by a specific author.

// Components
// - Layout
import Layout from '../../../layouts/Layout.astro'
import Section from '../../../components/ui/Section.astro'
import Row from '../../../components/ui/Row.astro'
import Col from '../../../components/ui/Col.astro'
// - Blocks
import BlogCard from '../../../components/ui/cards/BlogCard.astro'
import Hero from '../../../components/custom/BasicHeroCTA.astro'
import { getAuthorSlug, getPostSlug } from '../../../utils/seo'
// - Collection
import { getCollection } from 'astro:content'
const allPosts = await getCollection('blog', ({ id }) => id)
const authors = [...new Set(allPosts.map((post: any) => post.data.author))].map((author) => ({
	name: author,
	slug: getAuthorSlug(author),
	count: allPosts.filter((post: any) => post.data.author === author).length,
}))

// Content
// - SEO
const SEO = {
	title: 'Autores del Blog | Inala Psicoterapia',
	description:
		'Archivo interno de autores del blog de Inala Psicoterapia.'
}

// Sort blog posts by publication date (newest first)
const sortedBlogPosts = allPosts.sort((a: any, b: any) => {
	return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
})
// Define the grid column pattern (repeats every 6 posts)
const columnMap = ['1', '3', '1', '2', '2', '3']
---

<Layout title={SEO.title} description={SEO.description} noindex={true}>
	<Hero
		title="Autores del blog"
		text="Archivo interno para navegar por autor."
	/>
	<Section classes="pt-0!">
		<Row>
			{
				authors.map((author) => (
					<Col span="4">
						<BlogCard
							title={author.name}
							link={`/blog/author/${author.slug}`}
							author={author.name}
							classes="h-full"
						>
							{`${author.count} artículo${author.count === 1 ? '' : 's'} publicado${author.count === 1 ? '' : 's'}.`}
						</BlogCard>
					</Col>
				))
			}
		</Row>
	</Section>
	<Section classes="pt-0!">
		<Row classes="grid-cols-3! gap-y-15!">
			{
				sortedBlogPosts.map((post: any, index: number) => {
					const gridColumn = columnMap[index % columnMap.length]

					return (
						<Col span="1" start={gridColumn}>
							<BlogCard
								title={post.data.title}
								image={post.data.image}
								video={post.data.video}
								link={`/blog/${getPostSlug(post)}`}
								date={post.data.pubDate}
								author={post.data.author}
								classes="h-full"
							>
								{post.data.description}
							</BlogCard>
						</Col>
					)
				})
			}
		</Row>
	</Section>
</Layout>
