---
// Blog Author Page
// ------------
// Description: The blog author page is a page that displays all the blog posts written by a specific author.

// Components
// - Layout
import Layout from '../../../layouts/Layout.astro'
import Section from '../../../components/ui/Section.astro'
import Row from '../../../components/ui/Row.astro'
import Col from '../../../components/ui/Col.astro'
// - Blocks
import BlogCard from '../../../components/ui/cards/BlogCard.astro'
import Hero from '../../../components/custom/BasicHeroCTA.astro'
import { getAuthorSlug, getPostSlug } from '../../../utils/seo'

// Data
import { getCollection } from 'astro:content'
export async function getStaticPaths() {
	const allAuthors = await getCollection('blog', ({ id }) => id)
	const uniqueAuthors = [...new Set(allAuthors.map((blogAuthor) => blogAuthor.data.author))]

	return uniqueAuthors.map((author) => {
		const filteredGuides = allAuthors.filter((blogAuthor) => blogAuthor.data.author === author)
		return {
			params: { author: getAuthorSlug(author) },
			props: { authorName: author, authors: filteredGuides }
		}
	})
}
const { authorName, authors } = Astro.props

// Content
// - SEO
const SEO = {
	title: `Artículos de ${authorName} | Inala Psicoterapia`,
	description:
		`Archivo de artículos escritos por ${authorName} en Inala Psicoterapia.`
}

// - Page Header
const header = {
	title: `Artículos de ${authorName}`,
	text: `Consulta todas las publicaciones del blog de Inala firmadas por ${authorName}.`
}
---

<Layout title={SEO.title} description={SEO.description} noindex={true}>
	<Hero title={header.title} text={header.text} titleSpan="8" type="vertical" />
	<Section classes="pt-0!">
		<Row>
			{
				authors.map((post: any) => {
					return (
						<Col span="4">
							<BlogCard
								title={post.data.title}
								image={post.data.image}
								video={post.data.video}
								link={`/blog/${getPostSlug(post)}`}
								date={post.data.pubDate}
								author={authorName}
								classes="h-full"
							>
								{post.data.description}
							</BlogCard>
						</Col>
					)
				})
			}
		</Row>
	</Section>
</Layout>
