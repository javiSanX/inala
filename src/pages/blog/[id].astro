---
import { getImage, Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import { contactHref, ctaLabel, ctaNote } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, subtitle, description, pubDate, author, image } = post.data;

const date = pubDate.toLocaleDateString("es-ES", {
	day: "numeric",
	month: "long",
	year: "numeric",
});

// Article data for search engines, taken from the post itself.
const site = Astro.site ?? Astro.url;
const home = new URL("/", site).href;
const schemaImage = image
	? new URL((await getImage({ src: image, width: 1200 })).src, site).href
	: undefined;
const schema = [
	{
		"@type": "BlogPosting",
		headline: title,
		description,
		datePublished: pubDate.toISOString(),
		inLanguage: "es-ES",
		author: { "@type": "Person", name: author, url: new URL("/sobre-mi/", site).href },
		publisher: { "@id": `${home}#consulta` },
		mainEntityOfPage: new URL(Astro.url.pathname, site).href,
		...(schemaImage && { image: schemaImage }),
	},
];
---

<Layout
	title={`${title} | Blog Inala`}
	description={description}
	image={image}
	type="article"
	schema={schema}
>
	<article class="bg-paper pb-20 pt-8 lg:pb-28 lg:pt-10">
		<div class="mx-auto max-w-content px-5 sm:px-8 lg:px-10">
			<div class="mx-auto max-w-reading">
				<a
					href="/blog"
					class="group inline-flex min-h-11 items-center gap-2 text-small font-semibold text-teal transition-[color] duration-200 hover:text-teal-strong"
				>
					<Icon
						name="arrow_back"
						class="transition-[translate] duration-200 ease-out motion-safe:group-hover-fine:-translate-x-0.5"
					/>
					Volver al blog
				</a>
				<header class="hero-copy mt-8 flex flex-col gap-5">
					<h1 class="font-display text-title font-normal text-ink">{title}</h1>
					{subtitle && <p class="text-lead text-ink-muted">{subtitle}</p>}
					<p class="text-label font-semibold text-ink-muted">
						{author} · <time datetime={pubDate.toISOString()}>{date}</time>
					</p>
				</header>
			</div>
			{
				image && (
					<div class="hero-media mx-auto mt-12 max-w-narrow">
						<Image
							src={image}
							alt=""
							widths={[680, 1360]}
							sizes="(min-width: 768px) 768px, 100vw"
							loading="eager"
							fetchpriority="high"
							class="aspect-3/2 w-full rounded-frame object-cover"
						/>
					</div>
				)
			}
			<div class="prose-inala mx-auto mt-12 max-w-reading">
				<Content />
			</div>
			<aside
				class="mx-auto mt-20 flex max-w-reading flex-col gap-5 border-t border-line pt-10"
				aria-labelledby="post-cta"
			>
				<h2 id="post-cta" class="font-display text-subheading font-normal text-ink">
					¿Te has reconocido en este artículo?
				</h2>
				<p class="text-body text-ink-muted">
					Si quieres hablarlo con calma, puedo acompañarte en mi consulta de
					Pamplona o por videollamada. {ctaNote}
				</p>
				<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
					<Button href={contactHref} arrow>{ctaLabel}</Button>
					<Button href="/servicios" variant="secondary">Ver servicios y tarifas</Button>
				</div>
			</aside>
		</div>
	</article>
</Layout>
