---
import { Image } from 'astro:assets';
import Hero from '../../components/custom/BasicHeroCTA.astro';
import Frases from '../../components/custom/Frases.astro';
import JoinBox from '../../components/custom/JoinBox.astro';
import TitleSection from '../../components/custom/TitleSection.astro';
import Col from '../../components/ui/Col.astro';
import Row from '../../components/ui/Row.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/cards/Card.astro';
import Layout from '../../layouts/Layout.astro';

const SEO = {
   title: 'Terapia online en Pamplona | Psicóloga especialista en terapia virtual',
   description:
      'Terapia online desde Pamplona. Sesiones de psicología virtual para terapia individual, de pareja, familiar y perinatal. Acceso desde cualquier lugar con total confidencialidad y profesionalidad.',
};

const preguntas = [
   {
      question: '¿Es tan efectiva la terapia online como la presencial?',
      answer:
         'Sí, múltiples estudios demuestran que la terapia online es igual de efectiva que la presencial. La clave está en la conexión terapéutica, que se puede establecer perfectamente a través de videoconferencia cuando se cuenta con un profesional especializado.',
   },
   {
      question: '¿Qué necesito para una sesión de terapia online?',
      answer:
         'Solo necesitas un dispositivo con cámara y micrófono (ordenador, tablet o móvil), conexión a internet estable y un espacio privado donde te sientas cómodo/a. Te proporcionaré las instrucciones técnicas antes de la primera sesión.',
   },
   {
      question: '¿Cómo se garantiza la confidencialidad online?',
      answer:
         'Utilizo plataformas seguras y cifradas específicas para terapia online que cumplen con la normativa de protección de datos. Además, te orientaré sobre cómo crear un espacio privado para tus sesiones desde casa.',
   },
   {
      question: '¿Puedo alternar sesiones online y presenciales?',
      answer:
         'Por supuesto. Muchos pacientes combinan ambas modalidades según sus necesidades, horarios y circunstancias. La flexibilidad es una de las grandes ventajas de ofrecer ambas opciones de atención.',
   },
   {
      question: '¿Qué tipos de terapia se pueden hacer online?',
      answer:
         'Todos mis servicios están disponibles online: terapia individual, de pareja, familiar y psicología perinatal. La modalidad online permite mantener la continuidad terapéutica independientemente de la ubicación geográfica.',
   },
];
---

<Layout title={SEO.title} description={SEO.description}>
   <Hero
      title="Terapia online"
      text="La terapia online te permite acceder a apoyo psicológico profesional desde cualquier lugar. Desde un enfoque empático y especializado, ofrezco sesiones virtuales de terapia individual, de pareja, familiar y psicología perinatal con la misma calidad y efectividad que las sesiones presenciales."
   />

   <Section classes="mt-0! pt-0!">
      <TitleSection
         title="¿En qué consiste la terapia online?"
         text="La terapia online es una modalidad que utiliza tecnología segura para brindar apoyo psicológico a distancia. A través de videoconferencia, puedes acceder a todos mis servicios terapéuticos y trabajar en:"
         classes="lg:pb-15!"
      />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Terapia individual desde tu espacio seguro</li>
                     <li>Terapia de pareja sin desplazamientos</li>
                     <li>Terapia familiar con todos los miembros</li>
                     <li>Psicología perinatal especializada</li>
                     <li>Flexibilidad de horarios ampliada</li>
                     <li>Continuidad terapéutica garantizada</li>
                     <li>Comodidad de tu entorno familiar</li>
                     <li>Acceso desde cualquier ubicación</li>
                  </ul>
               </div>
            </Card>
         </Col>
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Sesiones de 60 minutos por videoconferencia</li>
                     <li>Plataforma segura y confidencial</li>
                     <li>Misma calidad que terapia presencial</li>
                     <li>Horarios flexibles adaptados a ti</li>
                     <li>Sin limitaciones geográficas</li>
                     <li>Apoyo técnico incluido</li>
                     <li>Opción de grabación de sesiones (con consentimiento)</li>
                     <li>Recursos digitales complementarios</li>
                  </ul>
               </div>
            </Card>
         </Col>
      </Row>
   </Section>

   <Frases
      title="La distancia no es un obstáculo para tu bienestar"
      text="La terapia online elimina barreras geográficas y temporales, permitiéndote acceder a apoyo psicológico profesional cuando y donde lo necesites. Tu salud mental merece atención especializada sin importar las circunstancias."
   />

   <!-- PARA QUIÉN ES -->
   <Section decoration="all" type="none" classes="pt-0!">
      <TitleSection title="¿Para quién es la terapia online?" text="" classes="lg:pb-15!" />

      <Row classes="!p-0 !m-0">
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/image1.webp'}
                     alt={'personas con movilidad reducida'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!"
                     >Limitaciones de movilidad</span
                  >
                  <p class="text-lg">
                     Ideal para personas con dificultades de desplazamiento, movilidad reducida,
                     enfermedades crónicas, responsabilidades de cuidado o que viven en zonas
                     rurales alejadas de servicios psicológicos especializados.
                  </p>
               </div>
            </div>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/image2.webp'}
                     alt={'personas con horarios complicados'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">Horarios complicados</span>
                  <p class="text-lg">
                     Perfecto para profesionales con horarios intensivos, padres y madres con niños
                     pequeños, estudiantes, personas con turnos rotativos o quienes necesitan mayor
                     flexibilidad horaria para acceder a terapia.
                  </p>
               </div>
            </div>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/image3.webp'}
                     alt={'comodidad y privacidad'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">Comodidad y privacidad</span
                  >
                  <p class="text-lg">
                     Para quienes prefieren la comodidad de su hogar, valoran la privacidad
                     adicional, tienen ansiedad social, dificultades para salir o simplemente se
                     sienten más cómodos en su entorno familiar conocido.
                  </p>
               </div>
            </div>
         </Card>
      </Row>
   </Section>

   <JoinBox
      title="Tu bienestar no conoce distancias"
      subtitle="La terapia online te acerca el apoyo psicológico profesional que necesitas, adaptándose a tu vida, horarios y circunstancias sin comprometer la calidad del tratamiento."
      buttonText="Comenzar online"
   />

   <Section classes="mt-0! pt-0!">
      <TitleSection title="¿Qué ventajas ofrece la terapia online?" text="" classes="lg:pb-15!" />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Eliminación de desplazamientos y esperas</li>
                     <li>Mayor flexibilidad de horarios</li>
                     <li>Comodidad de tu espacio personal</li>
                     <li>Continuidad en situaciones imprevistas</li>
                     <li>Acceso desde cualquier ubicación</li>
                     <li>Mayor privacidad y discreción</li>
                  </ul>
               </div>
            </Card>
         </Col>
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Reducción de barreras geográficas</li>
                     <li>Ahorro de tiempo y costes de transporte</li>
                     <li>Ideal para personas con movilidad reducida</li>
                     <li>Mantenimiento de rutinas familiares</li>
                     <li>Tecnología segura y confidencial</li>
                     <li>Mismo nivel profesional que presencial</li>
                  </ul>
               </div>
            </Card>
         </Col>
      </Row>
   </Section>

   <JoinBox
      title="Empieza tu camino hacia el bienestar emocional"
      subtitle="Empieza tu proceso terapéutico desde la comodidad de tu hogar u oficina. La terapia online te ofrece la flexibilidad y accesibilidad que necesitas para cuidar de tu salud mental sin comprometer la calidad del tratamiento."
      buttonText="Reserva tu cita"
   />

   <Section decoration="all" type="" classes="">
      <Row classes="">
         <Col span="5">
            <h2 class="text-left">Preguntas Frecuentes</h2>
         </Col>
         <Col span="7">
            {
               preguntas.map((pregunta) => (
                  <Card classes="mb-5">
                     <details class="group">
                        <summary class="flex cursor-pointer list-none items-center justify-between">
                           <h4 class="!m-0 p-0">{pregunta.question}</h4>
                           <span class="transition group-open:rotate-180">
                              <svg
                                 fill="none"
                                 height="24"
                                 shape-rendering="geometricPrecision"
                                 stroke="currentColor"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 stroke-width="1.5"
                                 viewBox="0 0 24 24"
                                 width="24"
                              >
                                 <path d="M6 9l6 6 6-6" />
                              </svg>
                           </span>
                        </summary>
                        <p class="group-open:animate-fadeIn mt-3">{pregunta.answer}</p>
                     </details>
                  </Card>
               ))
            }
         </Col>
      </Row>
   </Section>

   <!-- ENLACES INTERNOS -->
   <Section decoration="all" type="none" classes="pt-0!">
      <h3>También te puede interesar</h3>
      <Row classes="!p-0 !m-0">
         <Card classes="relative col-span-12 lg:col-span-3 !p-0">
            <a href="./terapia-individual" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia individual {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./terapia-pareja" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia de pareja {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./terapia-familiar" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia familiar {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./psicologia-perinatal" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Psicología perinatal {'>'}</button
               >
            </a>
         </Card>
      </Row>
   </Section>
</Layout>
