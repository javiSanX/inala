---
import therapistImage from "../../assets/images/maria5.webp";
import officeImage from "../../assets/images/oficina.webp";
import heroImage from "../../assets/images/terapia_online.jpeg";
import OtherServices from "../../components/OtherServices.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/ui/Button.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import FactList from "../../components/ui/FactList.astro";
import Faq from "../../components/ui/Faq.astro";
import Figure from "../../components/ui/Figure.astro";
import Icon from "../../components/ui/Icon.astro";
import Quote from "../../components/ui/Quote.astro";
import Section from "../../components/ui/Section.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import TopicList from "../../components/ui/TopicList.astro";
import {
	contactHref,
	ctaLabel,
	ctaNote,
	email,
	licenseNumber,
	therapistName,
	whatsappUrl,
} from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title = "Terapia online por videollamada | Inala Psicoterapia";

const description =
	"Terapia psicológica online por videollamada segura con María Sánchez, psicóloga general sanitaria. Terapia individual, de pareja, familiar y psicología parental, combinable con la consulta presencial en Pamplona.";

const heroPills = [
	{ icon: "timer", label: "Sesiones de 60 min" },
	{ icon: "pin_drop", label: "Pamplona y online" },
	{ icon: "lock", label: "Plataforma segura y cifrada" },
	{ icon: "verified", label: `Nº col. ${licenseNumber}` },
];

const situations = [
	{
		icon: "language",
		title: "Si vives lejos de Pamplona",
		text: "Puedes hacer terapia con el mismo enfoque que en la consulta, aunque no vivas cerca de Pamplona.",
	},
	{
		icon: "accessible_forward",
		title: "Si desplazarte te cuesta",
		text: "Por movilidad reducida, dolor o distancia: la sesión llega a ti sin el esfuerzo del trayecto.",
	},
	{
		icon: "balance",
		title: "Si tienes poco margen en tu día",
		text: "Sin traslados, es más fácil encajar la sesión entre el trabajo y la crianza.",
	},
	{
		icon: "flight_takeoff",
		title: "Si viajas a menudo",
		text: "Puedes mantener la continuidad de tu proceso aunque cambies de ciudad durante unas semanas.",
	},
	{
		icon: "cottage",
		title: "Si te resulta más cómodo desde casa",
		text: "A algunas personas les ayuda empezar desde un lugar que ya sienten como suyo.",
	},
];

const pillars = [
	{
		title: "Una opción útil para muchos motivos de consulta",
		text: "Para muchos motivos de consulta, la terapia por videollamada puede ser tan útil como la presencial. En la primera conversación valoramos juntos si el formato online encaja con tu situación.",
		icon: "verified",
		tag: "Lo valoramos juntos",
	},
	{
		title: "Privacidad y seguridad",
		text: "Utilizo plataformas seguras y cifradas específicas para terapia online, que cumplen con la normativa de protección de datos. Te oriento sobre cómo preparar un espacio privado en casa.",
		icon: "lock",
		tag: "Normativa de protección de datos",
	},
	{
		title: "La misma relación terapéutica",
		text: "También a través de la pantalla trabajamos con las emociones y el cuerpo: respiración, pausas y ejercicios sencillos que puedes practicar en casa.",
		icon: "favorite",
		tag: "Mismo enfoque que en consulta",
	},
];

const steps = [
	{
		title: "Me escribes",
		text: "Me escribes por el formulario, por correo o por WhatsApp y acordamos día y hora.",
	},
	{
		title: "Te envío el enlace",
		text: "Antes de la sesión te envío el enlace de la videollamada. [PENDIENTE: confirmar cómo se envía el enlace]",
	},
	{
		title: "Preparas tu rincón",
		text: "Un lugar tranquilo donde nadie te interrumpa y, si puedes, auriculares para más intimidad.",
	},
	{
		title: "Sesión de 60 minutos",
		text: "Hablamos con calma de lo que te trae, a tu ritmo, y vemos qué herramientas te pueden ayudar.",
	},
];

const myths = [
	{
		myth: "«La terapia online es impersonal y fría.»",
		reality:
			"A los pocos minutos de conversación la pantalla pasa a un segundo plano. Lo que importa es la escucha y la relación que se construye.",
	},
	{
		myth: "«No sirve para problemas profundos.»",
		reality:
			"Online trabajo los mismos temas que en consulta: duelos, ansiedad, relaciones o heridas del pasado. Si en algún caso no es el formato adecuado, te lo diré.",
	},
	{
		myth: "«Es complicado a nivel informático.»",
		reality:
			"Basta con abrir el enlace que te envío desde el móvil, la tablet o el ordenador, sin instalaciones complicadas.",
	},
];

const faqs = [
	{
		question: "¿Qué necesito para hacer la sesión?",
		answer:
			"Un móvil, tablet u ordenador con cámara y micrófono, y una conexión a internet estable. Te recomiendo usar auriculares para tener más intimidad y oír mejor.",
		open: true,
	},
	{
		question: "¿Qué pasa si falla la conexión durante la sesión?",
		answer:
			"Si se corta, volvemos a conectar o seguimos por teléfono. [PENDIENTE: confirmar qué ocurre con el tiempo perdido por fallos técnicos]",
	},
	{
		question: "Vivo en otra zona horaria, ¿cómo lo coordinamos?",
		answer:
			"Si vives en otra zona horaria, buscamos juntos una hora que encaje. [PENDIENTE: confirmar si se atiende a residentes fuera de España]",
	},
	{
		question: "¿Puedo combinar sesiones online y presenciales en Pamplona?",
		answer:
			"Sí. Puedes alternar sesiones online con sesiones en mi consulta de la C/ María Lacunza, en Pamplona, según te encaje en cada momento.",
	},
];
---

<Layout title={title} description={description}>
	<PageHero
		label="Terapia online · 60 minutos"
			backgroundImage={heroImage}
	>
		<Fragment slot="title">
			Terapia online: la misma cercanía, <span>estés donde estés</span>
		</Fragment>
		<p class="font-display text-subheading text-ink-muted">Terapia por videollamada</p>
		<p class="max-w-xl text-lead text-ink-muted">
			Sesiones por videollamada segura, con el mismo enfoque que en mi consulta
			de Pamplona: terapia individual, de pareja, familiar o psicología parental.
			Una buena opción si vives lejos, viajas a menudo o te cuesta encajar los
			desplazamientos en tu semana.
		</p>
		<div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
			<Button href={contactHref} arrow>
				<span>{ctaLabel}</span>
			</Button>
			<Button
				href={whatsappUrl}
				variant="secondary"
				icon="chat"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
			>
				<span>Escribir por WhatsApp</span>
			</Button>
		</div>
		<FactList
			facts={heroPills.map((pill) => ({ title: pill.label, icon: pill.icon }))}
		/>
		<p class="flex items-center gap-2 text-small text-ink-muted">
			<Icon name="verified" class="text-teal" />
			<span>Confidencial y protegido por el secreto profesional.</span>
		</p>
		<div slot="media" class="flex flex-col gap-6">

			<Quote author="María Sánchez">
				«La presencia terapéutica no depende de los metros de distancia, sino de
				la calidad de la escucha y la resonancia emocional.»
			</Quote>
		</div>
	</PageHero>

	<!-- Para quién -->
	<Section tone="white">
		<SectionHeader
			title="¿Para quién y en qué momentos está pensada la terapia online?"
			label="Para quién"
		>
			<p>
				Para que cuidar de tu salud mental no dependa de la distancia o de tus
				horarios.
			</p>
		</SectionHeader>
		<TopicList items={situations} layout="rows" class="mt-14" />
	</Section>

	<!-- ¿Funciona igual? -->
	<Section>
		<SectionHeader title="¿Funciona igual la terapia online?" label="Dudas habituales">
			<p>
				Cada persona es distinta. Por eso, antes de empezar, valoramos juntos si
				el formato online es el adecuado para ti.
			</p>
		</SectionHeader>
		<TopicList
			items={pillars.map((pillar) => ({ ...pillar, note: pillar.tag }))}
			columns={3}
			class="mt-14"
		/>
	</Section>

	<!-- Paso a paso -->
	<Section tone="white">
		<SectionHeader title="¿Cómo funciona la terapia online?" label="Cómo empezar">
			<p>Cuatro pasos sencillos desde que me escribes.</p>
		</SectionHeader>
		<TopicList
			items={steps}
			columns={2}
			numbered
			pad={false}
			class="mt-14 lg:grid-cols-4"
		/>
	</Section>

	<!-- Mitos y realidad -->
	<Section>
		<SectionHeader
			title="Lo que se suele pensar de la terapia online"
			label="Mitos y realidad"
		/>
		<ul class="mt-14 grid gap-x-10 lg:grid-cols-3">
			{
				myths.map((item) => (
					<li class="flex flex-col gap-4 border-t border-line py-8">
						<span class="text-label font-semibold text-ink-muted">Mito frecuente</span>
						<p class="font-display text-subheading font-normal text-ink">{item.myth}</p>
						<div class="mt-2 flex items-start gap-3">
							<Icon name="check" class="mt-0.5 text-teal" />
							<div class="flex flex-col gap-1">
								<span class="text-label font-semibold text-teal">La realidad</span>
								<p class="text-body text-ink-muted">{item.reality}</p>
							</div>
						</div>
					</li>
				))
			}
		</ul>
	</Section>

	<!-- Quién te atiende y formato mixto -->
	<Section tone="white">
		<div class="grid gap-x-16 gap-y-12 lg:grid-cols-12 lg:items-start">
			<div class="flex flex-col gap-10 lg:order-2 lg:col-span-7">
				<SectionHeader
					title="Un rostro humano y cercano al otro lado de la pantalla"
					label="Quién te atiende"
					layout="stack"
				>
					<p>
						«Mi objetivo es que la sesión online no se sienta como hablar con una
						pantalla, sino como un rato para detenerte y mirarte con amabilidad.
						Trabajo con rigor y respetando tu ritmo.»
					</p>
				</SectionHeader>
				<div class="grid gap-6 border-t border-line pt-8 sm:grid-cols-2 sm:items-center">
					<Figure
						src={officeImage}
						alt="Consulta de Inala en Pamplona: escritorio blanco con dos sillas verde agua y luz natural."
						ratio="landscape"
						sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 100vw"
					/>
					<div class="flex flex-col gap-3">
						<p class="flex items-center gap-2 text-label font-semibold text-teal">
							<Icon name="location_on" />
							<span>Online y presencial</span>
						</p>
						<h3 class="font-display text-subheading font-normal text-ink">
							Consulta presencial en Pamplona
						</h3>
						<p class="text-body text-ink-muted">
							Si vienes a Pamplona, puedes combinar las sesiones online con
							sesiones en mi consulta de la C/ María Lacunza 6, portal 4.
						</p>
					</div>
				</div>
			</div>
			<Figure
				src={therapistImage}
				alt="María Sánchez sonriendo, de pie, con chaqueta azul marino y blusa blanca."
				ratio="portrait"
				class="lg:order-1 lg:col-span-5"
			>
				<span>
					<span class="block font-display text-subheading text-ink">
						{therapistName}
					</span>
					<span class="block">
						Psicóloga general sanitaria · Nº col. {licenseNumber}
					</span>
				</span>
			</Figure>
		</div>
	</Section>

	<!-- Preguntas frecuentes -->
	<Section>
		<div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
			<SectionHeader
				title="Preguntas frecuentes sobre la terapia online"
				label="Preguntas frecuentes"
				layout="stack"
				class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
			/>
			<Faq items={faqs} class="lg:col-span-7" />
		</div>
	</Section>

	<CtaBand title="¿Sientes que es el momento de cuidarte, estés donde estés?">
		<p class="tabular-nums">
			Solicita tu primera cita o escríbeme si antes quieres resolver alguna duda.
			Sesión online de 60 minutos: 65 € individual; 75 € en pareja o familia.
		</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" arrow>
				<span>{ctaLabel}</span>
			</Button>
			<Button
				href={whatsappUrl}
				variant="inverse-outline"
				icon="chat"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
			>
				<span>Escribir por WhatsApp</span>
			</Button>
		</Fragment>
		<p slot="note" class="flex items-start gap-2">
			<Icon name="mail" class="mt-0.5 text-seafoam" />
			<span
				>{ctaNote} También puedes escribirme a <a
					class="text-seafoam underline underline-offset-4 transition-[color] duration-200 hover:text-white"
					href={`mailto:${email}`}>{email}</a
				>.</span
			>
		</p>
	</CtaBand>
	<OtherServices />
</Layout>
