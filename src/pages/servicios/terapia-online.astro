---
import OtherServices from "../../components/OtherServices.astro";
import { contactHref, email, therapistName } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title =
	"Terapia Online | Psicoterapia por videollamada segura, estés donde estés";
const description =
	"Terapia psicológica online por videollamada cifrada: el mismo rigor y cercanía que en consulta, con flexibilidad horaria para quienes viajan, viven fuera de España o necesitan conciliar.";

// Real credentials come from the existing site content (src/pages1/sobre-mi.astro).
const licenseNumber = "NA-02300";

const heroImage = "/terapia-online.jpg";
const officeImage =
	"https://lh3.googleusercontent.com/aida/AEtjO1X5k1jW9FkQ4V0xVbLS6sBf5fr49T1Z5NEisZTHk5KMpPBQgvYO55pHnX8URO3KruBn-o13NkOtF7aiFZTWrxIuoMKFXkDf4dQezimdABu6BwlHTrv928JKe1zPbYiA0VReSA5c_dUfCEA4OShgc_-fE-rYBdmEu11oTEFI2GOuicmKNL9pGzXQkHkgPRkf5q0tOJFijMxxdOWiwedGL-VCS1Mx2v9LixER4VfzQhNeCxKQscOqemqrL8A";

const eyebrow =
	"font-label-sm text-label-sm text-primary uppercase tracking-widest font-semibold";
const sectionHeading = "font-headline-lg text-headline-lg text-on-surface";

const heroPills = [
	{ icon: "timer", label: "Sesiones de 50 a 60 min" },
	{ icon: "public", label: "Flexibilidad horaria internacional" },
	{ icon: "lock", label: "Plataforma segura y cifrada E2E" },
	{ icon: "verified", label: `Psicóloga Colegiada ${licenseNumber}` },
];

const situations = [
	{
		icon: "language",
		title: "Españoles y expatriados en el extranjero",
		text: "La necesidad vital de procesar el dolor, la incertidumbre o el desarraigo en tu lengua materna y con un profesional que comprende tus raíces y códigos culturales.",
	},
	{
		icon: "accessible_forward",
		title: "Movilidad reducida o lejanía geográfica",
		text: "Recibe atención psicológica sanitaria de alto nivel sin la fatiga física, dolores crónicos o las barreras arquitectónicas del transporte metropolitano.",
	},
	{
		icon: "balance",
		title: "Conciliación laboral y crianza exigente",
		text: "Ahorra hasta dos horas en traslados. Integra tu espacio de introspección dentro de tu jornada laboral o durante los periodos de descanso de tus hijos.",
	},
	{
		icon: "flight_takeoff",
		title: "Viajes recurrentes o vida nómada",
		text: "Garantiza la regularidad y el sostén de tu proceso terapéutico sin interrupciones abruptas provocadas por desplazamientos profesionales o mudanzas continuas.",
	},
	{
		icon: "psychology",
		title: "Enfoque clínico integrador especializado",
		text: "Accede a nuestra mirada centrada en la teoría del apego, trauma relacional y neurobiología de las emociones, aunque tu residencia no esté fijada en Pamplona.",
	},
	{
		icon: "cottage",
		title: "Comodidad desde tu propio espacio seguro",
		text: "Ideal para personas que atraviesan episodios de agorafobia o fobia social severa, posibilitando dar el primer paso terapéutico desde su entorno protegido.",
	},
];

const pillars = [
	{
		title: "Evidencia Científica y Misma Eficacia",
		text: "Múltiples metaanálisis de la APA (American Psychological Association) confirman que la psicoterapia online consigue resultados equivalentes a la presencial en el tratamiento de la ansiedad, el estado de ánimo bajo y la regulación emocional.",
		icon: "verified",
		tag: "Estudios clínicos controlados",
	},
	{
		title: "Seguridad Tecnológica y Privacidad Médica",
		text: "Utilizamos una sala de videoconsulta protegida y cifrada de extremo a extremo conforme a la legislación europea de datos sanitarios. Sin software invasivo ni registros que comprometan tu intimidad.",
		icon: "lock",
		tag: "RGPD & Encriptación 256-bit",
	},
	{
		title: "Vínculo Humano y Sintonía Somática",
		text: "El trabajo corporal y emocional no se detiene por la pantalla. Guiamos prácticas de anclaje somático, respiración diafragmática y focalización afectiva con el mismo tacto, compasión y presencia sostenida.",
		icon: "favorite",
		tag: "Resonancia empática en directo",
	},
];

const steps = [
	{
		title: "Reserva y Cuestionario Breve",
		text: "Eliges el día y franja horaria que mejor encaje en tu rutina. Recibes un correo de confirmación con tu enlace personal y un breve formulario clínico.",
	},
	{
		title: "Preparación de tu Rincón",
		text: "Te compartimos recomendaciones simples: auriculares para mayor intimidad, un rincón iluminado donde nadie te interrumpa y un vaso de agua o infusión.",
	},
	{
		title: "Sesión por Videoconsulta",
		text: "50 a 60 minutos de escucha atenta, mapa clínico y herramientas aplicadas. Sin prisas, explorando tu malestar a un ritmo respetuoso con tus tiempos.",
	},
	{
		title: "Soporte Inter-sesiones",
		text: "Envío de resúmenes reflexivos, guías de autorregulación descargables y canal de correo electrónico abierto para resolver dudas puntuales.",
	},
];

const myths = [
	{
		myth: "«La terapia online es impersonal, distante y fría.»",
		reality:
			"La pantalla se desvanece a los pocos minutos de conversación. La atención sin distracciones y la sintonía emocional generan una atmósfera de profunda cercanía humana.",
	},
	{
		myth: "«No sirve para procesar heridas o problemas profundos.»",
		reality:
			"Trabajamos apego, duelos no resueltos, ansiedad compleja y dinámicas relacionales con protocolos sanitarios homologados de la misma intensidad.",
	},
	{
		myth: "«Es un proceso complicado a nivel informático.»",
		reality:
			"Basta con un clic sobre el enlace que te enviamos, accesible desde cualquier móvil, tablet o portátil sin instalaciones previas ni registros tediosos.",
	},
];

const faqs = [
	{
		question: "¿Qué necesito técnicamente para realizar la sesión?",
		answer:
			"Solo precisas un dispositivo con cámara y micrófono (ordenador portátil, tablet o smartphone) y una conexión a internet estable. Recomendamos el uso de auriculares para preservar tu intimidad y mejorar la acústica. No requieres instalar ninguna aplicación compleja.",
		open: true,
	},
	{
		question: "¿Qué ocurre si la conexión a internet falla durante la consulta?",
		answer:
			"Contamos siempre con un protocolo de respaldo. Si hay una caída de red puntual, retomamos de inmediato mediante llamada telefónica o por una sala alternativa. Los minutos perdidos por fallos técnicos ajenos se recuperan íntegramente en la misma sesión o en la siguiente.",
	},
	{
		question:
			"Vivo en otra zona horaria (América, resto de Europa o Asia), ¿cómo lo coordinamos?",
		answer:
			"Atendemos regularmente a pacientes en distintas franjas horarias (costa este y oeste de EE.UU., Latinoamérica, Reino Unido y Europa Central). Nuestro sistema de citas adapta automáticamente la hora a tu zona local para evitar cualquier confusión.",
	},
	{
		question:
			"¿Puedo alternar sesiones online con presenciales en Pamplona cuando viaje?",
		answer:
			"Absolutamente sí. Muchos de nuestros pacientes que viajan con frecuencia a Pamplona eligen tener sesiones puntuales en nuestra consulta de la C/ María Lacunza y continuar con el formato online el resto del año.",
	},
];
---

<Layout title={title} description={description}>
	<div class="flex flex-col w-full">
		<!-- Breadcrumb & top indicator -->
		<section class="w-full px-margin-mobile lg:px-margin pt-6 pb-4">
			<div
				class="max-w-[1240px] mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4"
			>
				<nav
					aria-label="Migas de pan"
					class="flex items-center gap-2 text-on-surface-variant font-body-sm text-body-sm"
				>
					<a
						class="hover:text-primary transition-colors flex items-center gap-1"
						href="/"
					>
						<span class="material-symbols-outlined text-[16px]">home</span>
						Inicio
					</a>
					<span class="text-outline-variant">/</span>
					<a class="hover:text-primary transition-colors" href="/servicios"
						>Servicios</a
					>
					<span class="text-outline-variant">/</span>
					<span class="text-primary font-semibold" aria-current="page"
						>Terapia Online</span
					>
				</nav>
				<div
					class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container text-on-primary-container shadow-sm w-fit"
				>
					<span class="w-2 h-2 rounded-full bg-primary motion-safe:animate-pulse"
					></span>
					<span
						class="font-label-sm text-label-sm uppercase tracking-wider font-semibold"
						>Atención psicológica donde estés • Eficacia clínica demostrada</span
					>
				</div>
			</div>
		</section>

		<!-- Hero -->
		<section
			class="w-full px-margin-mobile lg:px-margin py-8 lg:py-14 relative overflow-hidden"
		>
			<div
				class="max-w-[1240px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
			>
				<!-- Text column (7 cols) -->
				<div class="lg:col-span-7 flex flex-col gap-5">
					<div
						class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-secondary-container/60 text-secondary w-fit"
					>
						<span class="material-symbols-outlined text-[18px]"
							>wifi_tethering</span
						>
						<span class="font-label-lg text-label-lg"
							>Psicoterapia Integrativa Remota</span
						>
					</div>
					<h1
						class="font-headline-lg text-headline-lg lg:text-[44px] lg:leading-[54px] text-on-surface text-balance"
					>
						Tu refugio terapéutico, sin importar dónde estés: <span
							class="text-primary italic">cercanía, rigor y calidez</span
						>.
					</h1>
					<p class="font-body-lg text-body-lg text-on-surface-variant text-balance">
						La distancia física no compromete la profundidad del vínculo
						terapéutico. En INALA te ofrecemos un espacio confidencial, seguro y
						flexible mediante videollamada cifrada de alta calidad, diseñado para
						quienes viajan, viven fuera de España o necesitan conciliar su
						autocuidado con sus ritmos cotidianos.
					</p>
					<!-- Pills grid -->
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2">
						{
							heroPills.map((pill) => (
								<div class="flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-surface-container-low text-on-surface">
									<span class="material-symbols-outlined text-primary text-[20px]">
										{pill.icon}
									</span>
									<span class="font-body-sm text-body-sm font-medium">
										{pill.label}
									</span>
								</div>
							))
						}
					</div>
					<!-- CTAs -->
					<div
						class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4"
					>
						<a
							class="inline-flex items-center justify-center gap-2 font-label-lg text-label-lg px-7 py-3.5 rounded-full bg-primary text-on-primary shadow-[0_8px_24px_rgba(36,105,91,0.25)] hover:shadow-[0_12px_28px_rgba(36,105,91,0.35)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300"
							href="#tarifa-reserva"
						>
							<span>Reservar sesión online (65€)</span>
							<span class="material-symbols-outlined text-[18px]"
								>calendar_today</span
							>
						</a>
						<a
							class="inline-flex items-center justify-center gap-2 font-label-lg text-label-lg px-6 py-3.5 rounded-full bg-surface-container text-on-surface-variant hover:bg-secondary-container hover:text-on-secondary-container transition-all duration-300"
							href="#contacto-orientacion"
						>
							<span class="material-symbols-outlined text-[18px] text-primary"
								>phone_in_talk</span
							>
							<span>Llamada orientativa (15 min gratis)</span>
						</a>
					</div>
					<!-- Trust note -->
					<div
						class="flex items-center gap-2 text-slate-muted font-body-sm text-body-sm pt-1"
					>
						<span class="material-symbols-outlined text-[17px] text-primary"
							>shield</span
						>
						<span
							>Confidencialidad absoluta y cumplimiento riguroso de la RGPD y
							Código Deontológico Sanitario.</span
						>
					</div>
				</div>
				<!-- Visual card column (5 cols) -->
				<div class="lg:col-span-5 relative">
					<div
						class="relative rounded-2xl overflow-hidden shadow-[0_20px_45px_rgba(36,51,48,0.12)] bg-surface-container-lowest"
					>
						<img
							class="w-full h-[430px] object-cover"
							alt="Mujer joven sentada en un sillón de lino en una estancia luminosa con plantas, con una taza en la mano, durante una sesión de videoconsulta psicológica en su portátil."
							src={heroImage}
						/>
						<div
							class="absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-transparent to-transparent"
						>
						</div>
						<div
							class="absolute top-4 right-4 bg-surface-translucent backdrop-blur-md px-3.5 py-1.5 rounded-full flex items-center gap-1.5 shadow-sm"
						>
							<span class="material-symbols-outlined text-primary text-[17px]"
								>lock</span
							>
							<span class="font-label-sm text-label-sm font-semibold text-primary"
								>Espacio Seguro &amp; Privado</span
							>
						</div>
						<div
							class="absolute bottom-4 inset-x-4 p-4 rounded-xl bg-surface-translucent backdrop-blur-md shadow-lg"
						>
							<p class="font-headline-md text-body-sm italic text-inverse-surface">
								«La presencia terapéutica no depende de los metros de distancia,
								sino de la calidad de la escucha y la resonancia emocional.»
							</p>
							<span
								class="block mt-1 font-label-sm text-label-sm text-primary font-semibold tracking-wide uppercase"
								>Equipo Clínico INALA</span
							>
						</div>
					</div>
					<!-- Decorative floating element -->
					<div
						class="absolute -bottom-5 -left-5 bg-sand-warm p-4 rounded-xl shadow-md hidden sm:flex items-center gap-3"
					>
						<div
							class="w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold"
						>
							<span class="material-symbols-outlined text-[20px]">videocam</span>
						</div>
						<div>
							<p class="font-title-md text-title-md text-on-surface leading-tight">
								100% Cifrada
							</p>
							<p class="font-body-sm text-body-sm text-slate-muted">
								Sin descargas complejas
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Situations -->
		<section class="w-full px-margin-mobile lg:px-margin py-14 bg-surface-container-low">
			<div class="max-w-[1240px] mx-auto flex flex-col gap-10">
				<div class="text-center max-w-2xl mx-auto flex flex-col gap-3">
					<span class={eyebrow}>Situaciones &amp; Acompañamiento</span>
					<h2 class={sectionHeading}>
						¿Para quién y en qué momentos está pensada la terapia online?
					</h2>
					<p class="font-body-md text-body-md text-on-surface-variant">
						Adaptamos el marco clínico a tu realidad individual para que cuidar de
						tu salud mental no suponga un obstáculo logístico.
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{
						situations.map((situation) => (
							<div class="p-6 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-md transition-shadow flex flex-col gap-3.5">
								<div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center text-primary">
									<span class="material-symbols-outlined text-[24px]">
										{situation.icon}
									</span>
								</div>
								<h3 class="font-title-md text-title-md text-on-surface">
									{situation.title}
								</h3>
								<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
									{situation.text}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Clinical pillars -->
		<section class="w-full px-margin-mobile lg:px-margin py-16">
			<div class="max-w-[1240px] mx-auto flex flex-col gap-12">
				<div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
					<div class="max-w-2xl flex flex-col gap-2">
						<span class={eyebrow}>Garantía Científica</span>
						<h2 class={sectionHeading}>
							Eficacia y Rigor: Desmontando dudas sobre el formato online
						</h2>
					</div>
					<p class="font-body-md text-body-md text-slate-muted max-w-sm">
						La telepsicología practicada con marco sanitario homologado ofrece la
						misma tasa de recuperación que la terapia de sillón convencional.
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{
						pillars.map((pillar, index) => (
							<div class="p-8 rounded-2xl bg-surface-container flex flex-col gap-4 relative overflow-hidden">
								<span
									class="font-headline-lg text-[64px] text-primary/20 font-bold leading-none select-none"
									aria-hidden="true"
								>
									{String(index + 1).padStart(2, "0")}
								</span>
								<div class="flex flex-col gap-2">
									<h3 class="font-title-md text-title-md text-on-surface">
										{pillar.title}
									</h3>
									<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
										{pillar.text}
									</p>
								</div>
								<div class="mt-auto pt-4 flex items-center gap-2 text-primary font-label-sm text-label-sm">
									<span class="material-symbols-outlined text-[18px]">
										{pillar.icon}
									</span>
									<span>{pillar.tag}</span>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Step by step -->
		<section class="w-full px-margin-mobile lg:px-margin py-16 bg-surface-container-low">
			<div class="max-w-[1240px] mx-auto flex flex-col gap-12">
				<div class="text-center max-w-xl mx-auto flex flex-col gap-3">
					<span class={eyebrow}>Paso a Paso</span>
					<h2 class={sectionHeading}>
						¿Cómo funciona el proceso terapéutico online?
					</h2>
					<p class="font-body-md text-body-md text-on-surface-variant">
						Un camino fluido, sencillo y transparente desde tu primera toma de
						contacto.
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
					{
						steps.map((step, index) => (
							<div class="p-6 rounded-2xl bg-surface-container-lowest flex flex-col gap-4 relative">
								<div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold">
									{index + 1}
								</div>
								<h3 class="font-title-md text-title-md text-on-surface">
									{step.title}
								</h3>
								<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
									{step.text}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Myths vs reality -->
		<section class="w-full px-margin-mobile lg:px-margin py-16">
			<div class="max-w-[1240px] mx-auto flex flex-col gap-10">
				<div class="max-w-xl flex flex-col gap-2">
					<span class={eyebrow}>Claridad y Transparencia</span>
					<h2 class={sectionHeading}>Mitos vs. Realidad sobre la consulta virtual</h2>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					{
						myths.map((item) => (
							<div class="p-6 rounded-2xl bg-surface-container flex flex-col gap-4">
								<div class="flex items-center gap-2 text-error">
									<span
										class="material-symbols-outlined text-[20px]"
										aria-hidden="true"
									>
										cancel
									</span>
									<span class="font-label-sm text-label-sm uppercase font-semibold">
										Mito Frecuente
									</span>
								</div>
								<p class="font-title-md text-title-md text-on-surface">{item.myth}</p>
								<div class="pt-2 flex items-start gap-2.5">
									<span
										class="material-symbols-outlined text-primary text-[20px] shrink-0 mt-0.5"
										aria-hidden="true"
									>
										check_circle
									</span>
									<div>
										<span class="font-label-sm text-label-sm text-primary font-semibold uppercase block mb-1">
											La Realidad
										</span>
										<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
											{item.reality}
										</p>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Therapist & hybrid format -->
		<section class="w-full px-margin-mobile lg:px-margin py-16 bg-surface-container-low">
			<div
				class="max-w-[1240px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center"
			>
				<!-- Therapist column (5 cols) -->
				<div class="lg:col-span-5 flex flex-col gap-4">
					<div
						class="rounded-2xl overflow-hidden shadow-md bg-surface-container-lowest relative aspect-[3/4]"
					>
						<img
							class="w-full h-full object-cover"
							alt="Retrato de la psicóloga de INALA sentada en su consulta, junto a una planta y una mesa auxiliar."
							src="/maria1.webp"
							width="864"
							height="1184"
							loading="lazy"
						/>
						<div
							class="absolute bottom-4 inset-x-4 p-4 rounded-xl bg-surface-translucent backdrop-blur-md"
						>
							<h3 class="font-title-md text-title-md text-on-surface">
								{therapistName}
							</h3>
							<p class="font-body-sm text-body-sm text-slate-muted">
								Psicóloga Sanitaria • Col. {licenseNumber}
							</p>
						</div>
					</div>
				</div>
				<!-- Text & physical office (7 cols) -->
				<div class="lg:col-span-7 flex flex-col gap-6">
					<div class="flex flex-col gap-2">
						<span class={eyebrow}>Dirección Clínica</span>
						<h2 class={sectionHeading}>
							Un rostro humano y cercano al otro lado de la pantalla
						</h2>
						<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
							«Mi objetivo es que sientas que la sesión online no es un simple
							intercambio de palabras frente a un monitor, sino un espacio sagrado
							donde detenerte, exhalar y mirarte con amabilidad. Estructuramos el
							proceso con rigor científico pero desde el respeto más sincero a tu
							ritmo.»
						</p>
					</div>
					<!-- Hybrid option with physical office -->
					<div
						class="p-6 rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row gap-5 items-center"
					>
						<div class="w-full sm:w-44 h-32 rounded-xl overflow-hidden shrink-0">
							<img
								alt="Consulta de psicoterapia presencial en C/ María Lacunza 6, portal 4, 31011 Pamplona, España"
								class="w-full h-full object-cover"
								src={officeImage}
								loading="lazy"
							/>
						</div>
						<div class="flex flex-col gap-2">
							<div
								class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container w-fit text-xs font-semibold"
							>
								<span class="material-symbols-outlined text-[14px]">pin_drop</span>
								<span>Posibilidad de formato híbrido</span>
							</div>
							<h3 class="font-title-md text-title-md text-on-surface">
								Consulta presencial en Pamplona
							</h3>
							<p class="font-body-sm text-body-sm text-on-surface-variant">
								Si en algún momento viajas o regresas a Pamplona, puedes combinar tus
								consultas virtuales con sesiones presenciales en nuestra consulta de
								la C/ María Lacunza 6, portal 4.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Pricing (empty in the original design) -->
		<section class="w-full px-margin-mobile lg:px-margin py-16" id="tarifa-reserva">
		</section>

		<!-- FAQ (native <details>, no JS) -->
		<section class="w-full px-margin-mobile lg:px-margin py-16 bg-surface-container-low">
			<div class="max-w-[900px] mx-auto flex flex-col gap-10">
				<div class="text-center flex flex-col gap-2">
					<span class={eyebrow}>Respuestas Rápidas</span>
					<h2 class={sectionHeading}>Preguntas frecuentes sobre la terapia online</h2>
				</div>
				<div class="flex flex-col gap-4">
					{
						faqs.map((faq) => (
							<details
								class="group p-5 rounded-2xl bg-surface-container-lowest transition-all [&_summary::-webkit-details-marker]:hidden cursor-pointer"
								open={faq.open}
							>
								<summary class="flex items-center justify-between font-title-md text-title-md text-on-surface font-medium">
									<span>{faq.question}</span>
									<span
										class="material-symbols-outlined text-primary group-open:rotate-180 transition-transform"
										aria-hidden="true"
									>
										expand_more
									</span>
								</summary>
								<div class="mt-4 pt-3 text-on-surface-variant font-body-sm text-body-sm leading-relaxed">
									{faq.answer}
								</div>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<!-- Final CTA banner -->
		<section
			class="w-full px-margin-mobile lg:px-margin py-16 lg:py-20 bg-inverse-surface text-on-primary"
			id="contacto-orientacion"
		>
			<div class="max-w-[1000px] mx-auto text-center flex flex-col items-center gap-6">
				<div
					class="w-14 h-14 rounded-full bg-primary/30 flex items-center justify-center text-primary-fixed"
				>
					<span class="material-symbols-outlined text-[28px]">spa</span>
				</div>
				<h2
					class="font-headline-lg text-headline-lg lg:text-[44px] leading-tight text-white max-w-2xl text-balance"
				>
					¿Sientes que es el momento de cuidar de ti, sin importar dónde te
					encuentres?
				</h2>
				<p
					class="font-body-lg text-body-lg text-inverse-on-surface/85 max-w-xl text-balance"
				>
					Da el primer paso hacia una mayor serenidad emocional. Estamos a un solo
					clic de distancia para acompañarte en tu proceso.
				</p>
				<div class="flex flex-col sm:flex-row items-center gap-4 pt-3">
					<a
						class="inline-flex items-center justify-center gap-2 font-label-lg text-label-lg px-8 py-4 rounded-full bg-primary-container text-on-primary-container shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all"
						href={contactHref}
					>
						<span>Agendar primera sesión (65€)</span>
						<span class="material-symbols-outlined text-[18px]"
							>calendar_today</span
						>
					</a>
					<a
						class="inline-flex items-center justify-center gap-2 font-label-lg text-label-lg px-6 py-4 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors"
						href={`mailto:${email}?subject=Llamada%20orientativa%20gratuita%2015%20min`}
					>
						<span class="material-symbols-outlined text-[18px]">phone_in_talk</span>
						<span>Llamada orientativa (15 min gratis)</span>
					</a>
				</div>
				<div
					class="flex items-center gap-2 text-inverse-on-surface/70 font-body-sm text-body-sm pt-2"
				>
					<span class="material-symbols-outlined text-[16px]">mail</span>
					<span
						>Escríbenos directamente a <a
							class="underline hover:text-white transition-colors"
							href={`mailto:${email}`}>{email}</a
						> • Respuesta en menos de 24 horas</span
					>
				</div>
			</div>
		</section>
		<OtherServices />
	</div>
</Layout>
