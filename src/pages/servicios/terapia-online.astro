---
import CtaBand from "../../components/CtaBand.astro";
import Faq from "../../components/Faq.astro";
import Frase from "../../components/Frase.astro";
import PageHero from "../../components/PageHero.astro";
import Relacionados from "../../components/Relacionados.astro";
import Consiste from "../../components/servicio/Consiste.astro";
import ParaQuien from "../../components/servicio/ParaQuien.astro";
import Problemas from "../../components/servicio/Problemas.astro";
import Layout from "../../layouts/Layout.astro";

const logros = [
	"Terapia individual desde tu espacio seguro",
	"Terapia de pareja sin desplazamientos",
	"Terapia familiar con todos los miembros",
	"Psicología perinatal especializada",
	"Flexibilidad de horarios ampliada",
	"Continuidad terapéutica garantizada",
	"Comodidad de tu entorno familiar",
	"Acceso desde cualquier ubicación",
];

const incluye = [
	"Sesiones de 60 minutos por videoconferencia",
	"Plataforma segura y confidencial",
	"Misma calidad que terapia presencial",
	"Horarios flexibles adaptados a ti",
	"Sin limitaciones geográficas",
	"Apoyo técnico incluido",
	"Opción de grabación de sesiones (con consentimiento)",
	"Recursos digitales complementarios",
];

const paraQuien = [
	{
		title: "Limitaciones de movilidad",
		text: "Ideal para personas con dificultades de desplazamiento, movilidad reducida, enfermedades crónicas, responsabilidades de cuidado o que viven en zonas rurales alejadas de servicios psicológicos especializados.",
	},
	{
		title: "Horarios complicados",
		text: "Perfecto para profesionales con horarios intensivos, padres y madres con niños pequeños, estudiantes, personas con turnos rotativos o quienes necesitan mayor flexibilidad horaria para acceder a terapia.",
	},
	{
		title: "Comodidad y privacidad",
		text: "Para quienes prefieren la comodidad de su hogar, valoran la privacidad adicional, tienen ansiedad social, dificultades para salir o simplemente se sienten más cómodos en su entorno familiar conocido.",
	},
];

const problemas = [
	"Eliminación de desplazamientos y esperas",
	"Mayor flexibilidad de horarios",
	"Comodidad de tu espacio personal",
	"Continuidad en situaciones imprevistas",
	"Acceso desde cualquier ubicación",
	"Mayor privacidad y discreción",
	"Reducción de barreras geográficas",
	"Ahorro de tiempo y costes de transporte",
	"Ideal para personas con movilidad reducida",
	"Mantenimiento de rutinas familiares",
	"Tecnología segura y confidencial",
	"Mismo nivel profesional que presencial",
];

const preguntas = [
	{
		question: "¿Es tan efectiva la terapia online como la presencial?",
		answer:
			"Sí, múltiples estudios demuestran que la terapia online es igual de efectiva que la presencial. La clave está en la conexión terapéutica, que se puede establecer perfectamente a través de videoconferencia cuando se cuenta con un profesional especializado.",
	},
	{
		question: "¿Qué necesito para una sesión de terapia online?",
		answer:
			"Solo necesitas un dispositivo con cámara y micrófono (ordenador, tablet o móvil), conexión a internet estable y un espacio privado donde te sientas cómodo/a. Te proporcionaré las instrucciones técnicas antes de la primera sesión.",
	},
	{
		question: "¿Cómo se garantiza la confidencialidad online?",
		answer:
			"Utilizo plataformas seguras y cifradas específicas para terapia online que cumplen con la normativa de protección de datos. Además, te orientaré sobre cómo crear un espacio privado para tus sesiones desde casa.",
	},
	{
		question: "¿Puedo alternar sesiones online y presenciales?",
		answer:
			"Por supuesto. Muchos pacientes combinan ambas modalidades según sus necesidades, horarios y circunstancias. La flexibilidad es una de las grandes ventajas de ofrecer ambas opciones de atención.",
	},
	{
		question: "¿Qué tipos de terapia se pueden hacer online?",
		answer:
			"Todos mis servicios están disponibles online: terapia individual, de pareja, familiar y psicología perinatal. La modalidad online permite mantener la continuidad terapéutica independientemente de la ubicación geográfica.",
	},
];

const relacionados = [
	{ href: "/servicios/terapia-individual", label: "Terapia individual" },
	{ href: "/servicios/terapia-de-pareja", label: "Terapia de pareja" },
	{ href: "/servicios/terapia-familiar", label: "Terapia familiar" },
	{ href: "/servicios/psicologia-perinatal", label: "Psicología perinatal" },
];
---

<Layout
	title="Terapia online en Pamplona | Psicóloga especialista en terapia virtual"
	description="Terapia online desde Pamplona. Sesiones de psicología virtual para terapia individual, de pareja, familiar y perinatal. Acceso desde cualquier lugar con total confidencialidad y profesionalidad."
>
	<PageHero
		title="Terapia online"
		lead="La terapia online te permite acceder a apoyo psicológico profesional desde cualquier lugar. Desde un enfoque empático y especializado, ofrezco sesiones virtuales de terapia individual, de pareja, familiar y psicología perinatal con la misma calidad y efectividad que las sesiones presenciales."
		cta={{ href: "/contacto", label: "Reserva tu cita" }}
	/>

	<Consiste
		title="¿En qué consiste la terapia online?"
		text="La terapia online es una modalidad que utiliza tecnología segura para brindar apoyo psicológico a distancia. A través de videoconferencia, puedes acceder a todos mis servicios terapéuticos y trabajar en:"
		logros={logros}
		incluye={incluye}
	/>

	<Frase
		title="La distancia no es un obstáculo para tu bienestar"
		text="La terapia online elimina barreras geográficas y temporales, permitiéndote acceder a apoyo psicológico profesional cuando y donde lo necesites. Tu salud mental merece atención especializada sin importar las circunstancias."
	/>

	<ParaQuien title="¿Para quién es la terapia online?" items={paraQuien} />

	<CtaBand
		title="Tu bienestar no conoce distancias"
		text="La terapia online te acerca el apoyo psicológico profesional que necesitas, adaptándose a tu vida, horarios y circunstancias sin comprometer la calidad del tratamiento."
		label="Comenzar online"
	/>

	<Problemas title="¿Qué ventajas ofrece la terapia online?" items={problemas} />

	<CtaBand
		variant="camino"
		title="Empieza tu camino hacia el bienestar emocional"
		text="Empieza tu proceso terapéutico desde la comodidad de tu hogar u oficina. La terapia online te ofrece la flexibilidad y accesibilidad que necesitas para cuidar de tu salud mental sin comprometer la calidad del tratamiento."
		label="Reserva tu cita"
	/>

	<Faq items={preguntas} />

	<Relacionados links={relacionados} />
</Layout>
