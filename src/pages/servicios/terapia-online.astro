---
import therapistImage from "../../assets/images/maria5.webp";
import officeImage from "../../assets/images/oficina.webp";
import heroImage from "../../assets/images/terapia_online.jpeg";
import situationsImage from "../../assets/images/terapia-online.jpg";
import OnlineSituations from "../../components/OnlineSituations.astro";
import OtherServices from "../../components/OtherServices.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/ui/Button.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import Faq from "../../components/ui/Faq.astro";
import Figure from "../../components/ui/Figure.astro";
import Icon from "../../components/ui/Icon.astro";
import type { IconName } from "../../components/ui/icons";
import Section from "../../components/ui/Section.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import {
	contactHref,
	ctaLabel,
	email,
	licenseNumber,
	therapistName,
	whatsappUrl,
} from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title = "Terapia online por videollamada | Inala Psicoterapia";

const description =
	"Terapia psicológica online por videollamada segura con María Sánchez, psicóloga general sanitaria. Terapia individual, de pareja, familiar y psicología perinatal, combinable con la consulta presencial en Pamplona.";

// Each frame glides the photo towards the part of the scene it speaks to
// (scale, then a translate kept within the scaled margin).
const situations: {
	icon: IconName;
	label: string;
	text: string;
	frame: string;
}[] = [
	{
		icon: "language",
		label: "Vives lejos de Pamplona",
		text: "La distancia deja de ser un obstáculo: haces terapia con el mismo enfoque que en la consulta, desde donde estés.",
		frame: "none",
	},
	{
		icon: "accessible_forward",
		label: "Te cuesta desplazarte",
		text: "Por movilidad reducida, dolor o cansancio, la sesión llega a ti sin el esfuerzo del trayecto.",
		frame: "scale(1.2) translate(-8%, 0%)",
	},
	{
		icon: "schedule",
		label: "Vas justo de tiempo",
		text: "Sin traslados, es más fácil encajar una hora para ti entre el trabajo, la crianza y todo lo demás.",
		frame: "scale(1.2) translate(8%, -6%)",
	},
	{
		icon: "flight_takeoff",
		label: "Viajas a menudo",
		text: "Mantienes la continuidad de tu proceso aunque pases unas semanas en otra ciudad.",
		frame: "scale(1.12) translate(-4%, 4%)",
	},
	{
		icon: "cottage",
		label: "Te sientes mejor en casa",
		text: "A algunas personas les ayuda empezar desde un lugar que ya sienten como suyo.",
		frame: "scale(1.2) translate(8%, 6%)",
	},
];

const pillars = [
	{
		title: "Una opción útil para muchos motivos de consulta",
		text: "Para muchos motivos de consulta, la terapia por videollamada puede ser tan útil como la presencial. En la primera conversación valoramos juntos si el formato online encaja con tu situación.",
		icon: "verified",
		tag: "Lo valoramos juntos",
	},
	{
		title: "Privacidad y seguridad",
		text: "Utilizo plataformas seguras y cifradas específicas para terapia online, que cumplen con la normativa de protección de datos. Te oriento sobre cómo preparar un espacio privado en casa.",
		icon: "lock",
		tag: "Normativa de protección de datos",
	},
	{
		title: "La misma relación terapéutica",
		text: "También a través de la pantalla trabajamos con las emociones y el cuerpo: respiración, pausas y ejercicios sencillos que puedes practicar en casa.",
		icon: "favorite",
		tag: "Mismo enfoque que en consulta",
	},
];

const steps = [
	{
		title: "Me escribes",
		text: "Me escribes por el formulario, por correo o por WhatsApp y acordamos día y hora.",
	},
	{
		title: "Te envío el enlace",
		text: "Antes de la sesión te envío el enlace de la videollamada. [PENDIENTE: confirmar cómo se envía el enlace]",
	},
	{
		title: "Preparas tu rincón",
		text: "Un lugar tranquilo donde nadie te interrumpa y, si puedes, auriculares para más intimidad.",
	},
	{
		title: "Sesión de 60 minutos",
		text: "Hablamos con calma de lo que te trae, a tu ritmo, y vemos qué herramientas te pueden ayudar.",
	},
];

const myths = [
	{
		myth: "«La terapia online es impersonal y fría.»",
		reality:
			"A los pocos minutos de conversación la pantalla pasa a un segundo plano. Lo que importa es la escucha y la relación que se construye.",
	},
	{
		myth: "«No sirve para problemas profundos.»",
		reality:
			"Online trabajo los mismos temas que en consulta: duelos, ansiedad, relaciones o heridas del pasado. Si en algún caso no es el formato adecuado, te lo diré.",
	},
	{
		myth: "«Es complicado a nivel informático.»",
		reality:
			"Basta con abrir el enlace que te envío desde el móvil, la tablet o el ordenador, sin instalaciones complicadas.",
	},
];

const faqs = [
	{
		question: "¿Qué necesito para hacer la sesión?",
		answer:
			"Un móvil, tablet u ordenador con cámara y micrófono, y una conexión a internet estable. Te recomiendo usar auriculares para tener más intimidad y oír mejor.",
		open: true,
	},
	{
		question: "¿Qué pasa si falla la conexión durante la sesión?",
		answer:
			"Si se corta, volvemos a conectar o seguimos por teléfono. [PENDIENTE: confirmar qué ocurre con el tiempo perdido por fallos técnicos]",
	},
	{
		question: "Vivo en otra zona horaria, ¿cómo lo coordinamos?",
		answer:
			"Si vives en otra zona horaria, buscamos juntos una hora que encaje. [PENDIENTE: confirmar si se atiende a residentes fuera de España]",
	},
	{
		question: "¿Puedo combinar sesiones online y presenciales en Pamplona?",
		answer:
			"Sí. Puedes alternar sesiones online con sesiones en mi consulta de la C/ María Lacunza, en Pamplona, según te encaje en cada momento.",
	},
];
---

<Layout title={title} description={description}>
	<PageHero
		size="display"
		accent
		backgroundImage={heroImage}
		mobileBackground="corner"
	>
		<Fragment slot="title">
			{
				/* Below lg each run is its own line, sized from the viewport width so
			  the lead is the larger and both always fit on one line. */
			}
			<span class="max-lg:block max-lg:text-hero-lead">Terapia online</span
			>{" "}
			<span class="hero-accent max-lg:block max-lg:text-hero-run"
				>la misma cercanía, estés donde estés</span
			>
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Sesiones por videollamada segura, con el mismo enfoque que en mi consulta
			de Pamplona: terapia individual, de pareja, familiar o psicología perinatal.
			Una buena opción si vives lejos, viajas a menudo o te cuesta encajar los
			desplazamientos en tu semana.
		</p>

		<div class="flex flex-wrap gap-3 pt-2">
			<Button href={contactHref} icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
		</div>
	</PageHero>

	<!-- Para quién -->
	<Section tone="white">
		<SectionHeader title="¿Para quién es la terapia online?" size="large">

		</SectionHeader>
		<OnlineSituations
			situations={situations}
			image={situationsImage}
			imageAlt="Mujer sonriente en el sillón de su casa, con una taza en la mano, durante una sesión por videollamada en su portátil."
			href={contactHref}
			linkLabel="¿Te reconoces? Escríbeme y lo hablamos"
			class="mt-14"
		/>
	</Section>

		<!-- Mitos y realidad -->
	<Section>
		<SectionHeader
			title="Mitos y realidad de la terapia online"

		/>
		<ul class="mt-14 grid gap-6 lg:grid-cols-3">
			{
				myths.map((item) => (
					<li class="flex flex-col overflow-hidden rounded-frame border border-line bg-white">
						<div class="p-6 sm:p-8">
							<p class="font-display text-subheading font-normal text-ink">{item.myth}</p>
						</div>
						<div class="flex flex-1 items-start gap-3 bg-mist p-6 sm:p-8">
							<Icon name="check" class="mt-0.5 shrink-0 text-teal" />
							<div class="flex flex-col gap-2">
								<span class="text-label font-semibold text-teal">La realidad</span>
								<p class="text-body text-ink-muted">{item.reality}</p>
							</div>
						</div>
					</li>
				))
			}
		</ul>
	</Section>

	<!-- Paso a paso -->
	<Section tone="white">
		<SectionHeader title="¿Cómo funciona la terapia online?">

		</SectionHeader>
		{
			/* One path through the four steps: teal numerals joined by a hairline,
			  down a left rail on mobile and across the row from lg. */
		}
		<ol class="mt-14 grid lg:grid-cols-4 lg:gap-x-10">
			{
				steps.map((step, index) => {
					const last = index === steps.length - 1;
					return (
						<li
							data-reveal
							style={`--reveal: ${index}`}
							class="grid grid-cols-[3.5rem_1fr] gap-x-5 lg:flex lg:flex-col lg:gap-y-6"
						>
							<span
								class="flex flex-col items-center lg:flex-row lg:items-end"
								aria-hidden="true"
							>
								<span class="font-display text-display leading-none text-teal tabular-nums">
									{index + 1}
								</span>
								<span
									class:list={[
										"my-4 w-px flex-1 lg:mx-0 lg:my-0 lg:mb-3 lg:ml-5 lg:h-px lg:w-auto",
										last
											? "max-lg:hidden lg:bg-line"
											: "bg-line-strong lg:-mr-5",
									]}
								></span>
							</span>
							<div class:list={["flex flex-col gap-2.5 pt-2 lg:pt-0", !last && "pb-12 lg:pb-0"]}>
								<h3 class="text-lead font-semibold text-ink">{step.title}</h3>
								<p class="text-body text-ink-muted">{step.text}</p>
							</div>
						</li>
					);
				})
			}
		</ol>
	</Section>

	<CtaBand title="¿Sientes que es el momento de cuidarte, estés donde estés?">
		<p class="tabular-nums">
			Solicita tu primera cita o escríbeme si antes quieres resolver alguna duda.
			Sesión online de 60 minutos: 65 € individual; 75 € en pareja o familia.
		</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" arrow>
				<span>{ctaLabel}</span>
			</Button>
			<Button
				href={whatsappUrl}
				variant="inverse-outline"
				icon="chat"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
			>
				<span>Escribir por WhatsApp</span>
			</Button>
		</Fragment>
		<p slot="note" class="flex items-start gap-2">
			<Icon name="mail" class="mt-0.5 text-seafoam" />
			<span
				>También puedes escribirme a <a
					class="text-seafoam underline underline-offset-4 transition-[color] duration-200 hover:text-white"
					href={`mailto:${email}`}>{email}</a
				>.</span
			>
		</p>
	</CtaBand>

	<!-- Quién te atiende y formato mixto -->
	<Section tone="white">
		{
			/* Below lg the column and header dissolve into one grid so the portrait
			  sits beside the title, with the quote and the office below both. */
		}
		<div class="grid grid-cols-[minmax(0,1fr)_40%] items-start gap-x-5 gap-y-8 sm:gap-x-8 lg:grid-cols-12 lg:gap-x-16 lg:gap-y-12">
			<div class="contents lg:order-2 lg:col-span-7 lg:flex lg:flex-col lg:gap-10">
				<SectionHeader
					title="Un rostro humano y cercano al otro lado de la pantalla"
					layout="stack"
					class="max-lg:contents max-lg:*:last:col-span-2"
				>
					<p>
						«Mi objetivo es que la sesión online no se sienta como hablar con una
						pantalla, sino como un rato para detenerte y mirarte con amabilidad.
						Trabajo con rigor y respetando tu ritmo.»
					</p>
				</SectionHeader>
				<div class="col-span-2 grid gap-6 border-t border-line pt-8 sm:grid-cols-2 sm:items-center">
					<Figure
						src={officeImage}
						alt="Consulta de Inala en Pamplona: escritorio blanco con dos sillas verde agua y luz natural."
						ratio="landscape"
						sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 100vw"
					/>
					<div class="flex flex-col gap-3">
						<p class="flex items-center gap-2 text-label font-semibold text-teal">
							<Icon name="location_on" />
							<span>Online y presencial</span>
						</p>
						<h3 class="font-display text-subheading font-normal text-ink">
							Consulta presencial en Pamplona
						</h3>
						<p class="text-body text-ink-muted">
							Si vienes a Pamplona, puedes combinar las sesiones online con
							sesiones en mi consulta de la C/ María Lacunza 6, portal 4.
						</p>
					</div>
				</div>
			</div>
			<Figure
				src={therapistImage}
				alt="María Sánchez sonriendo, de pie, con chaqueta azul marino y blusa blanca."
				ratio="portrait"
				sizes="40vw"
				class="col-start-2 row-start-1 lg:order-1 lg:col-span-5 lg:col-start-auto lg:row-start-auto"
			>
				<span>
					<span class="block font-display text-subheading text-ink">
						{therapistName}
					</span>
					<span class="block">
						Psicóloga general sanitaria ·{" "}
						<span class="whitespace-nowrap">Nº col. {licenseNumber}</span>
					</span>
				</span>
			</Figure>
		</div>
	</Section>

	<!-- Preguntas frecuentes -->
	<Section>
		<div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
			<SectionHeader
				title="Preguntas frecuentes sobre la terapia online"
		
				layout="stack"
				class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
			/>
			<Faq items={faqs} class="lg:col-span-7" />
		</div>
	</Section>


	<OtherServices />
</Layout>
