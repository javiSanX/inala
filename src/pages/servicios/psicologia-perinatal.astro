---
import { Image } from 'astro:assets';
import Hero from '../../components/custom/BasicHeroCTA.astro';
import Frases from '../../components/custom/Frases.astro';
import JoinBox from '../../components/custom/JoinBox.astro';
import TitleSection from '../../components/custom/TitleSection.astro';
import Col from '../../components/ui/Col.astro';
import Row from '../../components/ui/Row.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/cards/Card.astro';
import Layout from '../../layouts/Layout.astro';

const SEO = {
   title: 'Psicología perinatal en Pamplona | Especialista en embarazo y postparto',
   description:
      'Psicología perinatal en Pamplona para acompañarte durante embarazo, postparto, pérdidas gestacionales y problemas de fertilidad. Apoyo emocional especializado presencial y online.',
};

const preguntas = [
   {
      question: '¿Cuándo es recomendable acudir a psicología perinatal?',
      answer:
         'Es recomendable durante la búsqueda del embarazo, ante dificultades de fertilidad, durante el embarazo con ansiedad o depresión, tras pérdidas gestacionales, en el postparto si hay tristeza persistente, problemas de vínculo con el bebé o adaptación a la maternidad/paternidad.',
   },
   {
      question: '¿Cuánto dura un proceso de psicología perinatal?',
      answer:
         'La duración varía según cada caso y momento vital. Algunas personas necesitan apoyo puntual durante crisis específicas, mientras que otras requieren acompañamiento más prolongado. Se adapta a tus necesidades y ritmo de cada etapa.',
   },
   {
      question: '¿Qué se trabaja en psicología perinatal?',
      answer:
         'Trabajamos la gestión emocional del embarazo, miedos y ansiedades, duelo por pérdidas gestacionales, depresión postparto, vínculo materno/paterno-filial, cambios de identidad, adaptación familiar y apoyo en procesos de fertilidad.',
   },
   {
      question: '¿Pueden venir en pareja a las sesiones?',
      answer:
         'Sí, es muy beneficioso que la pareja participe cuando sea posible. La experiencia perinatal afecta a ambos progenitores y el apoyo mutuo es fundamental. Se pueden alternar sesiones individuales y en pareja según las necesidades.',
   },
   {
      question: '¿Es normal necesitar ayuda psicológica durante el embarazo o postparto?',
      answer:
         'Absolutamente normal. La etapa perinatal conlleva grandes cambios físicos, hormonales y emocionales. Buscar apoyo psicológico es un acto de autocuidado y responsabilidad hacia tu bienestar y el de tu familia.',
   },
];
---

<Layout title={SEO.title} description={SEO.description}>
   <Hero
      title="Psicología perinatal"
      text="La psicología perinatal es un espacio especializado donde acompañarte durante una de las etapas más transformadoras de la vida. Desde un enfoque empático y profesional, te apoyo en el embarazo, postparto, pérdidas gestacionales y procesos de fertilidad para que vivas esta experiencia con mayor bienestar emocional."
   />

   <Section classes="mt-0! pt-0!">
      <TitleSection
         title="¿En qué consiste la psicología perinatal?"
         text="La psicología perinatal se centra en el cuidado emocional durante el embarazo, parto y postparto. Es un espacio donde puedes expresar tus emociones, miedos y expectativas mientras trabajamos juntas para que puedas:"
         classes="lg:pb-15!"
      />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Gestionar ansiedad y miedos del embarazo</li>
                     <li>Procesar duelos por pérdidas gestacionales</li>
                     <li>Superar la depresión postparto</li>
                     <li>Fortalecer el vínculo con tu bebé</li>
                     <li>Adaptarte a tu nueva identidad</li>
                     <li>Afrontar cambios corporales y hormonales</li>
                     <li>Prepararte emocionalmente para el parto</li>
                     <li>Integrar la experiencia maternal/paternal</li>
                  </ul>
               </div>
            </Card>
         </Col>
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Sesiones de 60 minutos individuales o en pareja</li>
                     <li>Modalidad presencial u online según preferencia</li>
                     <li>Espacio seguro y confidencial especializado</li>
                     <li>Terapia personalizada para tu momento vital</li>
                     <li>Apoyo en procesos de fertilidad</li>
                     <li>Seguimiento adaptado a cada etapa</li>
                     <li>Herramientas de autocuidado emocional</li>
                     <li>Recursos para el bienestar familiar</li>
                  </ul>
               </div>
            </Card>
         </Col>
      </Row>
   </Section>

   <Frases
      title="Cuidar tu salud mental es cuidar a tu familia"
      text="La etapa perinatal está llena de cambios y emociones intensas. La psicología perinatal te ofrece un espacio profesional donde procesar esta experiencia única, sanar heridas emocionales y prepararte para disfrutar plenamente de la maternidad/paternidad."
   />

   <!-- PARA QUIÉN ES -->
   <Section decoration="all" type="none" classes="pt-0!">
      <TitleSection title="¿En qué momentos te acompaño?" text="" classes="lg:pb-15!" />

      <Row classes="!p-0 !m-0">
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/gestación_embarazo.webp'}
                     alt={'embarazo y gestación'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">Embarazo y gestación</span>
                  <p class="text-lg">
                     Apoyo durante el embarazo para gestionar ansiedades, miedos al parto, cambios
                     emocionales, preparación psicológica para la maternidad/paternidad y
                     fortalecimiento del vínculo prenatal con tu bebé.
                  </p>
               </div>
            </div>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/postparto.webp'}
                     alt={'postparto y adaptación'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">Postparto y adaptación</span
                  >
                  <p class="text-lg">
                     Acompañamiento en el postparto para superar la tristeza posparto, depresión
                     postparto, ansiedad maternal, dificultades de lactancia, cambios de identidad y
                     adaptación a la nueva vida familiar.
                  </p>
               </div>
            </div>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/duelo_gestacional_perdidas.webp'}
                     alt={'fertilidad y pérdidas'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">Fertilidad y pérdidas</span>
                  <p class="text-lg">
                     Apoyo en procesos de reproducción asistida, infertilidad, pérdidas
                     gestacionales, abortos espontáneos, duelo perinatal y muerte gestacional o
                     neonatal para procesar el dolor y sanar emocionalmente.
                  </p>
               </div>
            </div>
         </Card>
      </Row>
   </Section>

   <JoinBox
      title="Tu bienestar emocional es prioritario"
      subtitle="Vivir la experiencia perinatal con apoyo psicológico especializado te permite procesar emociones, superar dificultades y disfrutar plenamente de esta etapa tan especial de tu vida."
      buttonText="Comenzar mi cuidado"
   />

   <Section classes="mt-0! pt-0!">
      <TitleSection title="¿Qué situaciones trabajamos?" text="" classes="lg:pb-15!" />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Ansiedad y miedos durante el embarazo</li>
                     <li>Depresión postparto y tristeza posparto</li>
                     <li>Duelo por pérdidas gestacionales</li>
                     <li>Problemas de fertilidad e infertilidad</li>
                     <li>Dificultades en el vínculo materno-filial</li>
                     <li>Trauma durante el parto</li>
                  </ul>
               </div>
            </Card>
         </Col>
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Adaptación a la maternidad/paternidad</li>
                     <li>Cambios de identidad y rol</li>
                     <li>Problemas de lactancia y alimentación</li>
                     <li>Ansiedad en procesos de reproducción asistida</li>
                     <li>Apoyo en embarazos de alto riesgo</li>
                     <li>Preparación psicológica para cesáreas</li>
                  </ul>
               </div>
            </Card>
         </Col>
      </Row>
   </Section>

   <JoinBox
      title="Empieza tu camino hacia el bienestar emocional"
      subtitle="Apoyarte en un profesional de la psicología perinatal te brinda las herramientas necesarias para afrontar los desafíos emocionales de esta etapa y disfrutar plenamente de la experiencia de ser madre o padre."
      buttonText="Reserva tu cita"
   />

   <Section decoration="all" type="" classes="">
      <Row classes="">
         <Col span="5">
            <h2 class="text-left">Preguntas Frecuentes</h2>
         </Col>
         <Col span="7">
            {
               preguntas.map((pregunta) => (
                  <Card classes="mb-5">
                     <details class="group">
                        <summary class="flex cursor-pointer list-none items-center justify-between">
                           <h4 class="!m-0 p-0">{pregunta.question}</h4>
                           <span class="transition group-open:rotate-180">
                              <svg
                                 fill="none"
                                 height="24"
                                 shape-rendering="geometricPrecision"
                                 stroke="currentColor"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 stroke-width="1.5"
                                 viewBox="0 0 24 24"
                                 width="24"
                              >
                                 <path d="M6 9l6 6 6-6" />
                              </svg>
                           </span>
                        </summary>
                        <p class="group-open:animate-fadeIn mt-3">{pregunta.answer}</p>
                     </details>
                  </Card>
               ))
            }
         </Col>
      </Row>
   </Section>

   <!-- ENLACES INTERNOS -->
   <Section decoration="all" type="none" classes="pt-0!">
      <h3>También te puede interesar</h3>
      <Row classes="!p-0 !m-0">
         <Card classes="relative col-span-12 lg:col-span-3 !p-0">
            <a href="./terapia-individual" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia individual {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./terapia-familiar" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia familiar {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./terapia-pareja" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia de pareja {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./terapia-online" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia online {'>'}</button
               >
            </a>
         </Card>
      </Row>
   </Section>
</Layout>
