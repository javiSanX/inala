---
import CtaBand from "../../components/CtaBand.astro";
import Faq from "../../components/Faq.astro";
import Frase from "../../components/Frase.astro";
import PageHero from "../../components/PageHero.astro";
import Relacionados from "../../components/Relacionados.astro";
import Consiste from "../../components/servicio/Consiste.astro";
import ParaQuien from "../../components/servicio/ParaQuien.astro";
import Problemas from "../../components/servicio/Problemas.astro";
import Layout from "../../layouts/Layout.astro";

const logros = [
	"Gestionar ansiedad y miedos del embarazo",
	"Procesar duelos por pérdidas gestacionales",
	"Superar la depresión postparto",
	"Fortalecer el vínculo con tu bebé",
	"Adaptarte a tu nueva identidad",
	"Afrontar cambios corporales y hormonales",
	"Prepararte emocionalmente para el parto",
	"Integrar la experiencia maternal/paternal",
];

const incluye = [
	"Sesiones de 60 minutos individuales o en pareja",
	"Modalidad presencial u online según preferencia",
	"Espacio seguro y confidencial especializado",
	"Terapia personalizada para tu momento vital",
	"Apoyo en procesos de fertilidad",
	"Seguimiento adaptado a cada etapa",
	"Herramientas de autocuidado emocional",
	"Recursos para el bienestar familiar",
];

const paraQuien = [
	{
		title: "Embarazo y gestación",
		text: "Apoyo durante el embarazo para gestionar ansiedades, miedos al parto, cambios emocionales, preparación psicológica para la maternidad/paternidad y fortalecimiento del vínculo prenatal con tu bebé.",
	},
	{
		title: "Postparto y adaptación",
		text: "Acompañamiento en el postparto para superar la tristeza posparto, depresión postparto, ansiedad maternal, dificultades de lactancia, cambios de identidad y adaptación a la nueva vida familiar.",
	},
	{
		title: "Fertilidad y pérdidas",
		text: "Apoyo en procesos de reproducción asistida, infertilidad, pérdidas gestacionales, abortos espontáneos, duelo perinatal y muerte gestacional o neonatal para procesar el dolor y sanar emocionalmente.",
	},
];

const problemas = [
	"Ansiedad y miedos durante el embarazo",
	"Depresión postparto y tristeza posparto",
	"Duelo por pérdidas gestacionales",
	"Problemas de fertilidad e infertilidad",
	"Dificultades en el vínculo materno-filial",
	"Trauma durante el parto",
	"Adaptación a la maternidad/paternidad",
	"Cambios de identidad y rol",
	"Problemas de lactancia y alimentación",
	"Ansiedad en procesos de reproducción asistida",
	"Apoyo en embarazos de alto riesgo",
	"Preparación psicológica para cesáreas",
];

const preguntas = [
	{
		question: "¿Cuándo es recomendable acudir a psicología perinatal?",
		answer:
			"Es recomendable durante la búsqueda del embarazo, ante dificultades de fertilidad, durante el embarazo con ansiedad o depresión, tras pérdidas gestacionales, en el postparto si hay tristeza persistente, problemas de vínculo con el bebé o adaptación a la maternidad/paternidad.",
	},
	{
		question: "¿Cuánto dura un proceso de psicología perinatal?",
		answer:
			"La duración varía según cada caso y momento vital. Algunas personas necesitan apoyo puntual durante crisis específicas, mientras que otras requieren acompañamiento más prolongado. Se adapta a tus necesidades y ritmo de cada etapa.",
	},
	{
		question: "¿Qué se trabaja en psicología perinatal?",
		answer:
			"Trabajamos la gestión emocional del embarazo, miedos y ansiedades, duelo por pérdidas gestacionales, depresión postparto, vínculo materno/paterno-filial, cambios de identidad, adaptación familiar y apoyo en procesos de fertilidad.",
	},
	{
		question: "¿Pueden venir en pareja a las sesiones?",
		answer:
			"Sí, es muy beneficioso que la pareja participe cuando sea posible. La experiencia perinatal afecta a ambos progenitores y el apoyo mutuo es fundamental. Se pueden alternar sesiones individuales y en pareja según las necesidades.",
	},
	{
		question:
			"¿Es normal necesitar ayuda psicológica durante el embarazo o postparto?",
		answer:
			"Absolutamente normal. La etapa perinatal conlleva grandes cambios físicos, hormonales y emocionales. Buscar apoyo psicológico es un acto de autocuidado y responsabilidad hacia tu bienestar y el de tu familia.",
	},
];

const relacionados = [
	{ href: "/servicios/terapia-individual", label: "Terapia individual" },
	{ href: "/servicios/terapia-familiar", label: "Terapia familiar" },
	{ href: "/servicios/terapia-de-pareja", label: "Terapia de pareja" },
	{ href: "/servicios/terapia-online", label: "Terapia online" },
];
---

<Layout
	title="Psicología perinatal en Pamplona | Especialista en embarazo y postparto"
	description="Psicología perinatal en Pamplona para acompañarte durante embarazo, postparto, pérdidas gestacionales y problemas de fertilidad. Apoyo emocional especializado presencial y online."
>
	<PageHero
		title="Psicología perinatal"
		lead="La psicología perinatal es un espacio especializado donde acompañarte durante una de las etapas más transformadoras de la vida. Desde un enfoque empático y profesional, te apoyo en el embarazo, postparto, pérdidas gestacionales y procesos de fertilidad para que vivas esta experiencia con mayor bienestar emocional."
		cta={{ href: "/contacto", label: "Reserva tu cita" }}
	/>

	<Consiste
		title="¿En qué consiste la psicología perinatal?"
		text="La psicología perinatal se centra en el cuidado emocional durante el embarazo, parto y postparto. Es un espacio donde puedes expresar tus emociones, miedos y expectativas mientras trabajamos juntas para que puedas:"
		logros={logros}
		incluye={incluye}
	/>

	<Frase
		title="Cuidar tu salud mental es cuidar a tu familia"
		text="La etapa perinatal está llena de cambios y emociones intensas. La psicología perinatal te ofrece un espacio profesional donde procesar esta experiencia única, sanar heridas emocionales y prepararte para disfrutar plenamente de la maternidad/paternidad."
	/>

	<ParaQuien title="¿En qué momentos te acompaño?" items={paraQuien} />

	<CtaBand
		title="Tu bienestar emocional es prioritario"
		text="Vivir la experiencia perinatal con apoyo psicológico especializado te permite procesar emociones, superar dificultades y disfrutar plenamente de esta etapa tan especial de tu vida."
		label="Comenzar mi cuidado"
	/>

	<Problemas title="¿Qué situaciones trabajamos?" items={problemas} />

	<CtaBand
		variant="camino"
		title="Empieza tu camino hacia el bienestar emocional"
		text="Apoyarte en un profesional de la psicología perinatal te brinda las herramientas necesarias para afrontar los desafíos emocionales de esta etapa y disfrutar plenamente de la experiencia de ser madre o padre."
		label="Reserva tu cita"
	/>

	<Faq items={preguntas} />

	<Relacionados links={relacionados} />
</Layout>
