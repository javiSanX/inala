---
import heroImage from "../../assets/images/psicologia_perinatal.jpeg";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import OtherServices from "../../components/OtherServices.astro";
import PageHero from "../../components/PageHero.astro";
import SessionHour from "../../components/SessionHour.astro";
import Button from "../../components/ui/Button.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import Faq from "../../components/ui/Faq.astro";
import Icon from "../../components/ui/Icon.astro";
import type { IconName } from "../../components/ui/icons";
import Note from "../../components/ui/Note.astro";
import Quote from "../../components/ui/Quote.astro";
import Section from "../../components/ui/Section.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { contactHref, ctaLabel, email } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title = "Psicología perinatal y crianza en Pamplona | Inala Psicoterapia";

const description =
	"Apoyo psicológico para madres, padres y cuidadores en Pamplona y online: cansancio, culpa, rabietas, límites y desacuerdos de crianza.";

const sessionSteps = [
	{
		title: "Sesiones de [PENDIENTE: duración]",
		text: "Tiempo para desahogarte, mirar con calma lo que pasa en casa y sentirte escuchado/a, sin prisas ni reproches.",
	},
	{
		title: "Menos culpa, más comprensión",
		text: "Un lugar donde hablar sin juicios del cansancio, las dudas y los sentimientos contradictorios que a menudo se viven en soledad.",
	},
	{
		title: "Entender a tus hijos",
		text: "Vemos juntos qué hay detrás de su comportamiento, sus rabietas y lo que necesitan en cada etapa.",
	},
	{
		title: "Herramientas prácticas y límites respetuosos",
		text: "Formas concretas de comunicaros, de manejar los momentos de desborde y de llegar a acuerdos de crianza en casa.",
	},
	{
		title: "En Pamplona o por videollamada",
		text: "En mi consulta de Pamplona o por videollamada segura, según os encaje mejor con la rutina familiar.",
	},
];

const audiences: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "child_care",
		title: "Familias en primeros años y primera infancia",
		text: "Para quienes transitan el posparto, la primera crianza, la adaptación al rol de madre/padre, el cansancio crónico, rabietas infantiles o dificultades con el sueño y el apego temprano.",
	},
	{
		icon: "self_improvement",
		title: "Desbordamiento, culpa y autoexigencia parental",
		text: 'Madres y padres que sienten agotamiento físico o mental ("burnout parental"), sensación de perder la paciencia con facilidad o una pesada culpa por no llegar a todo.',
	},
	{
		icon: "diversity_1",
		title: "Etapa escolar, preadolescencia y cambios de ciclo",
		text: "Acompañamiento en el establecimiento de límites saludables, gestión de pantallas, dificultades escolares, celos entre hermanos o discrepancias de crianza en la pareja.",
	},
];

const problems: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "sentiment_very_dissatisfied",
		title: "Gestión de rabietas y desbordes emocionales",
		text: "Entender qué le pasa a tu hijo en esos momentos, cómo ayudarle a calmarse y cómo responder sin gritos.",
	},
	{
		icon: "battery_alert",
		title: "Culpa, autoexigencia y burnout parental",
		text: "Soltar el perfeccionismo, el miedo a equivocarte y el agotamiento de la carga mental diaria.",
	},
	{
		icon: "shield",
		title: "Límites claros desde el respeto mutuo",
		text: "Herramientas para sostener límites sin caer en el autoritarismo ni en la permisividad reactiva.",
	},
	{
		icon: "favorite",
		title: "Discrepancias de crianza en la pareja",
		text: "Poneros de acuerdo en cómo educar, no meter a los hijos en medio y cuidar vuestro espacio de pareja.",
	},
	{
		icon: "volunteer_activism",
		title: "Vínculo y heridas de la propia infancia",
		text: "Fortalecer la conexión afectiva, reparar momentos de desconexión y sanar heridas de la propia infancia que resuenan al criar.",
	},
	{
		icon: "change_circle",
		title: "Transiciones vitales y etapas críticas",
		text: "Llegada de un nuevo hermano, separación parental respetuosa, inicio escolar o cambios imprevistos en la rutina familiar.",
	},
];

const faqs = [
	{
		question:
			"¿Tienen que venir los hijos a las sesiones de psicología perinatal?",
		answer:
			"Generalmente no. La psicología perinatal se centra en las figuras de referencia (madre, padre o cuidadores principales). Cuando vosotros contáis con más herramientas y calma, los niños lo notan, sin necesidad de exponerlos a la terapia. En ocasiones puntuales se puede valorar alguna sesión de observación o vínculo.",
	},
	{
		question:
			"¿Puedo acudir de forma individual o es necesario que vengamos los dos progenitores?",
		answer:
			"Puedes acudir de manera individual si tu pareja no tiene disponibilidad o si sientes que necesitas un espacio propio para reflexionar sobre tu rol. No obstante, si ambos progenitores participan en la crianza, es muy enriquecedor y beneficioso trabajar juntos para coordinar pautas y apoyaros mutuamente.",
	},
	{
		question: "¿Cuánto duran las sesiones y con qué frecuencia se realizan?",
		answer:
			"Las sesiones duran [PENDIENTE: duración]. La frecuencia se acuerda según vuestras necesidades y vuestra rutina familiar [PENDIENTE: confirmar frecuencia habitual].",
	},
	{
		question: "¿Nos dirás cómo tenemos que educar a nuestros hijos?",
		answer:
			"No. Respeto los valores de cada familia. Mi objetivo es ayudaros a entender mejor a vuestros hijos y a vosotros mismos, para que encontréis vuestra propia forma de educar, sin juicios.",
	},
];
---

<Layout title={title} description={description} heroFont>
	<PageHero
		size="display"
		accent
		backgroundImage={heroImage}
		mobileBackground="corner"
	>
		<Breadcrumbs
			slot="breadcrumbs"
			items={[
				{ name: "Inicio", href: "/" },
				{ name: "Servicios", href: "/servicios" },
				{ name: "Psicología Perinatal y Crianza" },
			]}
		/>
		<Fragment slot="title">
			{
				/* Below lg each run is its own line, sized from the viewport width so
			  the lead is the larger and both always fit on one line. */
			}
			<span class="max-lg:block max-lg:text-hero-lead">Psicología perinatal y crianza</span
			>{" "}
			<span class="hero-accent max-lg:block max-lg:text-hero-run"
				>apoyo para madres y padres</span
			>
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Un acompañamiento cercano para hablar de las dudas, el cansancio y la culpa
			que trae la crianza, y para encontrar pautas que funcionen en vuestra casa,
			desde el respeto y el vínculo con vuestros hijos.
		</p>

		<div class="flex flex-wrap gap-3 pt-2">
			<Button href={contactHref} icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
		</div>
	</PageHero>

	<!-- ¿En qué consiste? -->
	<Section tone="white" class="max-lg:pt-10">
		<SessionHour
			items={sessionSteps.map((step) => `${step.title}. ${step.text}`)}
			image={heroImage}
		>
			<SectionHeader
				slot="header"
				title="¿Qué ocurre durante una sesión de psicología perinatal?"
				size="large"
			/>
			<Quote class="italic">
				«No se trata de ser madres o padres perfectos, sino conscientes,
				presentes y en paz con nuestras propias sombras para poder cuidar desde
				la calma.»
			</Quote>
		</SessionHour>
	</Section>

	<!-- ¿Para quién? -->
	<Section tone="mist">
		<SectionHeader size="large">
			<Fragment slot="title">¿Para quién es la psicología perinatal?</Fragment>
		</SectionHeader>
		<ul class="mt-24 grid gap-x-12 gap-y-20 lg:grid-cols-3">
			{
				audiences.map((audience, index) => (
					<li
						class="reveal-blur relative border-t border-seafoam pt-16"
						data-reveal
						style={`--reveal: ${index}`}
					>
						<span class="absolute top-0 left-0 grid size-16 -translate-y-1/2 place-items-center rounded-full bg-white text-3xl text-teal ring-8 ring-mist">
							<Icon name={audience.icon} />
						</span>
						<h3 class="font-display text-heading font-normal text-ink">
							{audience.title}
						</h3>
						<p class="mt-4 text-body text-ink-muted">{audience.text}</p>
					</li>
				))
			}
		</ul>
		<Note class="mt-16">
			No hace falta llegar al límite para consultar: pedir apoyo a tiempo evita
			mucho desgaste y cuida el vínculo con vuestros hijos.
		</Note>
	</Section>

	<!-- ¿Qué dificultades se trabajan? -->
	<Section tone="white">
		<SectionHeader size="large">
			<Fragment slot="title">
				¿Qué dificultades se trabajan en psicología perinatal?
			</Fragment>
		</SectionHeader>
		<ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
			{
				problems.map((problem, index) => (
					<li
						class="reveal-blur flex flex-col gap-3"
						data-reveal
						style={`--reveal: ${index}`}
					>
						<div class="flex items-center gap-4">
							<span class="grid size-10 shrink-0 place-items-center rounded-full bg-seafoam-soft text-xl text-teal">
								<Icon name={problem.icon} />
							</span>
							<span class="h-px flex-1 bg-line" aria-hidden="true" />
						</div>
						<h3 class="font-display text-lead font-normal text-ink">
							{problem.title}
						</h3>
						<p class="text-body text-ink-muted">{problem.text}</p>
					</li>
				))
			}
		</ul>
	</Section>

	<CtaBand
		id="contacto-reserva"
		label="Primera cita"
		title="Pedir ayuda en la crianza también es cuidar de tus hijos"
	>
		<p>
			Solicita tu primera cita o escríbeme si antes quieres resolver alguna duda.
			[PENDIENTE: precio y duración de la sesión].
		</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" arrow>
				<span>{ctaLabel}</span>
			</Button>
			<Button href={`mailto:${email}`} variant="inverse-outline" icon="mail">
				<span>{email}</span>
			</Button>
		</Fragment>
	</CtaBand>
	<!-- Preguntas frecuentes -->
	<Section>
		<div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
			<SectionHeader
				title="Preguntas frecuentes sobre la psicología perinatal"
				layout="stack"
				size="large"
				class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
			>
				<p>
					Es normal tener dudas antes de empezar. Si la tuya no está aquí,
					escríbeme.
				</p>
			</SectionHeader>
			<Faq items={faqs} class="lg:col-span-7" />
		</div>
	</Section>

	<OtherServices />
</Layout>
