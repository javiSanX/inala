---
import heroImage from "../../assets/images/terapia-familiar.png";
import quoteImage from "../../assets/images/terapia-familiar2.png";
import OtherServices from "../../components/OtherServices.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/ui/Button.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import FactList from "../../components/ui/FactList.astro";
import Faq from "../../components/ui/Faq.astro";
import Figure from "../../components/ui/Figure.astro";
import Note from "../../components/ui/Note.astro";
import Quote from "../../components/ui/Quote.astro";
import Section from "../../components/ui/Section.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import TopicList from "../../components/ui/TopicList.astro";
import {
	contactHref,
	ctaLabel,
	ctaNote,
	email,
	licenseNumber,
} from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title =
	"Terapia familiar en Pamplona y online | Inala Psicoterapia";

const description =
	"Terapia familiar en Pamplona y online: mejorar la comunicación, resolver conflictos de convivencia y acompañar cambios, duelos y crisis. Sesiones de 60 minutos con María Sánchez, psicóloga general sanitaria.";

const trustPills = [
	{ icon: "schedule", label: "Sesiones de 60 minutos" },
	{ icon: "domain", label: "Pamplona y online" },
	{ icon: "verified", label: `Nº col. ${licenseNumber}` },
];

const sessionSteps = [
	{
		title: "Sesiones de 60 minutos",
		text: "Tiempo para que cada miembro participe sin prisas y sienta que su punto de vista cuenta.",
	},
	{
		title: "Neutralidad y validación de todas las voces",
		text: "Una mirada profesional externa que no se pone del lado de nadie, para que todos podáis escucharos sin reproches.",
	},
	{
		title: "Identificación de patrones y dinámicas invisibles",
		text: "Vemos juntos los círculos de discusión que se repiten y cómo frenarlos en el momento.",
	},
	{
		title: "Acuerdos prácticos y pautas de convivencia",
		text: "Acuerdos concretos sobre normas, límites y reparto de tareas, que podéis empezar a probar en casa entre sesiones.",
	},
	{
		title: "En Pamplona o por videollamada",
		text: "En mi consulta de Pamplona o por videollamada segura, para encajar con los horarios de trabajo y colegio.",
	},
];

const audiences = [
	{
		icon: "escalator_warning",
		title: "Familias con hijos/as o adolescentes",
		text: "Para hogares donde la convivencia se ha vuelto tensa por la rebeldía, el aislamiento adolescente, dificultades escolares o diferencias en estilos de crianza entre progenitores.",
	},
	{
		icon: "sync_alt",
		title: "Familias en transición o cambio de ciclo",
		text: "Acompañamiento en momentos clave: llegada de un nuevo miembro, familias reconstituidas (nuevas parejas e hijos), emancipación de los hijos o cuidado de familiares mayores.",
	},
	{
		icon: "healing",
		title: "Crisis familiares, duelos o pérdidas",
		text: "Familias que atraviesan procesos de pérdida, separaciones, enfermedades imprevistas o conflictos enquistados entre hermanos o con la familia extensa.",
	},
];

const problems = [
	{
		icon: "forum",
		title: "Conflictos recurrentes y discusiones continuas",
		text: "Discusiones que se repiten en bucle sin llegar a soluciones constructivas, generando tensión permanente y agotamiento emocional en todos.",
	},
	{
		icon: "comments_disabled",
		title: "Desconexión emocional y silencios defensivos",
		text: "Sensación de vivir como extraños bajo el mismo techo, aislamiento de los hijos o frialdad afectiva por heridas no resueltas.",
	},
	{
		icon: "rule",
		title: "Límites, normas y dificultades de convivencia",
		text: "Falta de acuerdos en normas del hogar, desautorización mutua entre figuras parentales o dificultad para poner límites claros con amor y firmeza.",
	},
	{
		icon: "family_restroom",
		title: "Familias reconstituidas y segundas uniones",
		text: "Adaptación a nuevas figuras parentales, celos entre hermanos, conflictos de lealtad y encaje de diferentes ritmos y hábitos de vida.",
	},
	{
		icon: "heart_broken",
		title: "Procesos de duelo, enfermedad y pérdidas",
		text: "Apoyo ante fallecimientos, diagnósticos médicos crónicos o cambios imprevistos que alteran y desestabilizan el equilibrio y la calma familiar.",
	},
	{
		icon: "share_location",
		title: "Tensiones con la familia extensa o política",
		text: "Injerencias de familiares externos, discrepancias en la crianza y la necesidad de proteger la intimidad y la autonomía del núcleo familiar.",
	},
];

// The first FAQ starts open, as in the original design.
const faqs = [
	{
		question:
			"¿Tienen que venir todos los miembros de la familia a todas las sesiones?",
		answer:
			"No necesariamente. Aunque es ideal contar con la presencia de los miembros involucrados en el conflicto, el proceso se adapta con flexibilidad. A veces hacemos sesiones con toda la familia, otras solo con los progenitores o individuales con alguno de los hijos según los objetivos que acordemos.",
	},
	{
		question:
			"¿Qué pasa si alguno de los miembros (como un hijo o progenitor) no quiere venir?",
		answer:
			"Es una situación muy común. Nunca obligo a nadie a participar. Podemos comenzar trabajando con los miembros que sí están motivados; introducir cambios en una parte del sistema familiar a menudo también mueve al resto de la familia.",
	},
	{
		question:
			"¿Cuánto duran y con qué frecuencia son las sesiones familiares?",
		answer:
			"Cada sesión dura 60 minutos. Generalmente empezamos con sesiones semanales, que después se espacian según cómo evolucione la familia.",
	},
	{
		question: "¿La terapeuta juzgará cómo educamos a nuestros hijos?",
		answer:
			"No. La terapia no es un juicio moral ni busca etiquetar quién es «buen» o «mal» progenitor. Parto del respeto hacia vuestra historia familiar y trabajamos juntos para identificar qué pautas están funcionando y cuáles necesitan ser renovadas.",
	},
];
---

<Layout title={title} description={description}>
	<PageHero
		breadcrumbs={[
			{ name: "Inicio", href: "/" },
			{ name: "Servicios", href: "/servicios" },
			{ name: "Terapia Familiar" },
		]}
		breadcrumbsLabel="Ruta de navegación"
		label="Terapia familiar · Pamplona y online"
		image={heroImage}
		imageAlt="Una cálida sesión de psicoterapia familiar en un gabinete sereno y luminoso, con dos mujeres sentadas en sillones compartiendo una conversación honesta."
	>
		<Fragment slot="title">
			Terapia familiar: mejorar la convivencia y <span>cuidar los vínculos</span>
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Un acompañamiento respetuoso y sin tomar partido, donde cada miembro de la
			familia tiene voz, se deshacen los nudos del conflicto y se recupera la
			comunicación en casa.
		</p>
		<div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
			<Button href={contactHref} icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
			<Button href="#enfoque" variant="secondary">
				<span>Ver en qué consiste</span>
			</Button>
		</div>
		<FactList
			facts={trustPills.map((pill) => ({ title: pill.label, icon: pill.icon }))}
			class="mt-4"
		/>
		<Fragment slot="caption">
			<span>
				<span class="block font-semibold text-ink">Todas las voces cuentan</span>
				<span class="block">A vuestro ritmo y según vuestras necesidades</span>
			</span>
		</Fragment>
	</PageHero>

	<!-- ¿En qué consiste? -->
	<Section tone="white" id="enfoque">
		<SectionHeader
			title="Poner palabras a lo que duele y volver a entenderos en casa"
			label="¿En qué consiste la terapia familiar?"
		>
			<p>
				La familia es un sistema vivo donde lo que le ocurre a uno afecta a todos.
				En consulta no busco culpables ni juzgo estilos educativos: guío la
				conversación para que cada miembro pueda contar lo que vive, lo que
				necesita y lo que teme, y para que las reacciones automáticas den paso a
				la comprensión y la cooperación.
			</p>
		</SectionHeader>
		<div class="mt-14 grid gap-x-16 gap-y-12 lg:grid-cols-12">
			<div class="flex flex-col gap-10 lg:col-span-5">
				<Figure
					src={quoteImage}
					alt="Dos manos entrelazadas sobre una mesa de madera junto a una taza de té y una libreta, transmitiendo conexión familiar y contención afectiva."
					ratio="landscape"
				/>
				<Quote author="María Sánchez">
					«En una familia no se trata de quién tiene la razón, sino de cómo cuidar
					el vínculo que os une para que todos puedan florecer.»
				</Quote>
			</div>
			<div class="lg:col-span-7">
				<h3 class="font-display text-subheading font-normal text-ink">
					¿Qué ocurre durante una sesión familiar?
				</h3>
				<TopicList
					items={sessionSteps}
					columns={1}
					level={4}
					numbered
					class="mt-6"
				/>
			</div>
		</div>
	</Section>

	<!-- ¿Para quién? -->
	<Section>
		<SectionHeader
			title="¿Para quién es la terapia familiar?"
			label="Acompañamiento en cada etapa familiar"
		>
			<p>
				Acompaño a familias en etapas y situaciones muy distintas, y adapto el
				proceso a vuestra realidad:
			</p>
		</SectionHeader>
		<TopicList items={audiences} columns={3} class="mt-14" />
		<Note class="mt-6">
			<span class="text-teal">No hace falta llegar al límite para venir:</span> pedir
			ayuda a tiempo evita mucho desgaste y protege a los más jóvenes.
		</Note>
	</Section>

	<!-- ¿Qué problemas se trabajan? -->
	<Section tone="white">
		<SectionHeader
			title="¿Qué problemas se trabajan en terapia familiar?"
			label="Qué trabajo en consulta"
		>
			<p>Estas son algunas de las dificultades más habituales en consulta:</p>
		</SectionHeader>
		<TopicList items={problems} layout="rows" class="mt-14" />
	</Section>

	<!-- Preguntas frecuentes -->
	<Section>
		<div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
			<SectionHeader
				title="Preguntas frecuentes sobre la terapia familiar"
				label="Preguntas frecuentes"
				layout="stack"
				class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
			>
				<p>
					Es normal tener dudas antes de empezar. Si la vuestra no está aquí,
					escribidme.
				</p>
			</SectionHeader>
			<Faq
				items={faqs.map((faq, index) => ({ ...faq, open: index === 0 }))}
				class="lg:col-span-7"
			/>
		</div>
	</Section>

	<CtaBand
		label="Primera cita familiar"
		title="Cuidar de vuestra familia es cuidar de cada uno de vosotros"
	>
		<p class="tabular-nums">
			Solicitad vuestra primera cita o escribidme si antes queréis resolver
			alguna duda. Sesión de 60 minutos · 75 €.
		</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" arrow>
				<span>{ctaLabel}</span>
			</Button>
			<Button href={`mailto:${email}`} variant="inverse-outline" icon="mail">
				<span>{email}</span>
			</Button>
		</Fragment>
		<span slot="note">{ctaNote}</span>
	</CtaBand>
	<OtherServices />
</Layout>
