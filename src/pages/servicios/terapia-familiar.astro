---
import { Image } from 'astro:assets';
import Hero from '../../components/custom/BasicHeroCTA.astro';
import Frases from '../../components/custom/Frases.astro';
import JoinBox from '../../components/custom/JoinBox.astro';
import TitleSection from '../../components/custom/TitleSection.astro';
import Col from '../../components/ui/Col.astro';
import Row from '../../components/ui/Row.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/cards/Card.astro';
import Layout from '../../layouts/Layout.astro';

const SEO = {
   title: 'Terapia familiar en Pamplona | Psicóloga especialista en dinámicas familiares',
   description:
      'Terapia familiar en Pamplona para mejorar comunicación familiar, resolver conflictos, fortalecer vínculos y superar crisis familiares. Sesiones presenciales y online. Espacio seguro y profesional.',
};

const preguntas = [
   {
      question: '¿Cuándo es recomendable acudir a terapia familiar?',
      answer:
         'Es recomendable cuando hay conflictos familiares recurrentes, problemas de comunicación entre miembros, crisis por cambios vitales (adolescencia, divorcio, pérdidas), dificultades en la educación de los hijos, o cuando la convivencia familiar genera tensión constante.',
   },
   {
      question: '¿Cuánto dura un proceso de terapia familiar?',
      answer:
         'La duración varía según cada familia y sus necesidades específicas. Algunas familias experimentan mejoras en pocas sesiones, mientras que otras requieren un proceso más extenso. Generalmente se inicia con sesiones semanales que se espacian según la evolución familiar.',
   },
   {
      question: '¿Qué se hace en una sesión de terapia familiar?',
      answer:
         'Trabajamos la comunicación entre todos los miembros, identificamos patrones de interacción disfuncionales, exploramos roles familiares, practicamos herramientas de diálogo constructivo y fortalecemos los vínculos familiares. Todo en un espacio seguro para toda la familia.',
   },
   {
      question: '¿Deben venir todos los miembros de la familia?',
      answer:
         'Idealmente participan todos los miembros que forman parte del núcleo familiar, pero se evalúa caso por caso. En ocasiones puede ser útil trabajar con subsistemas familiares (padres e hijos por separado) según las necesidades específicas.',
   },
   {
      question: '¿Qué pasa si algún miembro no quiere participar?',
      answer:
         'Aunque es ideal que todos participen, podemos comenzar con los miembros disponibles y trabajar estrategias para motivar e incluir gradualmente a quienes inicialmente se resisten al proceso terapéutico.',
   },
];
---

<Layout title={SEO.title} description={SEO.description}>
   <Hero
      title="Terapia familiar"
      text="La terapia familiar es un espacio seguro donde fortalecer los vínculos familiares, mejorar la comunicación y superar los conflictos que afectan la convivencia. Desde un enfoque empático y profesional, acompaño a familias que desean reconectar, resolver diferencias y construir relaciones más sólidas y armoniosas."
   />

   <Section classes="mt-0! pt-0!">
      <TitleSection
         title="¿En qué consiste la terapia familiar?"
         text="La terapia familiar es un proceso donde cada miembro puede expresar sus emociones, comprender las dinámicas familiares y aprender nuevas formas de relacionarse. En las sesiones trabajamos la comunicación, los roles y la conexión emocional para que podáis:"
         classes="lg:pb-15!"
      />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Mejorar la comunicación familiar</li>
                     <li>Resolver conflictos de forma constructiva</li>
                     <li>Fortalecer los vínculos afectivos</li>
                     <li>Establecer límites y normas claras</li>
                     <li>Superar crisis y transiciones vitales</li>
                     <li>Mejorar la convivencia familiar</li>
                     <li>Gestionar conflictos intergeneracionales</li>
                     <li>Construir objetivos familiares comunes</li>
                  </ul>
               </div>
            </Card>
         </Col>
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Sesiones de 60 minutos con la familia</li>
                     <li>Modalidad presencial u online según preferencia</li>
                     <li>Espacio neutral y confidencial para todos</li>
                     <li>Terapia personalizada para vuestra familia</li>
                     <li>Herramientas de comunicación efectiva</li>
                     <li>Seguimiento del progreso familiar</li>
                     <li>Estrategias prácticas para el día a día</li>
                     <li>Recursos para fortalecer la unión familiar</li>
                  </ul>
               </div>
            </Card>
         </Col>
      </Row>
   </Section>

   <Frases
      title="Sanar las heridas familiares es posible cuando hay voluntad de cambio"
      text="Todas las familias atraviesan momentos difíciles. La terapia familiar os ofrece un espacio profesional donde redescubrir vuestra conexión, aprender a comunicaros mejor y construir la familia unida que todos deseáis. Vuestra familia merece una oportunidad."
   />

   <!-- PARA QUIÉN ES -->
   <Section decoration="all" type="none" classes="pt-0!">
      <TitleSection title="¿Para qué familias es esta terapia?" text="" classes="lg:pb-15!" />

      <Row classes="!p-0 !m-0">
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/image1.webp'}
                     alt={'familias en crisis'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">Familias en crisis</span>
                  <p class="text-lg">
                     Acompaño a familias que atraviesan momentos difíciles: conflictos constantes,
                     problemas de comportamiento, crisis por cambios vitales, pérdidas familiares o
                     cuando sienten que han perdido la armonía en el hogar.
                  </p>
               </div>
            </div>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/image2.webp'}
                     alt={'familias problemas comunicación'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!"
                     >Problemas de comunicación</span
                  >
                  <p class="text-lg">
                     Un espacio para familias con discusiones frecuentes, falta de entendimiento
                     entre generaciones, dificultades para expresar emociones o cuando la
                     comunicación genera más conflicto que conexión.
                  </p>
               </div>
            </div>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/image3.webp'}
                     alt={'familias fortalecimiento vínculos'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!"
                     >Fortalecimiento preventivo</span
                  >
                  <p class="text-lg">
                     También para familias que desean fortalecer sus vínculos antes de grandes
                     cambios: llegada de nuevos miembros, adolescencia de los hijos, cambios de
                     residencia o simplemente para crecer juntos como familia.
                  </p>
               </div>
            </div>
         </Card>
      </Row>
   </Section>

   <JoinBox
      title="Vuestra familia merece una oportunidad"
      subtitle="Dar el primer paso hacia la terapia familiar es un acto de amor y compromiso mutuo. Juntos podéis redescubrir la conexión y construir la familia unida que todos deseáis."
      buttonText="Comenzar juntos"
   />

   <Section classes="mt-0! pt-0!">
      <TitleSection title="¿Qué problemas trabajamos en familia?" text="" classes="lg:pb-15!" />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Conflictos familiares recurrentes</li>
                     <li>Problemas de comportamiento en hijos</li>
                     <li>Dificultades en la comunicación familiar</li>
                     <li>Crisis por separación o divorcio</li>
                     <li>Conflictos entre hermanos</li>
                     <li>Problemas de límites y disciplina</li>
                  </ul>
               </div>
            </Card>
         </Col>
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Transiciones vitales (adolescencia, vejez)</li>
                     <li>Duelo y pérdidas familiares</li>
                     <li>Problemas de convivencia</li>
                     <li>Conflictos intergeneracionales</li>
                     <li>Familias reconstituidas</li>
                     <li>Estrés familiar por cambios externos</li>
                  </ul>
               </div>
            </Card>
         </Col>
      </Row>
   </Section>

   <JoinBox
      title="Empezad juntos el camino hacia la reconciliación"
      subtitle="La terapia familiar es una inversión en vuestra relación y bienestar mutuo. Juntos podemos trabajar para superar los obstáculos y construir una relación más fuerte y satisfactoria."
      buttonText="Reserva tu cita"
   />

   <Section decoration="all" type="" classes="">
      <Row classes="">
         <Col span="5">
            <h2 class="text-left">Preguntas Frecuentes</h2>
         </Col>
         <Col span="7">
            {
               preguntas.map((pregunta) => (
                  <Card classes="mb-5">
                     <details class="group">
                        <summary class="flex cursor-pointer list-none items-center justify-between">
                           <h4 class="!m-0 p-0">{pregunta.question}</h4>
                           <span class="transition group-open:rotate-180">
                              <svg
                                 fill="none"
                                 height="24"
                                 shape-rendering="geometricPrecision"
                                 stroke="currentColor"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 stroke-width="1.5"
                                 viewBox="0 0 24 24"
                                 width="24"
                              >
                                 <path d="M6 9l6 6 6-6" />
                              </svg>
                           </span>
                        </summary>
                        <p class="group-open:animate-fadeIn mt-3">{pregunta.answer}</p>
                     </details>
                  </Card>
               ))
            }
         </Col>
      </Row>
   </Section>

   <!-- ENLACES INTERNOS -->
   <Section decoration="all" type="none" classes="pt-0!">
      <h3>También te puede interesar</h3>
      <Row classes="!p-0 !m-0">
         <Card classes="relative col-span-12 lg:col-span-3 !p-0">
            <a href="./terapia-individual" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia individual {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./terapia-pareja" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia de pareja {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./psicologia-perinatal" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Psicología perinatal {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./terapia-online" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia online {'>'}</button
               >
            </a>
         </Card>
      </Row>
   </Section>
</Layout>
