---
import CtaBand from "../../components/CtaBand.astro";
import Faq from "../../components/Faq.astro";
import Frase from "../../components/Frase.astro";
import PageHero from "../../components/PageHero.astro";
import Relacionados from "../../components/Relacionados.astro";
import Consiste from "../../components/servicio/Consiste.astro";
import ParaQuien from "../../components/servicio/ParaQuien.astro";
import Problemas from "../../components/servicio/Problemas.astro";
import Layout from "../../layouts/Layout.astro";

const logros = [
	"Mejorar la comunicación familiar",
	"Resolver conflictos de forma constructiva",
	"Fortalecer los vínculos afectivos",
	"Establecer límites y normas claras",
	"Superar crisis y transiciones vitales",
	"Mejorar la convivencia familiar",
	"Gestionar conflictos intergeneracionales",
	"Construir objetivos familiares comunes",
];

const incluye = [
	"Sesiones de 60 minutos con la familia",
	"Modalidad presencial u online según preferencia",
	"Espacio neutral y confidencial para todos",
	"Terapia personalizada para vuestra familia",
	"Herramientas de comunicación efectiva",
	"Seguimiento del progreso familiar",
	"Estrategias prácticas para el día a día",
	"Recursos para fortalecer la unión familiar",
];

const paraQuien = [
	{
		title: "Familias en crisis",
		text: "Acompaño a familias que atraviesan momentos difíciles: conflictos constantes, problemas de comportamiento, crisis por cambios vitales, pérdidas familiares o cuando sienten que han perdido la armonía en el hogar.",
	},
	{
		title: "Problemas de comunicación",
		text: "Un espacio para familias con discusiones frecuentes, falta de entendimiento entre generaciones, dificultades para expresar emociones o cuando la comunicación genera más conflicto que conexión.",
	},
	{
		title: "Fortalecimiento preventivo",
		text: "También para familias que desean fortalecer sus vínculos antes de grandes cambios: llegada de nuevos miembros, adolescencia de los hijos, cambios de residencia o simplemente para crecer juntos como familia.",
	},
];

const problemas = [
	"Conflictos familiares recurrentes",
	"Problemas de comportamiento en hijos",
	"Dificultades en la comunicación familiar",
	"Crisis por separación o divorcio",
	"Conflictos entre hermanos",
	"Problemas de límites y disciplina",
	"Transiciones vitales (adolescencia, vejez)",
	"Duelo y pérdidas familiares",
	"Problemas de convivencia",
	"Conflictos intergeneracionales",
	"Familias reconstituidas",
	"Estrés familiar por cambios externos",
];

const preguntas = [
	{
		question: "¿Cuándo es recomendable acudir a terapia familiar?",
		answer:
			"Es recomendable cuando hay conflictos familiares recurrentes, problemas de comunicación entre miembros, crisis por cambios vitales (adolescencia, divorcio, pérdidas), dificultades en la educación de los hijos, o cuando la convivencia familiar genera tensión constante.",
	},
	{
		question: "¿Cuánto dura un proceso de terapia familiar?",
		answer:
			"La duración varía según cada familia y sus necesidades específicas. Algunas familias experimentan mejoras en pocas sesiones, mientras que otras requieren un proceso más extenso. Generalmente se inicia con sesiones semanales que se espacian según la evolución familiar.",
	},
	{
		question: "¿Qué se hace en una sesión de terapia familiar?",
		answer:
			"Trabajamos la comunicación entre todos los miembros, identificamos patrones de interacción disfuncionales, exploramos roles familiares, practicamos herramientas de diálogo constructivo y fortalecemos los vínculos familiares. Todo en un espacio seguro para toda la familia.",
	},
	{
		question: "¿Deben venir todos los miembros de la familia?",
		answer:
			"Idealmente participan todos los miembros que forman parte del núcleo familiar, pero se evalúa caso por caso. En ocasiones puede ser útil trabajar con subsistemas familiares (padres e hijos por separado) según las necesidades específicas.",
	},
	{
		question: "¿Qué pasa si algún miembro no quiere participar?",
		answer:
			"Aunque es ideal que todos participen, podemos comenzar con los miembros disponibles y trabajar estrategias para motivar e incluir gradualmente a quienes inicialmente se resisten al proceso terapéutico.",
	},
];

const relacionados = [
	{ href: "/servicios/terapia-individual", label: "Terapia individual" },
	{ href: "/servicios/terapia-de-pareja", label: "Terapia de pareja" },
	{ href: "/servicios/psicologia-perinatal", label: "Psicología perinatal" },
	{ href: "/servicios/terapia-online", label: "Terapia online" },
];
---

<Layout
	title="Terapia familiar en Pamplona | Psicóloga especialista en dinámicas familiares"
	description="Terapia familiar en Pamplona para mejorar comunicación familiar, resolver conflictos, fortalecer vínculos y superar crisis familiares. Sesiones presenciales y online. Espacio seguro y profesional."
>
	<PageHero
		title="Terapia familiar"
		lead="La terapia familiar es un espacio seguro donde fortalecer los vínculos familiares, mejorar la comunicación y superar los conflictos que afectan la convivencia. Desde un enfoque empático y profesional, acompaño a familias que desean reconectar, resolver diferencias y construir relaciones más sólidas y armoniosas."
		cta={{ href: "/contacto", label: "Reserva tu cita" }}
	/>

	<Consiste
		title="¿En qué consiste la terapia familiar?"
		text="La terapia familiar es un proceso donde cada miembro puede expresar sus emociones, comprender las dinámicas familiares y aprender nuevas formas de relacionarse. En las sesiones trabajamos la comunicación, los roles y la conexión emocional para que podáis:"
		logros={logros}
		incluye={incluye}
	/>

	<Frase
		title="Sanar las heridas familiares es posible cuando hay voluntad de cambio"
		text="Todas las familias atraviesan momentos difíciles. La terapia familiar os ofrece un espacio profesional donde redescubrir vuestra conexión, aprender a comunicaros mejor y construir la familia unida que todos deseáis. Vuestra familia merece una oportunidad."
	/>

	<ParaQuien title="¿Para qué familias es esta terapia?" items={paraQuien} />

	<CtaBand
		title="Vuestra familia merece una oportunidad"
		text="Dar el primer paso hacia la terapia familiar es un acto de amor y compromiso mutuo. Juntos podéis redescubrir la conexión y construir la familia unida que todos deseáis."
		label="Comenzar juntos"
	/>

	<Problemas title="¿Qué problemas trabajamos en familia?" items={problemas} />

	<CtaBand
		variant="camino"
		title="Empezad juntos el camino hacia la reconciliación"
		text="La terapia familiar es una inversión en vuestra relación y bienestar mutuo. Juntos podemos trabajar para superar los obstáculos y construir una relación más fuerte y satisfactoria."
		label="Reserva tu cita"
	/>

	<Faq items={preguntas} />

	<Relacionados links={relacionados} />
</Layout>
