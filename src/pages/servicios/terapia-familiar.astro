---
import heroImage from "../../assets/images/terapia_familiar.jpeg";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import OtherServices from "../../components/OtherServices.astro";
import PageHero from "../../components/PageHero.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import SessionHour from "../../components/SessionHour.astro";
import Button from "../../components/ui/Button.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import Faq from "../../components/ui/Faq.astro";
import Icon from "../../components/ui/Icon.astro";
import type { IconName } from "../../components/ui/icons";
import Note from "../../components/ui/Note.astro";
import Quote from "../../components/ui/Quote.astro";
import Section from "../../components/ui/Section.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { contactHref, ctaLabel, email } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title = "Terapia familiar en Pamplona y online | Inala Psicoterapia";

const description =
	"Terapia familiar en Pamplona y online: mejorar la comunicación, resolver conflictos de convivencia y acompañar cambios, duelos y crisis. Sesiones de 60 minutos.";

const sessionSteps = [
	{
		title: "Sesiones de 60 minutos",
		text: "Tiempo para que cada miembro participe sin prisas y sienta que su punto de vista cuenta.",
	},
	{
		title: "Neutralidad y validación de todas las voces",
		text: "Una mirada profesional externa que no se pone del lado de nadie, para que todos podáis escucharos sin reproches.",
	},
	{
		title: "Identificación de patrones y dinámicas invisibles",
		text: "Vemos juntos los círculos de discusión que se repiten y cómo frenarlos en el momento.",
	},
	{
		title: "Acuerdos prácticos y pautas de convivencia",
		text: "Acuerdos concretos sobre normas, límites y reparto de tareas, que podéis empezar a probar en casa entre sesiones.",
	},
	{
		title: "En Pamplona o por videollamada",
		text: "En mi consulta de Pamplona o por videollamada segura, para encajar con los horarios de trabajo y colegio.",
	},
];

const audiences: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "escalator_warning",
		title: "Familias con hijos pequeños o adolescentes",
		text: "Cuando la convivencia en casa se ha vuelto tensa y no sabéis cómo recuperar la calma ni poneros de acuerdo.",
	},
	{
		icon: "sync_alt",
		title: "Familias en transición o cambio de ciclo",
		text: "Cuando la familia cambia: llega alguien nuevo, se forma una familia reconstituida, los hijos se independizan o toca cuidar de un familiar mayor.",
	},
	{
		icon: "healing",
		title: "Crisis familiares, duelos o pérdidas",
		text: "Cuando atravesáis una pérdida, una separación o una enfermedad, o hay conflictos enquistados entre hermanos o con la familia extensa.",
	},
];

const problems: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "forum",
		title: "Conflictos recurrentes y discusiones continuas",
		text: "Salir de las discusiones que se repiten sin llegar a nada y bajar la tensión que os agota a todos.",
	},
	{
		icon: "comments_disabled",
		title: "Desconexión emocional y silencios defensivos",
		text: "Volver a acercaros cuando vivís como extraños bajo el mismo techo y cuidar las heridas que han traído distancia.",
	},
	{
		icon: "rule",
		title: "Límites, normas y dificultades de convivencia",
		text: "Poneros de acuerdo en las normas de casa, no desautorizaros entre vosotros y poner límites claros con cariño y firmeza.",
	},
	{
		icon: "family_restroom",
		title: "Familias reconstituidas y segundas uniones",
		text: "Hacer sitio a las nuevas figuras de la familia y manejar los celos entre hermanos, los conflictos de lealtad y las costumbres distintas.",
	},
	{
		icon: "heart_broken",
		title: "Procesos de duelo, enfermedad y pérdidas",
		text: "Sosteneros como familia ante un fallecimiento, un diagnóstico o un cambio inesperado que rompe el equilibrio de casa.",
	},
	{
		icon: "share_location",
		title: "Tensiones con la familia extensa o política",
		text: "Poner límites a las intromisiones de otros familiares y proteger la intimidad y la autonomía de vuestra familia.",
	},
];

const faqs = [
	{
		question:
			"¿Tienen que venir todos los miembros de la familia a todas las sesiones?",
		answer:
			"No necesariamente. Aunque es ideal contar con la presencia de los miembros involucrados en el conflicto, el proceso se adapta con flexibilidad. A veces hacemos sesiones con toda la familia, otras solo con los progenitores o individuales con alguno de los hijos según los objetivos que acordemos.",
	},
	{
		question:
			"¿Qué pasa si alguno de los miembros (como un hijo o progenitor) no quiere venir?",
		answer:
			"Es una situación muy común. Nunca obligo a nadie a participar. Podemos comenzar trabajando con los miembros que sí están motivados; introducir cambios en una parte del sistema familiar a menudo también mueve al resto de la familia.",
	},
	{
		question:
			"¿Cuánto duran y con qué frecuencia son las sesiones familiares?",
		answer:
			"Cada sesión dura 60 minutos. Generalmente empezamos con sesiones semanales, que después se espacian según cómo evolucione la familia.",
	},
	{
		question: "¿La terapeuta juzgará cómo educamos a nuestros hijos?",
		answer:
			"No. La terapia no es un juicio moral ni busca etiquetar quién es «buen» o «mal» progenitor. Parto del respeto hacia vuestra historia familiar y trabajamos juntos para identificar qué pautas están funcionando y cuáles necesitan ser renovadas.",
	},
];
---

<Layout title={title} description={description} image={heroImage} heroFont>
	<PageHero
		size="display"
		accent
		backgroundImage={heroImage}
		mobileBackground="corner"
	>
		<Breadcrumbs
			slot="breadcrumbs"
			items={[
				{ name: "Inicio", href: "/" },
				{ name: "Servicios", href: "/servicios/" },
				{ name: "Terapia Familiar" },
			]}
		/>
		<Fragment slot="title">
			{
				/* Below lg each run is its own line, sized from the viewport width so
			  the lead is the larger and both always fit on one line. */
			}
			<span class="max-lg:block max-lg:text-hero-lead">Terapia familiar</span
			><span class="sr-only">:</span>{" "}
			<span class="hero-accent max-lg:block max-lg:text-hero-run"
				>mejorar la convivencia y cuidar los vínculos</span
			>
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Un acompañamiento respetuoso y sin tomar partido, donde cada miembro de la
			familia tiene voz, se deshacen los nudos del conflicto y se recupera la
			comunicación en casa.
		</p>

		<div class="flex flex-wrap gap-3 pt-2">
			<Button href={contactHref} icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
		</div>
	</PageHero>

	<!-- ¿En qué consiste? -->
	<Section tone="white" class="max-lg:pt-10">
		<SessionHour
			items={sessionSteps.map((step) => `${step.title}. ${step.text}`)}
			image={heroImage}
			imageAlt="Ilustración en papel de una familia con dos niños entre hojas y flores en tonos verdes."
		>
			<SectionHeader
				slot="header"
				title="¿Qué ocurre durante una sesión familiar?"
				size="large"
			/>
			<Quote class="italic">
				«En una familia no se trata de quién tiene la razón, sino de cómo cuidar
				el vínculo que os une para que todos puedan florecer.»
			</Quote>
		</SessionHour>
	</Section>

	<!-- ¿Para quién? -->
	<Section tone="mist">
		<SectionHeader size="large">
			<Fragment slot="title">¿Para quién es la terapia familiar?</Fragment>
		</SectionHeader>
		<ul class="mt-24 grid gap-x-12 gap-y-20 lg:grid-cols-3">
			{
				audiences.map((audience, index) => (
					<li
						class="reveal-blur relative border-t border-seafoam pt-16"
						data-reveal
						style={`--reveal: ${index}`}
					>
						<span class="absolute top-0 left-0 grid size-16 -translate-y-1/2 place-items-center rounded-full bg-white text-3xl text-teal ring-8 ring-mist">
							<Icon name={audience.icon} />
						</span>
						<h3 class="font-display text-heading font-normal text-ink">
							{audience.title}
						</h3>
						<p class="mt-4 text-body text-ink-muted">{audience.text}</p>
					</li>
				))
			}
		</ul>
		<Note class="mt-16">
			No hace falta llegar al límite para venir: pedir ayuda a tiempo evita
			mucho desgaste y protege a los más jóvenes.
		</Note>
	</Section>

	<!-- ¿Qué problemas se trabajan? -->
	<Section tone="white">
		<SectionHeader size="large">
			<Fragment slot="title">
				¿Qué problemas se trabajan en terapia familiar?
			</Fragment>
		</SectionHeader>
		<ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
			{
				problems.map((problem, index) => (
					<li
						class="reveal-blur flex flex-col gap-3"
						data-reveal
						style={`--reveal: ${index}`}
					>
						<div class="flex items-center gap-4">
							<span class="grid size-10 shrink-0 place-items-center rounded-full bg-seafoam-soft text-xl text-teal">
								<Icon name={problem.icon} />
							</span>
							<span class="h-px flex-1 bg-line" aria-hidden="true" />
						</div>
						<h3 class="font-display text-lead font-normal text-ink">
							{problem.title}
						</h3>
						<p class="text-body text-ink-muted">{problem.text}</p>
					</li>
				))
			}
		</ul>
	</Section>

	<CtaBand
		id="contacto-reserva"
		label="Primera cita familiar"
		title="Cuidar de vuestra familia es cuidar de cada uno de vosotros"
	>
		<p>
			Tengo un Máster en Terapia Sistémica de Familia y Pareja (AVAPSI, 2023):
			miro a la familia en su conjunto, sin buscar culpables.
		</p>
		<p class="tabular-nums">
			Solicitad vuestra primera cita o escribidme si antes queréis resolver
			alguna duda. Sesión de 60 minutos · 75 €.
		</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" arrow>
				<span>{ctaLabel}</span>
			</Button>
			<Button href={`mailto:${email}`} variant="inverse-outline" icon="mail">
				<span>{email}</span>
			</Button>
		</Fragment>
	</CtaBand>
	<!-- Preguntas frecuentes -->
	<Section>
		<div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
			<SectionHeader
				title="Preguntas frecuentes sobre la terapia familiar"
				layout="stack"
				size="large"
				class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
			>
				<p>
					Es normal tener dudas antes de empezar. Si la vuestra no está aquí,
					escribidme.
				</p>
			</SectionHeader>
			<Faq items={faqs} class="lg:col-span-7" />
		</div>
	</Section>

	<RelatedPosts service="/servicios/terapia-familiar/" />

	<OtherServices />
</Layout>
