---
import OtherServices from "../../components/OtherServices.astro";
import {
	contactHref,
	ctaLabel,
	ctaNote,
	email,
	licenseNumber,
} from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title =
	"Terapia individual en Pamplona y online | Inala Psicoterapia";
const description =
	"Terapia individual para adultos, adolescentes y niños en Pamplona y online: ansiedad, estrés, autoestima, duelo y relaciones. Sesiones de 60 minutos con María Sánchez, psicóloga general sanitaria.";

const heroImage = "/terapia-individual.png";

const trustBadges = [
	{ icon: "schedule", label: "Sesiones de 60 minutos" },
	{ icon: "pin_drop", label: "Pamplona y online" },
	{ icon: "verified", label: `Nº col. ${licenseNumber}` },
];

const sessionFeatures = [
	{
		icon: "schedule",
		title: "60 minutos dedicados a ti",
		text: "Tiempo sin prisas para contar lo que te pasa a tu manera, sin tener que traer nada preparado.",
	},
	{
		icon: "laptop_mac",
		title: "En Pamplona o por videollamada",
		text: "En mi consulta de Pamplona o desde casa, por videollamada segura. Puedes combinar ambas modalidades.",
	},
	{
		icon: "lock",
		title: "Confidencial y sin juicios",
		text: "Lo que hablamos queda protegido por el secreto profesional. Te escucho con respeto hacia tu historia.",
	},
	{
		icon: "spa",
		title: "Herramientas para tu día a día",
		text: "Recursos sencillos para entender y regular tus emociones, que puedes poner en práctica entre sesiones.",
	},
	{
		icon: "tune",
		title: "A tu ritmo y con objetivos compartidos",
		text: "Definimos juntos qué quieres conseguir, con un enfoque integrador que tiene en cuenta emociones, pensamientos, cuerpo y relaciones.",
	},
];

const audiences = [
	{
		icon: "person",
		title: "Adultos",
		text: "Acompaño a personas adultas que desean comprender lo que sienten y adquirir herramientas para vivir de forma más consciente. Trabajo ansiedad, estrés laboral, rupturas de pareja, duelo, sobrecarga emocional, bloqueos vitales e inseguridades cotidianas.",
	},
	{
		icon: "self_improvement",
		title: "Adolescentes",
		text: "Un lugar sin juicios donde expresar lo que viven en esta etapa de cambio: gestión de emociones intensas, presión social o académica, autodescubrimiento, dudas sobre la identidad y dificultades en la convivencia familiar o escolar.",
	},
	{
		icon: "child_care",
		title: "Niños y niñas",
		text: "A través del juego y la expresión plástica y emocional, trabajo miedos infantiles, inseguridades, ansiedad, adaptación ante cambios familiares y habilidades para relacionarse de forma saludable con su entorno.",
	},
];

const problems = [
	{
		icon: "air",
		title: "Ansiedad y estrés",
		text: "Sensación de agitación permanente, pensar demasiado, tensión en el cuerpo, dificultad para calmarte y sobrecarga en el día a día.",
	},
	{
		icon: "wb_twilight",
		title: "Tristeza, desánimo y gestión emocional",
		text: "Sensación de vacío o falta de energía, apatía, desbordamiento emocional y dificultad para reconectar con el disfrute y el sentido vital.",
	},
	{
		icon: "self_improvement",
		title: "Autoestima, autocrítica e identidad",
		text: "Sensación de insuficiencia, síndrome del impostor, necesidad constante de complacer y autoexigencia severa que frena tu autenticidad.",
	},
	{
		icon: "water_drop",
		title: "Duelo, pérdidas y transiciones vitales",
		text: "Acompañamiento ante el fallecimiento de personas queridas, rupturas de pareja, cambios de etapa y adaptación a nuevos ciclos vitales.",
	},
	{
		icon: "diversity_1",
		title: "Relaciones, apego y límites saludables",
		text: "Patrones vinculares repetitivos, dependencia, dificultades para poner límites respetuosos sin culpa y resolución constructiva de conflictos.",
	},
	{
		icon: "compass_calibration",
		title: "Crecimiento personal y claridad vital",
		text: "Bloqueos e indecisión vital, búsqueda de coherencia interior, mejora del autocuidado y alineamiento de tus decisiones con tus valores.",
	},
];

// Answers contain <strong>, so they are rendered with set:html.
const faqs = [
	{
		question: "¿Cuánto dura cada sesión?",
		answer:
			"Cada sesión dura <strong>60 minutos</strong>. Es tiempo suficiente para profundizar con calma y cerrar cada encuentro sin prisas.",
	},
	{
		question: "¿Con qué frecuencia se realizan las sesiones?",
		answer:
			"Al principio suelo recomendar sesiones <strong>semanales</strong>, para crear confianza y empezar a notar alivio. A medida que ganas recursos y autonomía, las sesiones se espacian a <strong>quincenales</strong> o mensuales.",
	},
	{
		question: "¿Cómo sé si la terapia individual es para mí?",
		answer:
			"No hace falta estar en una crisis para venir. La terapia puede ayudarte si sientes un malestar que no se va, si quieres entenderte mejor, si atraviesas un cambio difícil o si quieres aprender a tratarte con más amabilidad.",
	},
	{
		question: "¿Qué pasa si nunca he ido al psicólogo antes?",
		answer:
						"Es normal sentir nervios o no saber por dónde empezar. Yo guío la conversación con suavidad, te hago preguntas que ayudan a ordenar lo que sientes y tú marcas el ritmo con el que quieres contar tu historia.",
	},
	{
		question: "¿Atiendes a niños y adolescentes?",
		answer:
			"Sí. Con menores, la primera cita suele hacerse con los padres o tutores para conocer la situación [PENDIENTE: confirmar cómo se organiza la primera cita con menores].",
	},
];
---

<Layout title={title} description={description}>
	<div class="flex flex-col w-full">
		<!-- Top Ambient Glow -->
		<div class="relative w-full overflow-hidden">
			<div
				class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[380px] bg-accent-glow/20 rounded-full blur-3xl pointer-events-none"
			>
			</div>
			<!-- Section: Breadcrumbs -->
			<div
				class="w-full max-w-[1240px] mx-auto px-margin-mobile lg:px-margin pt-6 pb-2"
			>
				<nav
					aria-label="Migas de pan"
					class="flex items-center gap-2 text-slate-muted font-label-sm text-label-sm tracking-wider uppercase"
				>
					<a
						class="hover:text-primary transition-colors flex items-center gap-1"
						href="/"
					>
						<span class="material-symbols-outlined text-[14px]">home</span>
						Inicio
					</a>
					<span class="text-outline-variant">/</span>
					<a class="hover:text-primary transition-colors" href="/servicios"
						>Servicios</a
					>
					<span class="text-outline-variant">/</span>
					<span class="text-primary font-semibold" aria-current="page"
						>Terapia Individual</span
					>
				</nav>
			</div>
			<!-- Section: Hero -->
			<section
				class="w-full max-w-[1240px] mx-auto px-margin-mobile lg:px-margin pt-4 pb-16 lg:pb-24"
			>
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
					<!-- Hero Text Left -->
					<div class="lg:col-span-7 flex flex-col gap-6">
						<h1
							class="font-headline-lg text-headline-lg lg:text-[44px] lg:leading-[54px] text-on-surface tracking-tight"
						>
							Terapia individual: entender lo que te pasa y encontrar tus <span
								class="italic font-normal text-primary">propios recursos</span
							>
						</h1>
						<p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
							Sesiones de 60 minutos, en Pamplona u online, para ordenar lo que
							sientes, salir de los bloqueos y aprender a cuidarte con más calma.
							Para adultos, adolescentes y niños.
						</p>
						<!-- CTAs -->
						<div
							class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2"
						>
							<a
								class="inline-flex items-center justify-center font-label-lg text-label-lg px-8 py-3.5 rounded-full bg-primary text-on-primary shadow-md hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 gap-2"
								href={contactHref}
							>
								<span>{ctaLabel}</span>
								<span class="material-symbols-outlined text-[18px]"
									>calendar_today</span
								>
							</a>
						</div>
						<!-- Trust Badges Bar -->
						<div
							class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-6 border-t border-border-subtle"
						>
							{
								trustBadges.map((badge) => (
									<div class="flex items-center gap-2.5">
										<div class="w-8 h-8 rounded-full bg-secondary-container flex items-center justify-center text-primary shrink-0">
											<span class="material-symbols-outlined text-[17px]">
												{badge.icon}
											</span>
										</div>
										<span class="font-label-sm text-label-sm text-on-surface-variant font-medium">
											{badge.label}
										</span>
									</div>
								))
							}
						</div>
					</div>
					<!-- Hero Visual Right -->
					<div class="lg:col-span-5 relative">
						<div
							class="relative rounded-2xl overflow-hidden shadow-xl bg-surface-container-low aspect-[4/3] lg:aspect-[1.15/1]"
						>
							<img
								alt="Sesión de psicoterapia individual en Inala"
								class="w-full h-full object-cover"
								src={heroImage}
							/>
							<div
								class="absolute inset-0 bg-gradient-to-t from-inverse-surface/40 via-transparent to-transparent"
							>
							</div>
							<!-- Floating Insight Card -->
							<div
								class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-surface-translucent backdrop-blur-md shadow-md"
							>
								<div class="flex items-center gap-3">
									<div
										class="w-10 h-10 rounded-full bg-primary-container/40 flex items-center justify-center text-primary shrink-0"
									>
										<span class="material-symbols-outlined text-[20px]">spa</span>
									</div>
									<div>
										<p
											class="font-body-sm text-body-sm text-on-surface font-medium leading-snug"
										>
											<span class="font-bold text-on-surface bg-sand-warm"
												>Confidencial</span
											><span class="text-on-surface-variant bg-sand-warm"
												>&nbsp;· a tu ritmo.</span
											>
										</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>

		<!-- Section: Enfoque / ¿Para qué la Terapia Individual? -->
		<section class="w-full bg-surface-container-lowest py-16 lg:py-24">
			<div
				class="w-full max-w-[1240px] mx-auto px-margin-mobile lg:px-margin flex flex-col gap-12 lg:gap-16"
			>
				<div class="text-left max-w-3xl flex flex-col items-start gap-3">
					<div
						class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-secondary-container text-on-secondary-container"
					>
						<span class="material-symbols-outlined text-[16px] text-primary"
							>psychology</span
						>
						<span
							class="font-label-sm text-label-sm uppercase tracking-widest font-bold"
							>¿EN QUÉ CONSISTE LA TERAPIA INDIVIDUAL?</span
						>
					</div>
					<h2
						class="font-headline-md text-headline-md lg:text-[34px] font-serif text-on-surface tracking-tight mt-1"
					>
						Poner palabras a lo que sientes para ver con más claridad
					</h2>
					<p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
						La terapia individual es un proceso cercano y con estructura: nos
						detenemos a comprender tus emociones, deshacer lo que te bloquea y
						construir recursos que te sirvan en tu día a día.
					</p>
				</div>
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
					<div class="lg:col-span-5 flex flex-col justify-between gap-6">
						<div
							class="relative rounded-3xl overflow-hidden shadow-xl bg-surface-container aspect-[4/3] lg:aspect-[4/4.5] border border-border-subtle group h-full"
						>
							<img
								alt=""
								class="w-full h-full min-h-[420px] object-cover rounded-3xl group-hover:scale-105 transition-transform duration-300"
								src={heroImage}
								loading="lazy"
							/>
							<div
								class="absolute inset-0 bg-gradient-to-t from-inverse-surface/40 via-transparent to-transparent"
							>
							</div>
							<div
								class="absolute bottom-4 left-4 right-4 bg-sand-warm/95 backdrop-blur-md p-4 rounded-2xl shadow-lg border border-border-subtle flex items-center gap-3"
							>
								<div
									class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-primary shrink-0"
								>
									<span class="material-symbols-outlined text-[20px]"
										>format_quote</span
									>
								</div>
								<p
									class="font-body-sm text-body-sm text-on-surface-variant leading-snug italic font-serif text-[14px]"
								>
									<span class="text-on-surface font-normal"
										>«Cuidar de tu mente es el primer paso para habitar tu propia
										vida con calma y presencia.»</span
									>
								</p>
							</div>
						</div>
					</div>
					<div class="lg:col-span-7 flex flex-col justify-between gap-6">
						<div
							class="p-6 lg:p-8 rounded-3xl bg-surface-container-low/50 border border-border-subtle flex flex-col gap-5"
						>
							<div class="flex items-center gap-2">
								<span class="material-symbols-outlined text-primary text-[20px]"
									>psychology_alt</span
								>
								<h3 class="font-title-md text-title-md font-semibold text-on-surface">
									¿Qué ocurre durante una sesión?
								</h3>
							</div>
							<div class="flex flex-col gap-3.5">
								{
									sessionFeatures.map((feature) => (
										<div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-container-lowest/80 border border-border-subtle">
											<div class="w-8 h-8 rounded-full bg-secondary-container text-primary flex items-center justify-center shrink-0 mt-0.5">
												<span class="material-symbols-outlined text-[18px]">
													{feature.icon}
												</span>
											</div>
											<div>
												<h4 class="font-body-md text-body-md font-semibold text-on-surface">
													{feature.title}
												</h4>
												<p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
													{feature.text}
												</p>
											</div>
										</div>
									))
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Section: ¿Para quién es la terapia individual? -->
		<section
			class="w-full bg-surface-container-low/60 py-16 lg:py-24 border-t border-border-subtle"
		>
			<div class="w-full max-w-[1240px] mx-auto px-margin-mobile lg:px-margin">
				<div class="text-center max-w-3xl mx-auto mb-14">
					<div
						class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-secondary-container text-on-secondary-container mb-3"
					>
						<span class="material-symbols-outlined text-[16px] text-primary"
							>diversity_3</span
						>
						<span
							class="font-label-sm text-label-sm uppercase tracking-widest font-bold"
							>ACOMPAÑAMIENTO EN CADA ETAPA VITAL</span
						>
					</div>
					<h2
						class="font-headline-md text-headline-md font-serif text-on-surface mt-2 mb-4 tracking-tight"
					>
						¿Para quién es la terapia individual?
					</h2>
					<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
						Acompaño a personas en distintos momentos de su vida y adapto el
						proceso y las herramientas a cada etapa:
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{
						audiences.map((audience) => (
							<div class="p-8 rounded-3xl bg-surface-container-lowest shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between border border-border-subtle">
								<div class="flex flex-col">
									<div class="w-12 h-12 rounded-2xl bg-secondary-container/60 text-primary flex items-center justify-center mb-6">
										<span class="material-symbols-outlined text-[26px]">
											{audience.icon}
										</span>
									</div>
									<h3 class="font-headline-sm text-headline-sm font-serif text-on-surface mb-3">
										{audience.title}
									</h3>
									<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
										{audience.text}
									</p>
								</div>
							</div>
						))
					}
				</div>
				<div class="mt-12 flex justify-center">
					<div
						class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full bg-sand-warm text-on-surface text-center shadow-sm max-w-2xl border border-border-subtle"
					>
						<span class="material-symbols-outlined text-primary text-[20px] shrink-0"
							>favorite</span
						>
						<span class="font-body-sm text-body-sm font-medium"
							>Sea cual sea tu momento vital, la terapia se adapta a tu ritmo y a
							lo que tú necesitas.</span
						>
					</div>
				</div>
			</div>
		</section>

		<!-- Section: ¿Qué problemas se trabajan? -->
		<section
			class="w-full bg-surface-container-low py-16 lg:py-24 border-t border-b border-border-subtle"
		>
			<div class="w-full max-w-[1240px] mx-auto px-margin-mobile lg:px-margin">
				<div class="text-center max-w-3xl mx-auto mb-14">
					<span
						class="font-label-sm text-label-sm text-primary uppercase tracking-widest font-bold"
						>¿QUÉ TRABAJAMOS EN CONSULTA?</span
					>
					<h2
						class="font-headline-md text-headline-md font-serif text-on-surface mt-2 mb-4 tracking-tight"
					>
						¿Qué problemas se trabajan?
					</h2>
					<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
						La terapia no es solo para momentos de crisis. Si te reconoces en
						alguna de estas situaciones, puedo ayudarte a encontrar claridad y
						alivio:
					</p>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{
						problems.map((problem) => (
							<div class="group p-8 rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-start border border-border-subtle">
								<div class="w-12 h-12 rounded-xl bg-secondary-container/60 text-primary flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
									<span class="material-symbols-outlined text-[26px]">
										{problem.icon}
									</span>
								</div>
								<h3 class="font-headline-sm text-headline-sm text-on-surface mb-3 font-semibold">
									{problem.title}
								</h3>
								<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
									{problem.text}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section: Preguntas Frecuentes (Acordeón interactivo) -->
		<section class="w-full bg-surface py-16 lg:py-24">
			<div class="w-full max-w-[860px] mx-auto px-margin-mobile lg:px-margin">
				<div class="text-center mb-12">
					<span
						class="font-label-sm text-label-sm text-primary uppercase tracking-widest font-bold"
						>Preguntas frecuentes</span
					>
					<h2 class="font-headline-md text-headline-md text-on-surface mt-2 mb-4">
						Preguntas frecuentes sobre la terapia individual
					</h2>
					<p class="font-body-md text-body-md text-on-surface-variant">
						Es normal tener dudas antes de empezar. Si la tuya no está aquí,
						escríbeme y te respondo.
					</p>
				</div>
				<div class="flex flex-col gap-4" id="faq-container">
					{
						faqs.map((faq, index) => (
							<div class="faq-item rounded-2xl bg-surface-container-lowest shadow-sm overflow-hidden transition-all duration-300">
								<button
									aria-expanded="false"
									aria-controls={`faq-content-${index}`}
									class="faq-trigger w-full p-6 text-left flex items-center justify-between gap-4 focus:outline-none"
									type="button"
								>
									<span class="font-title-md text-title-md text-on-surface font-semibold">
										{faq.question}
									</span>
									<span
										class="faq-icon material-symbols-outlined text-primary text-[22px] transition-transform duration-300"
										aria-hidden="true"
									>
										add
									</span>
								</button>
								<div
									class="faq-content hidden px-6 pb-6 pt-0"
									id={`faq-content-${index}`}
								>
									<p
										class="font-body-md text-body-md text-on-surface-variant leading-relaxed"
										set:html={faq.answer}
									/>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Section: Banner Final -->
		<section
			class="w-full bg-inverse-surface py-20 lg:py-28 relative overflow-hidden"
			id="contacto-reserva"
		>
			<div
				class="absolute -bottom-24 -left-20 w-96 h-96 bg-primary/20 rounded-full blur-3xl pointer-events-none"
			>
			</div>
			<div
				class="absolute -top-24 -right-20 w-96 h-96 bg-accent-glow/10 rounded-full blur-3xl pointer-events-none"
			>
			</div>
			<div
				class="w-full max-w-[1000px] mx-auto px-margin-mobile lg:px-margin text-center relative z-10 flex flex-col items-center gap-8"
			>
				<div
					class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/30 text-primary-fixed border-subtle"
				>
