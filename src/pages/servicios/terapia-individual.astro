<script>
	const faqTriggers =
		document.querySelectorAll<HTMLButtonElement>(".faq-trigger");

	const setOpen = (trigger: HTMLButtonElement, open: boolean) => {
		trigger.setAttribute("aria-expanded", String(open));
		trigger.nextElementSibling?.classList.toggle("hidden", !open);
		const icon = trigger.querySelector(".faq-icon");
		if (icon) {
			icon.textContent = open ? "close" : "add";
			icon.classList.toggle("rotate-45", open);
		}
	};

	for (const trigger of faqTriggers) {
		trigger.addEventListener("click", () => {
			const expanded = trigger.getAttribute("aria-expanded") === "true";
			// Close the other FAQs so only one stays open.
			for (const other of faqTriggers) {
				if (other !== trigger) setOpen(other, false);
			}
			setOpen(trigger, !expanded);
		});
	}
</script>
