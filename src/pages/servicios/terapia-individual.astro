---
import CtaBand from "../../components/CtaBand.astro";
import Faq from "../../components/Faq.astro";
import Frase from "../../components/Frase.astro";
import PageHero from "../../components/PageHero.astro";
import Relacionados from "../../components/Relacionados.astro";
import Consiste from "../../components/servicio/Consiste.astro";
import ParaQuien from "../../components/servicio/ParaQuien.astro";
import Problemas from "../../components/servicio/Problemas.astro";
import Layout from "../../layouts/Layout.astro";

const logros = [
	"Reducir la ansiedad y el estrés",
	"Reforzar tu autoestima",
	"Comprender tus reacciones emocionales",
	"Afrontar cambios vitales",
	"Superar situaciones dolorosas",
	"Cultivar una relación más compasiva contigo",
	"Desarrollar herramientas de autorregulación emocional",
	"Mejorar tus relaciones interpersonales",
];

const incluye = [
	"Sesiones de 60 minutos para cuidarte y escucharte",
	"Modalidad presencial u online, donde y cuando quieras",
	"Espacio seguro y confidencial, a tu ritmo",
	"Terapia personalizada y adaptada a tus necesidades",
	"Abordaje integral orientado a objetivos",
	"Seguimiento profesional continuo",
	"Herramientas prácticas para tu día a día",
	"Recursos complementarios entre sesiones",
];

const paraQuien = [
	{
		title: "Adultos",
		text: "Acompaño a personas adultas que desean comprender lo que sienten y desarrollar herramientas para vivir de forma más consciente. Trabajamos ansiedad, estrés laboral, rupturas, duelo, sobrecarga emocional, bloqueos o inseguridades.",
	},
	{
		title: "Adolescentes",
		text: "Un espacio donde expresar sin juicio lo que viven: emociones intensas, presión social, identidad, dificultades escolares o familiares.",
	},
	{
		title: "Niños y niñas",
		text: "A través del juego y la expresión emocional, trabajamos miedos, inseguridad, ansiedad, cambios familiares o dificultades sociales.",
	},
];

const problemas = [
	"Ansiedad y estrés",
	"Tristeza o desmotivación",
	"Baja autoestima y inseguridades",
	"Duelo y procesos de pérdida",
	"Emociones intensas o desbordamiento",
	"Bloqueos personales y profesionales",
	"Transiciones vitales importantes",
	"Dificultades en relaciones o comunicación",
	"Problemas de sueño y descanso",
	"Gestión del tiempo y prioridades",
	"Conflictos familiares o laborales",
	"Crecimiento personal y autoconocimiento",
];

const preguntas = [
	{
		question: "¿Cuándo debería acudir a terapia individual?",
		answer:
			"Es recomendable acudir cuando sientes que algo te supera, te genera malestar, te bloquea o afecta a tu vida diaria. También si estás pasando por ansiedad, estrés, indecisión, problemas de autoestima, dificultades relacionales, duelo o simplemente necesitas un espacio para comprenderte mejor.",
	},
	{
		question: "¿Cuánto dura un proceso de terapia individual?",
		answer:
			"Cada proceso es único. Algunas personas encuentran mejoras en pocas sesiones y otras necesitan un acompañamiento más profundo. Lo habitual es que al inicio las sesiones sean semanales y después se espacien según tus necesidades y evolución.",
	},
	{
		question: "¿Qué se hace en una sesión de terapia individual?",
		answer:
			"En cada sesión hablamos sobre tus emociones, pensamientos y experiencias recientes. Trabajamos herramientas prácticas de regulación emocional, patrones de pensamiento, traumas pasados, gestión de relaciones y construcción de nuevos hábitos internos. Todo adaptado a ti y a tu ritmo.",
	},
	{
		question: "¿Cómo puedo empezar mi proceso de terapia individual?",
		answer:
			"Solo necesitas reservar tu primera sesión. En esa primera toma de contacto revisaremos tu situación, tus objetivos y definiremos un plan personalizado para comenzar tu proceso con claridad.",
	},
	{
		question: "¿Cuántas sesiones voy a necesitar?",
		answer:
			"No existe un número fijo. Depende de tus objetivos, tu historia y tu ritmo personal. En la primera sesión definiremos un plan aproximado y lo iremos ajustando según tu evolución.",
	},
];

const relacionados = [
	{ href: "/servicios/terapia-de-pareja", label: "Terapia de pareja" },
	{ href: "/servicios/terapia-familiar", label: "Terapia familiar" },
	{ href: "/servicios/psicologia-perinatal", label: "Psicología perinatal" },
	{ href: "/servicios/terapia-online", label: "Terapia online" },
];
---

<Layout
	title="Terapia individual en Pamplona | Psicóloga para adultos, adolescentes y niños"
	description="Terapia individual en Pamplona para ansiedad, autoestima, estrés, duelo, emociones intensas y bienestar emocional. Atención a adultos, adolescentes y niños. Espacio seguro, cercano y profesional."
>
	<PageHero
		title="Terapia individual"
		lead="La terapia individual es un espacio seguro donde explorar lo que sientes, comprender tus emociones y acompañarte hacia un mayor bienestar. Desde un enfoque cercano e integral, acompaño a adultos, adolescentes y niños/as que desean mejorar su salud emocional, atravesar un momento difícil o iniciar un proceso de crecimiento personal."
		cta={{ href: "/contacto", label: "Reserva tu cita" }}
	/>

	<Consiste
		title="¿En qué consiste la terapia individual?"
		text="La terapia individual es un proceso donde podemos detenernos, mirar hacia dentro y poner palabras a lo que te ocurre. En las sesiones trabajamos tus emociones, pensamientos y vivencias para que puedas:"
		logros={logros}
		incluye={incluye}
	/>

	<Frase
		title="Regálate un espacio para reconectar y cuidar de ti"
		text="Cuando la mente no descansa y el cuerpo lo siente, es momento de escucharte. Encuentra en la terapia un lugar seguro y profesional para comprenderte, aliviar el malestar y recuperar tu equilibrio. Cada parte de ti merece atención y cuidado."
	/>

	<ParaQuien title="¿Para quién es la terapia individual?" items={paraQuien} />

	<CtaBand
		title="Ahora es tu oportunidad. Comienza a priorizarte."
		text="Ahora es tu oportunidad de dar el primer paso y comenzar a priorizarte, cuidando tu bienestar y dedicando tiempo a lo que realmente necesitas."
		label="Dar el primer paso"
	/>

	<Problemas title="¿Que problemas se trabajan?" items={problemas} />

	<CtaBand
		variant="camino"
		title="Empieza tu proceso de terapia individual"
		text="Reserva tu primera sesión y da el primer paso hacia un mayor bienestar emocional y autoconocimiento."
		label="Reservar sesión"
	/>

	<Faq items={preguntas} />

	<Relacionados links={relacionados} />
</Layout>
