---
import { Image } from 'astro:assets';
import Hero from '../../components/custom/BasicHeroCTA.astro';
import Frases from '../../components/custom/Frases.astro';
import JoinBox from '../../components/custom/JoinBox.astro';
import TitleSection from '../../components/custom/TitleSection.astro';
import Col from '../../components/ui/Col.astro';
import Row from '../../components/ui/Row.astro';
import Section from '../../components/ui/Section.astro';
import Card from '../../components/ui/cards/Card.astro';
import Layout from '../../layouts/Layout.astro';

const SEO = {
   title: 'Terapia individual en Pamplona | Psicóloga para adultos, adolescentes y niños',
   description:
      'Terapia individual en Pamplona para ansiedad, autoestima, estrés, duelo, emociones intensas y bienestar emocional. Atención a adultos, adolescentes y niños. Espacio seguro, cercano y profesional.',
};

const preguntas = [
   {
      question: '¿Cuándo debería acudir a terapia individual?',
      answer:
         'Es recomendable acudir cuando sientes que algo te supera, te genera malestar, te bloquea o afecta a tu vida diaria. También si estás pasando por ansiedad, estrés, indecisión, problemas de autoestima, dificultades relacionales, duelo o simplemente necesitas un espacio para comprenderte mejor.',
   },

   {
      question: '¿Cuánto dura un proceso de terapia individual?',
      answer:
         'Cada proceso es único. Algunas personas encuentran mejoras en pocas sesiones y otras necesitan un acompañamiento más profundo. Lo habitual es que al inicio las sesiones sean semanales y después se espacien según tus necesidades y evolución.',
   },
   {
      question: '¿Qué se hace en una sesión de terapia individual?',
      answer:
         'En cada sesión hablamos sobre tus emociones, pensamientos y experiencias recientes. Trabajamos herramientas prácticas de regulación emocional, patrones de pensamiento, traumas pasados, gestión de relaciones y construcción de nuevos hábitos internos. Todo adaptado a ti y a tu ritmo.',
   },
   {
      question: '¿Cómo puedo empezar mi proceso de terapia individual?',
      answer:
         'Solo necesitas reservar tu primera sesión. En esa primera toma de contacto revisaremos tu situación, tus objetivos y definiremos un plan personalizado para comenzar tu proceso con claridad.',
   },
   {
      question: '¿Cuántas sesiones voy a necesitar?',
      answer:
         'No existe un número fijo. Depende de tus objetivos, tu historia y tu ritmo personal. En la primera sesión definiremos un plan aproximado y lo iremos ajustando según tu evolución.',
   },
];
---

<Layout title={SEO.title} description={SEO.description}>
   <Hero
      title="Terapia individual"
      text="La terapia individual es un espacio seguro donde explorar lo que sientes, comprender tus emociones y acompañarte hacia un mayor bienestar. Desde un enfoque cercano e integral, acompaño a adultos, adolescentes y niños/as que desean mejorar su salud emocional, atravesar un momento difícil o iniciar un proceso de crecimiento personal."
   />

   <Section classes="mt-0! pt-0!">
      <TitleSection
         title="¿En qué consiste la terapia individual?"
         text="La terapia individual es un proceso donde podemos detenernos, mirar hacia dentro y poner palabras a lo que te ocurre. En las sesiones trabajamos tus emociones, pensamientos y vivencias para que puedas:"
         classes="lg:pb-15!"
      />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Reducir la ansiedad y el estrés</li>
                     <li>Reforzar tu autoestima</li>
                     <li>Comprender tus reacciones emocionales</li>
                     <li>Afrontar cambios vitales</li>
                     <li>Superar situaciones dolorosas</li>
                     <li>Cultivar una relación más compasiva contigo</li>
                     <li>Desarrollar herramientas de autorregulación emocional</li>
                     <li>Mejorar tus relaciones interpersonales</li>
                  </ul>
               </div>
            </Card>
         </Col>
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Sesiones de 60 minutos para cuidarte y escucharte</li>
                     <li>Modalidad presencial u online, donde y cuando quieras</li>
                     <li>Espacio seguro y confidencial, a tu ritmo</li>
                     <li>Terapia personalizada y adaptada a tus necesidades</li>
                     <li>Abordaje integral orientado a objetivos</li>
                     <li>Seguimiento profesional continuo</li>
                     <li>Herramientas prácticas para tu día a día</li>
                     <li>Recursos complementarios entre sesiones</li>
                  </ul>
               </div>
            </Card>
         </Col>
      </Row>
   </Section>

   <Frases
      title="Regálate un espacio para reconectar y cuidar de ti"
      text="Cuando la mente no descansa y el cuerpo lo siente, es momento de escucharte. Encuentra en la terapia un lugar seguro y profesional para comprenderte, aliviar el malestar y recuperar tu equilibrio. Cada parte de ti merece atención y cuidado."
   />

   <!-- PARA QUIÉN ES -->
   <Section decoration="all" type="none" classes="pt-0!">
      <TitleSection title="¿Para quién es la terapia individual?" text="" classes="lg:pb-15!" />

      <Row classes="!p-0 !m-0">
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/image1.webp'}
                     alt={'imagen 01'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">Adultos</span>
                  <p class="text-lg">
                     Acompaño a personas adultas que desean comprender lo que sienten y desarrollar
                     herramientas para vivir de forma más consciente. Trabajamos ansiedad, estrés
                     laboral, rupturas, duelo, sobrecarga emocional, bloqueos o inseguridades.
                  </p>
               </div>
            </div>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/image2.webp'}
                     alt={'imagen 11'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">Adolescentes</span>
                  <p class="text-lg">
                     Un espacio donde expresar sin juicio lo que viven: emociones intensas, presión
                     social, identidad, dificultades escolares o familiares.
                  </p>
               </div>
            </div>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-4 p-0">
            <div class="flex h-full flex-col gap-6 lg:gap-12">
               <div class="">
                  <Image
                     src={'/assets/images/image3.webp'}
                     alt={'imagen 18'}
                     width={800}
                     height={800}
                     inferSize
                     class="aspect-video object-cover"
                  />
               </div>
               <div class="flex flex-col gap-2">
                  <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">Niños y niñas</span>
                  <p class="text-lg">
                     A través del juego y la expresión emocional, trabajamos miedos, inseguridad,
                     ansiedad, cambios familiares o dificultades sociales.
                  </p>
               </div>
            </div>
         </Card>
      </Row>
   </Section>

   <JoinBox
      title="Ahora es tu oportunidad. Comienza a priorizarte."
      subtitle="Ahora es tu oportunidad de dar el primer paso y comenzar a priorizarte, cuidando tu bienestar y dedicando tiempo a lo que realmente necesitas."
      buttonText="Dar el primer paso"
   />

   <Section classes="mt-0! pt-0!">
      <TitleSection title="¿Que problemas se trabajan?" text="" classes="lg:pb-15!" />
      <Row classes="!gap-5 max-[500px]:px-0">
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Ansiedad y estrés</li>
                     <li>Tristeza o desmotivación</li>
                     <li>Baja autoestima y inseguridades</li>
                     <li>Duelo y procesos de pérdida</li>
                     <li>Emociones intensas o desbordamiento</li>
                     <li>Bloqueos personales y profesionales</li>
                  </ul>
               </div>
            </Card>
         </Col>
         <Col span="6">
            <Card>
               <div class="text-lg">
                  <ul>
                     <li>Transiciones vitales importantes</li>
                     <li>Dificultades en relaciones o comunicación</li>
                     <li>Problemas de sueño y descanso</li>
                     <li>Gestión del tiempo y prioridades</li>
                     <li>Conflictos familiares o laborales</li>
                     <li>Crecimiento personal y autoconocimiento</li>
                  </ul>
               </div>
            </Card>
         </Col>
      </Row>
   </Section>

   <JoinBox
      title="Empieza tu proceso de terapia individual"
      subtitle="Reserva tu primera sesión y da el primer paso hacia un mayor bienestar emocional y autoconocimiento."
      buttonText="Reservar sesión"
   />

   <Section decoration="all" type="" classes="">
      <Row classes="">
         <Col span="5">
            <h2 class="text-left">Preguntas Frecuentes</h2>
         </Col>
         <Col span="7">
            {
               preguntas.map((pregunta) => (
                  <Card classes="mb-5">
                     <details class="group">
                        <summary class="flex cursor-pointer list-none items-center justify-between">
                           <h4 class="!m-0 p-0">{pregunta.question}</h4>
                           <span class="transition group-open:rotate-180">
                              <svg
                                 fill="none"
                                 height="24"
                                 shape-rendering="geometricPrecision"
                                 stroke="currentColor"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 stroke-width="1.5"
                                 viewBox="0 0 24 24"
                                 width="24"
                              >
                                 <path d="M6 9l6 6 6-6" />
                              </svg>
                           </span>
                        </summary>
                        <p class="group-open:animate-fadeIn mt-3">{pregunta.answer}</p>
                     </details>
                  </Card>
               ))
            }
         </Col>
      </Row>
   </Section>

   <!-- ENLACES INTERNOS -->
   <Section decoration="all" type="none" classes="pt-0!">
      <h3>También te puede interesar</h3>
      <Row classes="!p-0 !m-0">
         <Card classes="relative col-span-12 lg:col-span-3 !p-0">
            <a href="./terapia-de-pareja" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia de pareja {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./terapia-familiar" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia familiar {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./psicologia-perinatal" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Psicología perinatal {'>'}</button
               >
            </a>
         </Card>
         <Card classes="relative col-span-12 lg:col-span-3 p-0">
            <a href="./terapia-online" class="h-full w-full cursor-pointer">
               <button class="h4 h-full w-full cursor-pointer text-lg! lg:text-xl! lg:leading-9!"
                  >Terapia online {'>'}</button
               >
            </a>
         </Card>
      </Row>
   </Section>
</Layout>
