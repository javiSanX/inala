---
import heroImage from "../../assets/images/terapia_individual.jpeg";
import OtherServices from "../../components/OtherServices.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/ui/Button.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import FactList from "../../components/ui/FactList.astro";
import Faq from "../../components/ui/Faq.astro";
import Figure from "../../components/ui/Figure.astro";
import Icon from "../../components/ui/Icon.astro";
import type { IconName } from "../../components/ui/icons";
import Note from "../../components/ui/Note.astro";
import Quote from "../../components/ui/Quote.astro";
import Section from "../../components/ui/Section.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import TopicList from "../../components/ui/TopicList.astro";
import { contactHref, ctaLabel, email, licenseNumber } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title = "Terapia individual en Pamplona y online | Inala Psicoterapia";

const description =
	"Terapia individual para adultos, adolescentes y niños en Pamplona y online: ansiedad, estrés, autoestima, duelo y relaciones. Sesiones de 60 minutos con María Sánchez, psicóloga general sanitaria.";

const trustBadges = [
	{ icon: "schedule", label: "Sesiones de 60 minutos" },
	{ icon: "pin_drop", label: "Pamplona y online" },
];

const sessionFeatures: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "schedule",
		title: "60 minutos dedicados a ti",
		text: "Tiempo sin prisas para contar lo que te pasa a tu manera, sin tener que traer nada preparado.",
	},
	{
		icon: "videocam",
		title: "En Pamplona o por videollamada",
		text: "En mi consulta de Pamplona o desde casa, por videollamada segura. Puedes combinar ambas modalidades.",
	},
	{
		icon: "lock",
		title: "Confidencial y sin juicios",
		text: "Lo que hablamos queda protegido por el secreto profesional. Te escucho con respeto hacia tu historia.",
	},
	{
		icon: "healing",
		title: "Herramientas para tu día a día",
		text: "Recursos sencillos para entender y regular tus emociones, que puedes poner en práctica entre sesiones.",
	},
	{
		icon: "chat",
		title: "A tu ritmo y con objetivos compartidos",
		text: "Definimos juntos qué quieres conseguir, con un enfoque integrador que tiene en cuenta emociones, pensamientos, cuerpo y relaciones.",
	},
];

const audiences: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "person",
		title: "Adultos",
		text: "Acompaño a personas adultas que desean comprender lo que sienten y adquirir herramientas para vivir de forma más consciente. Trabajo ansiedad, estrés laboral, rupturas de pareja, duelo, sobrecarga emocional, bloqueos vitales e inseguridades cotidianas.",
	},
	{
		icon: "chat",
		title: "Adolescentes",
		text: "Un lugar sin juicios donde expresar lo que viven en esta etapa de cambio: gestión de emociones intensas, presión social o académica, autodescubrimiento, dudas sobre la identidad y dificultades en la convivencia familiar o escolar.",
	},
	{
		icon: "child_care",
		title: "Niños y niñas",
		text: "A través del juego y la expresión plástica y emocional, trabajo miedos infantiles, inseguridades, ansiedad, adaptación ante cambios familiares y habilidades para relacionarse de forma saludable con su entorno.",
	},
];

const problems: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "air",
		title: "Ansiedad y estrés",
		text: "Sensación de agitación permanente, pensar demasiado, tensión en el cuerpo, dificultad para calmarte y sobrecarga en el día a día.",
	},
	{
		icon: "light_mode",
		title: "Tristeza, desánimo y gestión emocional",
		text: "Sensación de vacío o falta de energía, apatía, desbordamiento emocional y dificultad para reconectar con el disfrute y el sentido vital.",
	},
	{
		icon: "person",
		title: "Autoestima, autocrítica e identidad",
		text: "Sensación de insuficiencia, síndrome del impostor, necesidad constante de complacer y autoexigencia severa que frena tu autenticidad.",
	},
	{
		icon: "healing",
		title: "Duelo, pérdidas y transiciones vitales",
		text: "Acompañamiento ante el fallecimiento de personas queridas, rupturas de pareja, cambios de etapa y adaptación a nuevos ciclos vitales.",
	},
	{
		icon: "diversity_1",
		title: "Relaciones, apego y límites saludables",
		text: "Patrones vinculares repetitivos, dependencia, dificultades para poner límites respetuosos sin culpa y resolución constructiva de conflictos.",
	},
	{
		icon: "psychology",
		title: "Crecimiento personal y claridad vital",
		text: "Bloqueos e indecisión vital, búsqueda de coherencia interior, mejora del autocuidado y alineamiento de tus decisiones con tus valores.",
	},
];

// Answers contain <strong>, so they are rendered with set:html.
const faqs = [
	{
		question: "¿Cuánto dura cada sesión?",
		answer:
			"Cada sesión dura <strong>60 minutos</strong>. Es tiempo suficiente para profundizar con calma y cerrar cada encuentro sin prisas.",
	},
	{
		question: "¿Con qué frecuencia se realizan las sesiones?",
		answer:
			"Al principio suelo recomendar sesiones <strong>semanales</strong>, para crear confianza y empezar a notar alivio. A medida que ganas recursos y autonomía, las sesiones se espacian a <strong>quincenales</strong> o mensuales.",
	},
	{
		question: "¿Cómo sé si la terapia individual es para mí?",
		answer:
			"No hace falta estar en una crisis para venir. La terapia puede ayudarte si sientes un malestar que no se va, si quieres entenderte mejor, si atraviesas un cambio difícil o si quieres aprender a tratarte con más amabilidad.",
	},
	{
		question: "¿Qué pasa si nunca he ido al psicólogo antes?",
		answer:
			"Es normal sentir nervios o no saber por dónde empezar. Yo guío la conversación con suavidad, te hago preguntas que ayudan a ordenar lo que sientes y tú marcas el ritmo con el que quieres contar tu historia.",
	},
	{
		question: "¿Atiendes a niños y adolescentes?",
		answer:
			"Sí. Con menores, la primera cita suele hacerse con los padres o tutores para conocer la situación [PENDIENTE: confirmar cómo se organiza la primera cita con menores].",
	},
];
---

<Layout title={title} description={description}>
	<PageHero accent backgroundImage={heroImage}>
		<Fragment slot="title">
			{
				/* Below lg each run is its own line, sized from the viewport width so
			  "Terapia psicológica" is the larger and both always fit on one line. */
			}
			<span class="max-lg:block max-lg:text-hero-lead"
				>Terapia individual</span
			><br />
			<span class="hero-accent max-lg:block max-lg:text-hero-run"
				>entender lo que te pasa y encontrar tus propios recursos</span
			>
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Sesiones de 60 minutos, en Pamplona u online, para ordenar lo que
			sientes, salir de los bloqueos y aprender a cuidarte con más calma.
			Para adultos, adolescentes y niños.
		</p>
		
		<div class="flex flex-wrap gap-3 pt-2">
			<Button href={contactHref} icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
		</div>
		<FactList
			facts={trustBadges.map((badge) => ({
				title: badge.label,
				icon: badge.icon,
			}))}
			class="mt-4"
		/>
		<Fragment slot="caption">
			<Icon name="lock" class="text-teal" />
			<span
				><span class="font-semibold text-ink">Confidencial</span><span
					>&nbsp;· a tu ritmo.</span
				></span
			>
		</Fragment>
	</PageHero>

	<!-- ¿En qué consiste? -->
	<Section tone="white">
		<SectionHeader title="¿Qué ocurre durante una sesión?">

		</SectionHeader>
		<div class="mt-14 grid gap-x-16 gap-y-12 lg:grid-cols-12">
			<div class="flex flex-col gap-10 lg:col-span-5">
				<Figure src={heroImage} alt="" ratio="landscape" />
				<Quote class="italic">
					«Cuidar de tu mente es el primer paso para habitar tu propia vida
					con calma y presencia.»
				</Quote>
			</div>
			<div class="lg:col-span-7">
				<TopicList
					items={sessionFeatures}
					icons
					columns={1}
					level={4}
					class="mt-6"
				/>
			</div>
		</div>
	</Section>

	<!-- ¿Para quién? -->
	<Section tone="mist">
		<SectionHeader>
			<Fragment slot="title">
				¿Para quién es la <span class="text-teal">terapia individual</span>?
			</Fragment>

		</SectionHeader>
		<ul class="mt-24 grid gap-x-12 gap-y-20 lg:grid-cols-3">
			{
				audiences.map((audience, index) => (
					<li
						class="reveal-blur relative border-t border-seafoam pt-16"
						data-reveal
						style={`--reveal: ${index}`}
					>
						<span class="absolute top-0 left-0 grid size-16 -translate-y-1/2 place-items-center rounded-full bg-white text-3xl text-teal ring-8 ring-mist">
							<Icon name={audience.icon} />
						</span>
						<h3 class="font-display text-heading font-normal text-ink">
							{audience.title}
						</h3>
						<p class="mt-4 text-body text-ink-muted">{audience.text}</p>
					</li>
				))
			}
		</ul>
		<Note class="mt-16">
			Sea cual sea tu momento vital, la terapia se adapta a tu ritmo y a lo
			que tú necesitas.
		</Note>
	</Section>

	<!-- ¿Qué problemas se trabajan? -->
	<Section tone="white">
		<SectionHeader>
			<Fragment slot="title">
				¿Qué <span class="text-teal">problemas se trabajan</span>?
			</Fragment>

		</SectionHeader>
		<ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
			{
				problems.map((problem, index) => (
					<li
						class="reveal-blur flex flex-col gap-3"
						data-reveal
						style={`--reveal: ${index}`}
					>
						<div class="flex items-center gap-4">
							<span class="grid size-10 shrink-0 place-items-center rounded-full bg-seafoam-soft text-xl text-teal">
								<Icon name={problem.icon} />
							</span>
							<span class="h-px flex-1 bg-line" aria-hidden="true" />
						</div>
						<h3 class="font-display text-lead font-normal text-ink">
							{problem.title}
						</h3>
						<p class="text-body text-ink-muted">{problem.text}</p>
					</li>
				))
			}
		</ul>
	</Section>

	<CtaBand
		id="contacto-reserva"
		label="Tu bienestar empieza hoy"
		title="Dar el primer paso requiere valentía, pero no tienes que hacerlo solo/a."
	>
		<p class="tabular-nums">
			Solicita tu primera cita o escríbeme si antes quieres resolver alguna
			duda. Sesión de 60 minutos · 65 €.
		</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" arrow>
				<span>{ctaLabel}</span>
			</Button>
			<Button href={`mailto:${email}`} variant="inverse-outline" icon="mail">
				<span>{email}</span>
			</Button>
		</Fragment>
	</CtaBand>
	<!-- Preguntas frecuentes -->
	<Section>
		<div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
			<SectionHeader
				title="Preguntas frecuentes sobre la terapia individual"
				layout="stack"
				class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
			>
				<p>
					Es normal tener dudas antes de empezar. Si la tuya no está aquí,
					escríbeme y te respondo.
				</p>
			</SectionHeader>
			<Faq items={faqs} class="lg:col-span-7" />
		</div>
	</Section>

	<OtherServices />
</Layout>
