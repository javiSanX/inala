---
import heroImage from "../../assets/images/terapia_de_pareja.jpeg";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import OtherServices from "../../components/OtherServices.astro";
import PageHero from "../../components/PageHero.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import SessionHour from "../../components/SessionHour.astro";
import Button from "../../components/ui/Button.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import Faq from "../../components/ui/Faq.astro";
import Icon from "../../components/ui/Icon.astro";
import type { IconName } from "../../components/ui/icons";
import Note from "../../components/ui/Note.astro";
import Quote from "../../components/ui/Quote.astro";
import Section from "../../components/ui/Section.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { contactHref, ctaLabel, email } from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title = "Terapia de pareja en Pamplona y online | Inala Psicoterapia";

const description =
	"Terapia de pareja en Pamplona y online, sin tomar partido: comunicación, distanciamiento, infidelidad, crianza y separación. Sesiones de 60 minutos.";

const sessionFeatures = [
	{
		title: "Sesiones de 60 minutos con los dos",
		text: "Tiempo para que cada uno tenga su espacio para hablar y ser escuchado, sin prisas.",
	},
	{
		title: "Sin tomar partido",
		text: "Una mirada profesional externa que no se pone del lado de nadie y os ayuda a entenderos.",
	},
	{
		title: "Salir de las discusiones que se repiten",
		text: "Vemos juntos qué hace que las discusiones escalen (retirarse, atacar, enfriarse) y cómo frenarlas en el momento.",
	},
	{
		title: "Herramientas para comunicaros y llegar a acuerdos",
		text: "Formas concretas de decir lo que necesitáis, resolver desacuerdos del día a día y repartir responsabilidades.",
	},
	{
		title: "En Pamplona o por videollamada",
		text: "En mi consulta de Pamplona o desde casa, por videollamada segura.",
	},
];

const audiences: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "favorite",
		title: "Parejas en crisis o distanciamiento",
		text: "Para parejas que sienten que conviven como extraños o meros compañeros de piso, con falta de afecto, desconexión física y emocional, o pérdida paulatina de la complicidad y la intimidad.",
	},
	{
		icon: "forum",
		title: "Dificultades de comunicación",
		text: "Para quienes sienten que cualquier conversación termina en discusiones estériles, malentendidos recurrentes, reproches acumulados o dinámicas desgastantes de ataque y silencio defensivo.",
	},
	{
		icon: "call_split",
		title: "Transiciones o separación consciente",
		text: "Para parejas que afrontan la llegada del primer hijo, duelo compartido, infidelidades o la decisión de separarse, intentando cuidar el bienestar de los dos y de los hijos durante el proceso.",
	},
];

const problems: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "repeat",
		title: "Crisis de comunicación y discusiones circulares",
		text: "Salir del bucle de reproches y malentendidos, y practicar una escucha sin ponerse a la defensiva.",
	},
	{
		icon: "heart_broken",
		title: "Distanciamiento emocional y falta de intimidad",
		text: "Reconexión afectiva, recuperación de los momentos compartidos, y reconstrucción del espacio íntimo, sensorial y erótico de la pareja.",
	},
	{
		icon: "healing",
		title: "Heridas de apego, traiciones e infidelidad",
		text: "Reparar el daño, trabajar la desconfianza y reconstruir la seguridad en la relación.",
	},
	{
		icon: "escalator_warning",
		title: "Conflictos en la crianza y familias de origen",
		text: "Poner límites sanos con las familias de origen, ponerse de acuerdo en la crianza y cuidar el espacio de pareja.",
	},
	{
		icon: "checklist_rtl",
		title: "Reparto desigual de la carga mental y tareas",
		text: "Reequilibrio de las responsabilidades domésticas y logísticas, visibilización del esfuerzo invisible y prevención del resentimiento silencioso.",
	},
	{
		icon: "door_open",
		title: "Acompañamiento en la separación consciente",
		text: "Acompañamiento para cerrar la relación con el mayor cuidado posible, para los dos y para los hijos si los hay.",
	},
];

const faqs = [
	{
		question:
			"¿Qué pasa si una de las partes no está del todo convencida de venir?",
		answer:
			"Es algo muy habitual. La terapia de pareja no busca forzar a nadie ni juzgar. En la primera sesión los dos podéis contar cómo os sentís y qué dudas tenéis, sin presiones. A menudo, quien llega con reticencias descubre que también se le escucha y respeta.",
	},
	{
		question: "¿La terapeuta se pondrá del lado de alguno de los dos?",
		answer:
			"No. Mi trabajo es mantener una posición neutral: el foco no está en uno de vosotros, sino en la relación que compartís. Os ayudo a entender cómo os relacionáis, sin tomar partido ni buscar culpables.",
	},
	{
		question: "¿Cuánto duran y con qué frecuencia son las sesiones?",
		answer:
			"Cada sesión dura 60 minutos. Generalmente empezamos con sesiones semanales, que después se espacian según cómo evolucione la pareja.",
	},
	{
		question: "¿Y si nuestro objetivo termina siendo separarnos?",
		answer:
			"El éxito de la terapia no se define únicamente por continuar juntos a toda costa, sino por alcanzar claridad, coherencia y paz. Si a lo largo del proceso descubrís que el camino más saludable es la separación, os acompaño para que se desarrolle de manera consciente, respetuosa y cuidando el bienestar común y el de vuestros hijos si los hubiera.",
	},
];
---

<Layout title={title} description={description} heroFont>
	<PageHero
		size="display"
		accent
		backgroundImage={heroImage}
		mobileBackground="corner"
	>
		<Breadcrumbs
			slot="breadcrumbs"
			items={[
				{ name: "Inicio", href: "/" },
				{ name: "Servicios", href: "/servicios/" },
				{ name: "Terapia de Pareja" },
			]}
		/>
		<Fragment slot="title">
			{
				/* Below lg each run is its own line, sized from the viewport width so
			  the lead is the larger and both always fit on one line. */
			}
			<span class="max-lg:block max-lg:text-hero-lead">Terapia de pareja</span
			>{" "}
			<span class="hero-accent max-lg:block max-lg:text-hero-run"
				>volver a entenderos</span
			>
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Un proceso para los dos, guiado y sin tomar partido, donde salir de las
			dinámicas que os hacen daño, recuperar una comunicación sincera y
			reconstruir la confianza, la intimidad y el proyecto en común.
		</p>

		<div class="flex flex-wrap gap-3 pt-2">
			<Button href={contactHref} icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
		</div>
	</PageHero>

	<!-- ¿En qué consiste? -->
	<Section tone="white" class="max-lg:pt-10">
		<SessionHour
			items={sessionFeatures.map((feature) => `${feature.title}. ${feature.text}`)}
			image={heroImage}
		>
			<SectionHeader
				slot="header"
				title="Poner palabras a lo que duele y volver a encontraros"
				size="large"
			/>
			<Quote class="italic">
				«El amor no es solo sentirlo, sino saber cuidarlo y habitar un espacio
				donde ambos os sintáis vistos, seguros y valorados.»
			</Quote>
		</SessionHour>
	</Section>

	<!-- ¿Para quién? -->
	<Section tone="mist">
		<SectionHeader size="large">
			<Fragment slot="title">¿Para quién es la terapia de pareja?</Fragment>
		</SectionHeader>
		<ul class="mt-24 grid gap-x-12 gap-y-20 lg:grid-cols-3">
			{
				audiences.map((audience, index) => (
					<li
						class="reveal-blur relative border-t border-seafoam pt-16"
						data-reveal
						style={`--reveal: ${index}`}
					>
						<span class="absolute top-0 left-0 grid size-16 -translate-y-1/2 place-items-center rounded-full bg-white text-3xl text-teal ring-8 ring-mist">
							<Icon name={audience.icon} />
						</span>
						<h3 class="font-display text-heading font-normal text-ink">
							{audience.title}
						</h3>
						<p class="mt-4 text-body text-ink-muted">{audience.text}</p>
					</li>
				))
			}
		</ul>
		<Note class="mt-16">
			No hace falta estar al borde de la ruptura para venir: pedir ayuda a tiempo
			evita mucho desgaste.
		</Note>
	</Section>

	<!-- ¿Qué problemas se trabajan? -->
	<Section tone="white">
		<SectionHeader size="large">
			<Fragment slot="title">
				¿Qué problemas se trabajan en terapia de pareja?
			</Fragment>
		</SectionHeader>
		<ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
			{
				problems.map((problem, index) => (
					<li
						class="reveal-blur flex flex-col gap-3"
						data-reveal
						style={`--reveal: ${index}`}
					>
						<div class="flex items-center gap-4">
							<span class="grid size-10 shrink-0 place-items-center rounded-full bg-seafoam-soft text-xl text-teal">
								<Icon name={problem.icon} />
							</span>
							<span class="h-px flex-1 bg-line" aria-hidden="true" />
						</div>
						<h3 class="font-display text-lead font-normal text-ink">
							{problem.title}
						</h3>
						<p class="text-body text-ink-muted">{problem.text}</p>
					</li>
				))
			}
		</ul>
	</Section>

	<CtaBand
		id="contacto-reserva"
		label="Primera cita en pareja"
		title="Dar el paso juntos requiere valor, y no tenéis que hacerlo solos"
	>
		<p class="tabular-nums">
			Solicitad vuestra primera cita o escribidme si antes queréis resolver
			alguna duda. Sesión de 60 minutos · 75 €.
		</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" arrow>
				<span>{ctaLabel}</span>
			</Button>
			<Button href={`mailto:${email}`} variant="inverse-outline" icon="mail">
				<span>{email}</span>
			</Button>
		</Fragment>
	</CtaBand>
	<!-- Preguntas frecuentes -->
	<Section>
		<div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
			<SectionHeader
				title="Preguntas frecuentes sobre la terapia de pareja"
				layout="stack"
				size="large"
				class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start"
			>
				<p>
					Es normal tener dudas antes de empezar. Si la vuestra no está aquí,
					escribidme.
				</p>
			</SectionHeader>
			<Faq items={faqs} class="lg:col-span-7" />
		</div>
	</Section>

	<RelatedPosts service="/servicios/terapia-de-pareja/" />

	<OtherServices />
</Layout>
