---
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import Section from "../../components/ui/Section.astro";
import {
	address,
	addressCenter,
	contactHref,
	ctaLabel,
	ctaNote,
	onlineLink,
	services,
} from "../../data/site";
import Layout from "../../layouts/Layout.astro";

const title = "Servicios de psicoterapia en Pamplona y online | Inala";
const description =
	"Terapia individual, de pareja, familiar y psicología parental con María Sánchez, psicóloga general sanitaria. Sesiones de 60 minutos en Pamplona y online.";
---

<Layout title={title} description={description}>
	<PageHero title="Servicios">
		<p class="max-w-2xl text-lead text-ink-muted">
			Elige el tipo de acompañamiento que encaja con lo que estás viviendo:
			individual si es algo que te pasa a ti; de pareja si el malestar está en la
			relación; familiar si afecta a la convivencia de toda la casa; y psicología
			parental si buscas apoyo como madre o padre. Si no lo tienes claro,
			escríbeme y lo vemos juntos.
		</p>
	</PageHero>

	<Section tone="white" class="pt-4 lg:pt-6">
		<ul class="grid gap-x-12 border-b border-line md:grid-cols-2">
			{
				services.map((service) => (
					<li class="group relative flex flex-col gap-4 border-t border-line py-10 transition-[border-color] duration-200 hover:border-teal">
						<h2 class="font-display text-heading font-normal text-ink">
							<a
								href={service.href}
								class="transition-[color] duration-200 after:absolute after:inset-0 group-hover:text-teal"
							>
								{service.name}
							</a>
						</h2>
						<p class="max-w-md text-lead text-ink-muted">{service.summary}</p>
						<p class="mt-auto flex items-center gap-2 text-small font-semibold text-teal tabular-nums">
							{service.duration} · {service.price}
							<Icon
								name="arrow_forward"
								class="transition-[translate] duration-200 ease-out motion-safe:group-hover-fine:translate-x-1"
							/>
						</p>
					</li>
				))
			}
		</ul>
		<div
			class="mt-14 grid gap-x-12 gap-y-8 lg:grid-cols-12 lg:items-center"
		>
			<p class="text-lead text-ink-muted lg:col-span-7">
				Todas las sesiones pueden ser presenciales en {address} ({addressCenter},
				Pamplona) u online por videollamada.{" "}
				<a
					class="font-semibold text-teal underline underline-offset-4 transition-[color] duration-200 hover:text-teal-strong"
					href={onlineLink.href}>Cómo funciona la terapia online</a
				>.
			</p>
			<div class="flex flex-col items-start gap-3 lg:col-span-5 lg:items-end">
				<Button href={contactHref} arrow>{ctaLabel}</Button>
				<p class="text-small text-ink-muted">{ctaNote}</p>
			</div>
		</div>
	</Section>
</Layout>
