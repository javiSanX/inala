---
import {
	address,
	addressCenter,
	addressCity,
	contactHref,
	ctaLabel,
	ctaNote,
	email,
	licenseNumber,
	services,
	therapistName,
	whatsappUrl,
} from "../data/site";
import Layout from "../layouts/Layout.astro";

const title = "Psicóloga en Pamplona y online | INALA Centro de Psicoterapia";
const description =
	"Terapia psicológica para adultos, parejas y familias en Pamplona y online, con María Sánchez, psicóloga general sanitaria (Nº col. NA-02300). Sesiones de 60 minutos.";

const heroFacts = [
	{ icon: "location_on", title: "Pamplona y online", subtitle: "Tú eliges" },
	{ icon: "schedule", title: "Sesiones de 60 min", subtitle: "Desde 65 €" },
	{
		icon: "verified",
		title: `Nº col. ${licenseNumber}`,
		subtitle: "Psicóloga sanitaria",
	},
];

const differentiators = [
	{
		icon: "diversity_1",
		text: "Formación especializada en terapia familiar y de pareja.",
	},
	{
		icon: "child_care",
		text: "Formación en salud mental perinatal y experiencia con la infancia.",
	},
	{
		icon: "work",
		text: "Antes trabajé en la empresa: conozco de cerca el estrés y la autoexigencia.",
	},
];

const steps = [
	{
		icon: "chat",
		title: "Me escribes o me llamas",
		text: "Por el formulario, por WhatsApp o por correo. No hace falta que me cuentes mucho: con lo que te apetezca compartir es suficiente.",
	},
	{
		icon: "handshake",
		title: "Primera sesión para conocernos",
		text: "Hablamos de lo que te ha traído hasta aquí y definimos juntos los primeros objetivos.",
	},
	{
		icon: "spa",
		title: "Sesiones a tu ritmo",
		text: "Trabajamos con herramientas prácticas y revisamos cómo te sientes. Tú marcas el ritmo.",
	},
];

const areas = [
	{
		icon: "favorite",
		title: "Gestión emocional y autoestima",
		text: "Entender lo que sientes, tratarte con más amabilidad y dejar de vivir pendiente de la autocrítica.",
	},
	{
		icon: "air",
		title: "Ansiedad y estrés",
		text: "Manejar la tensión física, las preocupaciones constantes y los pensamientos que te bloquean.",
	},
	{
		icon: "light_mode",
		title: "Depresión y desánimo",
		text: "Comprender de dónde viene el malestar, recuperar la motivación y volver a encontrar sentido a tu día a día.",
	},
	{
		icon: "diversity_1",
		title: "Relaciones con los demás",
		text: "Comunicarte mejor, poner límites sin culpa y construir vínculos más seguros.",
	},
	{
		icon: "healing",
		title: "Duelo, pérdidas y experiencias difíciles",
		text: "Atravesar una pérdida o un cambio importante y recuperar la sensación de seguridad.",
	},
	{
		icon: "psychology",
		title: "Autoconocimiento",
		text: "Conocer tu historia, tus valores y lo que quieres, para vivir de forma más coherente contigo.",
	},
];
---

<Layout title={title} description={description}>
	<div class="flex flex-col w-full">
		<!-- Hero -->
		<section
			class="relative w-full overflow-hidden bg-linear-to-b from-surface via-surface-container-low to-surface pt-10 pb-20 lg:pt-16 lg:pb-32"
		>
			<div
				class="pointer-events-none absolute -top-24 -left-20 w-96 h-96 rounded-full bg-primary-fixed-dim/20 blur-3xl"
			>
			</div>
			<div
				class="pointer-events-none absolute top-1/3 -right-24 w-[30rem] h-[30rem] rounded-full bg-secondary-container/40 blur-3xl"
			>
			</div>
			<div
				class="max-w-[1240px] mx-auto px-margin-mobile lg:px-margin relative z-10"
			>
				<div
					class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg lg:gap-gutter items-center"
				>
					<div
						class="lg:col-span-7 flex flex-col items-start gap-space-sm lg:pr-6"
					>
						<p class="font-title-md text-title-md text-primary">
							Psicoterapia en Pamplona y online
						</p>
						<h1
							class="font-display-xl text-headline-lg lg:text-display-xl text-on-surface tracking-tight font-medium leading-tight text-balance"
						>
							Terapia psicológica para adultos, <span
								class="text-primary italic font-serif">parejas y familias</span
							>
						</h1>
						<p
							class="font-body-lg text-body-lg text-on-surface-variant max-w-xl leading-relaxed mt-2"
						>
							Soy {therapistName}, psicóloga general sanitaria (Nº col. {
								licenseNumber
							}). Acompaño a niños, adolescentes y adultos, a parejas, a familias y a
							madres y padres en la crianza, para entender lo que está pasando y
							encontrar herramientas para sentirse mejor, sin prisas.
						</p>
						<div class="flex flex-wrap items-center gap-4 mt-6">
							<a
								class="group inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-primary-container text-on-primary-container font-label-lg text-label-lg shadow-md hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 transition-[translate,box-shadow] duration-300"
								href={contactHref}
							>
								<span>{ctaLabel}</span>
								<span
									class="material-symbols-outlined text-[20px] transition-transform duration-300 group-hover:translate-x-1"
									aria-hidden="true">arrow_forward</span
								>
							</a>
							<a
								class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-surface-container-high text-on-surface-variant font-label-lg text-label-lg hover:bg-secondary-container hover:text-on-secondary-container hover:-translate-y-0.5 transition-[translate,background-color,color] duration-300 shadow-xs"
								href="/servicios"
							>
								<span>Ver servicios y tarifas</span>
							</a>
						</div>
						<ul class="flex flex-wrap items-center gap-x-6 gap-y-4 mt-8 pt-6">
							{
								heroFacts.map((fact) => (
									<li class="flex items-center gap-3">
										<div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary shadow-xs">
											<span
												class="material-symbols-outlined text-[20px]"
												aria-hidden="true"
											>
												{fact.icon}
											</span>
										</div>
										<div class="flex flex-col">
											<span class="font-title-md text-title-md text-on-surface leading-none">
												{fact.title}
											</span>
											<span class="font-body-sm text-body-sm text-slate-muted">
												{fact.subtitle}
											</span>
										</div>
									</li>
								))
							}
						</ul>
					</div>
					<div class="lg:col-span-5 relative flex justify-center lg:justify-end">
						<div
							class="relative w-full max-w-[460px] aspect-[4/5] rounded-3xl overflow-hidden shadow-xl bg-surface-container-low flex items-center justify-center p-3"
						>
							<img
								alt=""
								class="w-full h-full object-cover rounded-2xl"
								src="/inicio-hero.jpg"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Servicios -->
		<section
			class="w-full py-space-xl bg-surface"
			aria-labelledby="servicios-titulo"
		>
			<div class="max-w-[1240px] mx-auto px-margin-mobile lg:px-margin">
				<div class="max-w-2xl mb-12">
					<h2
						id="servicios-titulo"
						class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface font-medium tracking-tight"
					>
						¿En qué te puedo acompañar?
					</h2>
					<p
						class="font-body-md text-body-md text-on-surface-variant mt-3 leading-relaxed"
					>
						Todas las sesiones pueden ser en mi consulta de Pamplona o por
						videollamada.
					</p>
				</div>
				<ul class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
					{
						services.map((service) => (
							<li>
								<a
									href={service.href}
									class="group h-full p-8 rounded-2xl bg-surface-container-lowest border border-outline-variant/30 shadow-xs hover:shadow-xl hover:-translate-y-1 transition-[translate,box-shadow] duration-300 flex flex-col gap-4"
								>
									<div class="w-12 h-12 rounded-2xl bg-surface-container flex items-center justify-center text-primary">
										<span
											class="material-symbols-outlined text-[24px]"
											aria-hidden="true"
										>
											{service.icon}
										</span>
									</div>
									<h3 class="font-title-md text-title-md text-on-surface font-semibold group-hover:text-primary transition-colors">
										{service.name}
									</h3>
									<p class="font-body-md text-body-sm text-on-surface-variant leading-relaxed flex-1">
										{service.summary}
									</p>
									<p class="font-label-sm text-label-sm text-slate-muted">
										{service.duration} · {service.price}
									</p>
									<span class="inline-flex items-center gap-1.5 font-label-lg text-label-lg text-primary">
										Saber más
										<span
											class="material-symbols-outlined text-[18px] transition-transform duration-300 group-hover:translate-x-1"
											aria-hidden="true"
										>
											arrow_right_alt
										</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- Quién soy -->
		<section class="w-full py-space-xl bg-surface-container-low overflow-x-clip">
			<div class="max-w-[1240px] mx-auto px-margin-mobile lg:px-margin">
				<div
					class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
				>
					<div class="lg:col-span-5 relative flex justify-center">
						<div class="relative w-full max-w-[420px]">
							<div
								class="absolute -inset-4 rounded-3xl bg-secondary-container/50 transform -rotate-2"
							>
							</div>
							<div
								class="relative rounded-3xl overflow-hidden shadow-xl bg-surface-container"
							>
								<img
									alt="María Sánchez, psicóloga y fundadora de INALA, en su consulta de Pamplona."
									class="w-full h-auto object-cover"
									src="/maria1.webp"
									width="864"
									height="1184"
									loading="lazy"
								/>
							</div>
							<div
								class="absolute -bottom-6 -right-4 bg-surface-translucent backdrop-blur-md p-4 rounded-2xl shadow-lg flex items-center gap-3"
							>
								<div
									class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center"
								>
									<span
										class="material-symbols-outlined text-[20px]"
										aria-hidden="true">psychology_alt</span
									>
								</div>
								<div>
									<p
										class="font-title-md text-body-sm text-on-surface font-semibold"
									>
										Psicóloga general sanitaria
									</p>
									<p class="font-body-sm text-label-sm text-slate-muted">
										Nº col. {licenseNumber}
									</p>
								</div>
							</div>
						</div>
					</div>
					<div class="lg:col-span-7 flex flex-col items-start gap-space-sm">
						<h2
							class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface font-medium tracking-tight"
						>
							Hola, soy María
						</h2>
						<div
							class="space-y-4 text-on-surface-variant font-body-md text-body-md leading-relaxed mt-2"
						>
							<p>
								Fundé Inala para acompañar a personas, parejas y familias en
								los momentos complicados de la vida. Mi trabajo es crear un
								espacio en el que puedas hablar con libertad, sin sentirte
								juzgado/a.
							</p>
							<blockquote
								class="my-4 p-5 rounded-2xl bg-surface-container font-headline-md text-title-md text-primary italic leading-relaxed shadow-xs"
							>
								“Para mí, la terapia es mucho más que técnicas: es empatía,
								dedicación y presencia.”
							</blockquote>
						</div>
						<ul class="flex flex-col gap-3 mt-2">
							{
								differentiators.map((item) => (
									<li class="flex items-start gap-3 font-body-md text-body-md text-on-surface">
										<span
											class="material-symbols-outlined text-[20px] text-primary mt-0.5"
											aria-hidden="true"
										>
											{item.icon}
										</span>
										<span>{item.text}</span>
									</li>
								))
							}
						</ul>
						<div class="mt-6 flex flex-wrap items-center gap-4">
							<a
								class="inline-flex items-center gap-2 font-label-lg text-label-lg text-primary hover:text-on-surface transition-colors py-2"
								href="/sobre-mi"
							>
								<span>Conocer mi trayectoria</span>
								<span
									class="material-symbols-outlined text-[18px]"
									aria-hidden="true">arrow_right_alt</span
								>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Motivos de consulta -->
		<section class="w-full py-space-xl bg-surface">
			<div class="max-w-[1240px] mx-auto px-margin-mobile lg:px-margin">
				<div class="text-center max-w-3xl mx-auto mb-14">
					<h2
						class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface font-medium tracking-tight"
					>
						Motivos por los que la gente viene a consulta
					</h2>
					<p
						class="font-body-md text-body-md text-on-surface-variant mt-3 leading-relaxed"
					>
						No hace falta estar en una crisis para pedir ayuda. Estos son
						algunos de los temas que trabajo con más frecuencia.
					</p>
				</div>
				<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{
						areas.map((area) => (
							<li class="p-8 rounded-2xl bg-surface-container-low border border-outline-variant/30 flex flex-col gap-4">
								<div class="w-12 h-12 rounded-2xl bg-surface-container flex items-center justify-center text-primary">
									<span
										class="material-symbols-outlined text-[24px]"
										aria-hidden="true"
									>
										{area.icon}
									</span>
								</div>
								<h3 class="font-title-md text-title-md text-on-surface font-semibold">
									{area.title}
								</h3>
								<p class="font-body-md text-body-sm text-on-surface-variant leading-relaxed">
									{area.text}
								</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- Cómo empezar -->
		<section
			class="w-full py-space-xl bg-surface-container-low/40 relative overflow-hidden"
			id="proceso"
		>
			<div
				class="max-w-[1240px] mx-auto px-margin-mobile lg:px-margin relative z-10"
			>
				<div class="text-center max-w-2xl mx-auto mb-12">
					<h2
						class="font-headline-lg text-headline-md lg:text-headline-lg text-on-surface font-medium tracking-tight"
					>
						Cómo empezar
					</h2>
					<p
						class="font-body-md text-body-md text-on-surface-variant mt-3 leading-relaxed"
					>
						Primera sesión: 60 minutos · 65 € (pareja o familia: 75 €).
					</p>
				</div>
				<ol class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{
						steps.map((step) => (
							<li class="flex flex-col gap-3 p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/30">
								<span
									class="material-symbols-outlined text-[28px] text-primary"
									aria-hidden="true"
								>
									{step.icon}
								</span>
								<h3 class="font-headline-md text-headline-sm text-on-surface font-semibold tracking-tight">
									{step.title}
								</h3>
								<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
									{step.text}
								</p>
							</li>
						))
					}
				</ol>
				<div class="mt-10 text-center">
					<a
						class="inline-flex items-center gap-2 font-label-lg text-label-lg text-primary hover:text-on-surface transition-colors py-2"
						href="/nuestro-metodo"
					>
						<span>Conocer cómo trabajo</span>
						<span
							class="material-symbols-outlined text-[18px]"
							aria-hidden="true">arrow_right_alt</span
						>
					</a>
				</div>
			</div>
		</section>

		<!-- Presencial y online -->
		<section class="w-full py-space-xl bg-surface">
			<div
				class="max-w-[1240px] mx-auto px-margin-mobile lg:px-margin grid grid-cols-1 md:grid-cols-2 gap-6"
			>
				<div
					class="p-8 rounded-3xl bg-surface-container-low flex flex-col gap-3"
				>
					<span
						class="material-symbols-outlined text-[28px] text-primary"
						aria-hidden="true">location_on</span
					>
					<h2
						class="font-headline-md text-headline-sm text-on-surface font-semibold"
					>
						En Pamplona
					</h2>
					<p class="font-body-md text-body-md text-on-surface-variant">
						{address}, {addressCity}. Dentro del {addressCenter}, en una
						consulta tranquila y con luz natural.
					</p>
				</div>
				<div
					class="p-8 rounded-3xl bg-surface-container-low flex flex-col gap-3"
				>
					<span
						class="material-symbols-outlined text-[28px] text-primary"
						aria-hidden="true">videocam</span
					>
					<h2
						class="font-headline-md text-headline-sm text-on-surface font-semibold"
					>
						Online
					</h2>
					<p class="font-body-md text-body-md text-on-surface-variant">
						Por videollamada, a través de una plataforma segura y cifrada que
						cumple la normativa de protección de datos. Puedes combinarla con
						sesiones presenciales.
					</p>
					<a
						class="inline-flex items-center gap-2 font-label-lg text-label-lg text-primary hover:text-on-surface transition-colors py-2 mt-auto"
						href="/servicios/terapia-online"
					>
						<span>Saber más sobre la terapia online</span>
						<span
							class="material-symbols-outlined text-[18px]"
							aria-hidden="true">arrow_right_alt</span
						>
					</a>
				</div>
			</div>
		</section>

		<!-- Cita y CTA final -->
		<section
			class="w-full py-space-xl lg:py-28 bg-surface-container-low relative overflow-hidden"
		>
			<div
				class="max-w-[1240px] mx-auto px-margin-mobile lg:px-margin relative z-10 flex flex-col items-center"
			>
				<figure class="w-full max-w-3xl text-center">
					<blockquote>
						<p
							class="font-serif italic text-headline-md sm:text-headline-lg text-on-surface font-normal tracking-tight leading-tight text-balance"
						>
							“La salud mental es un viaje de crecimiento y descubrimiento, no
							un destino al que llegar.”
						</p>
					</blockquote>
					<figcaption class="mt-6 flex flex-col items-center gap-1.5">
						<cite
							class="not-italic font-title-md text-title-md text-primary font-semibold tracking-wide"
						>
							{therapistName}
						</cite>
						<span class="font-body-sm text-body-sm text-slate-muted">
							Psicóloga general sanitaria y fundadora de Inala
						</span>
					</figcaption>
				</figure>

				<div
					class="mt-14 w-full max-w-3xl rounded-3xl bg-surface-container-high p-8 lg:p-12 shadow-xl"
				>
					<div class="flex flex-col items-center gap-4 text-center">
						<h2
							class="font-headline-md text-headline-md text-on-surface font-semibold text-balance"
						>
							Cuando sientas que es el momento, aquí estoy
						</h2>
						<p class="font-body-lg text-body-lg text-on-surface-variant max-w-lg">
							Cuéntame brevemente qué buscas y te propongo una primera cita,
							en Pamplona u online.
						</p>
						<div
							class="flex flex-col sm:flex-row items-center gap-4 mt-4 w-full justify-center"
						>
							<a
								class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4 rounded-full bg-primary text-on-primary font-label-lg text-label-lg shadow-md hover:bg-on-primary-container hover:shadow-xl hover:-translate-y-0.5 transition-[translate,box-shadow,background-color] duration-300"
								href={contactHref}
							>
								{ctaLabel}
							</a>
							<a
								class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full bg-surface-container-lowest text-on-surface-variant font-label-lg text-label-lg shadow-xs hover:bg-surface-container transition-colors"
								href={whatsappUrl}
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
							>
								<span
									class="material-symbols-outlined text-[18px] mr-2 text-primary"
									aria-hidden="true">chat</span
								>
								<span>Escribir por WhatsApp</span>
							</a>
						</div>
						<p class="font-body-sm text-body-sm text-slate-muted">{ctaNote}</p>
						<a
							class="font-body-md text-body-md text-primary hover:text-on-surface transition-colors underline decoration-primary-container decoration-2 underline-offset-4"
							href={`mailto:${email}`}
						>
							Escribirme a {email}
						</a>
					</div>
				</div>
			</div>
		</section>
	</div>
</Layout>
