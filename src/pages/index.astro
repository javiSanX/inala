---
import heroImage from "../assets/images/hero_image5.jpeg";
import mariaImage from "../assets/images/maria1.webp";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import FactList from "../components/ui/FactList.astro";
import Figure from "../components/ui/Figure.astro";
import Icon from "../components/ui/Icon.astro";
import type { IconName } from "../components/ui/icons";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import {
	address,
	addressCenter,
	addressCity,
	contactHref,
	ctaLabel,
	ctaNote,
	email,
	licenseNumber,
	services,
	therapistName,
	whatsappUrl,
} from "../data/site";
import Layout from "../layouts/Layout.astro";

const title = "Psicóloga en Pamplona y online | INALA Centro de Psicoterapia";
const description =
	"Terapia psicológica para adultos, parejas y familias en Pamplona y online, con María Sánchez, psicóloga general sanitaria (Nº col. NA-02300). Sesiones de 60 minutos.";

const heroFacts = [
	{ icon: "location_on", title: "Pamplona y online", subtitle: "Tú eliges" },
	{ icon: "schedule", title: "Sesiones de 60 min", subtitle: "Desde 65 €" },
	{
		icon: "verified",
		title: `Nº col. ${licenseNumber}`,
		subtitle: "Psicóloga sanitaria",
	},
] as const;

const differentiators = [
	{
		icon: "diversity_1",
		text: "Formación especializada en terapia familiar y de pareja.",
	},
	{
		icon: "child_care",
		text: "Formación en salud mental perinatal y experiencia con la infancia.",
	},
	{
		icon: "work",
		text: "Antes trabajé en la empresa: conozco de cerca el estrés y la autoexigencia.",
	},
];

const steps: {
	icon?: string;
	title: string;
	text: string;
	keywords: string[];
}[] = [
	{
		icon: "chat",
		title: "Me escribes o me llamas",
		text: "Por el formulario, por WhatsApp o por correo. No hace falta que me cuentes mucho: con lo que te apetezca compartir es suficiente.",
		keywords: ["formulario", "WhatsApp", "correo", "suficiente"],
	},
	{
		icon: "handshake",
		title: "Primera sesión para conocernos",
		text: "Hablamos de lo que te ha traído hasta aquí y de lo que te gustaría cambiar, y definimos juntos los primeros objetivos.",
		keywords: ["lo que te ha traído hasta aquí", "primeros objetivos"],
	},
	{
		icon: "spa",
		title: "Sesiones a tu ritmo",
		text: "Trabajamos con herramientas prácticas y revisamos juntos cómo te sientes en cada etapa. Tú marcas el ritmo, sin prisas.",
		keywords: ["herramientas prácticas", "Tú marcas el ritmo"],
	},
];

const areas: { icon: IconName; title: string; text: string }[] = [
	{
		icon: "favorite",
		title: "Gestión emocional y autoestima",
		text: "Entender lo que sientes, tratarte con más amabilidad y dejar de vivir pendiente de la autocrítica.",
	},
	{
		icon: "air",
		title: "Ansiedad y estrés",
		text: "Manejar la tensión física, las preocupaciones constantes y los pensamientos que te bloquean.",
	},
	{
		icon: "light_mode",
		title: "Depresión y desánimo",
		text: "Comprender de dónde viene el malestar, recuperar la motivación y volver a encontrar sentido a tu día a día.",
	},
	{
		icon: "diversity_1",
		title: "Relaciones con los demás",
		text: "Comunicarte mejor, poner límites sin culpa y construir vínculos más seguros.",
	},
	{
		icon: "healing",
		title: "Duelo, pérdidas y experiencias difíciles",
		text: "Atravesar una pérdida o un cambio importante y recuperar la sensación de seguridad.",
	},
	{
		icon: "psychology",
		title: "Autoconocimiento",
		text: "Conocer tu historia, tus valores y lo que quieres, para vivir de forma más coherente contigo.",
	},
];

// Bento layout for the six topics: rows of 4+2, 2+4 and 3+3 columns on large screens.
const bentoCards = [
	{ span: "lg:col-span-4", surface: "bg-mist", featured: true },
	{ span: "lg:col-span-2", surface: "bg-paper", featured: false },
	{ span: "lg:col-span-2", surface: "bg-paper", featured: false },
	{ span: "lg:col-span-4", surface: "bg-mist", featured: true },
	{ span: "lg:col-span-3", surface: "bg-paper", featured: false },
	{ span: "lg:col-span-3", surface: "bg-paper", featured: false },
] as const;

// Splits a paragraph so its keywords can be highlighted without changing the text.
const withKeywords = (text: string, keywords: string[]) => {
	const pattern = new RegExp(`(${keywords.join("|")})`);
	return text
		.split(pattern)
		.filter(Boolean)
		.map((part) => ({ part, match: keywords.includes(part) }));
};

// Steps climb a staircase on large screens: row:column 1:1 and 1:2, 2:2 and 2:3, 3:3 and 3:4; all texts span two columns except the last.
const stepGrid = [
	{
		number: "lg:col-start-1 lg:row-start-1",
		text: "lg:col-span-2 lg:col-start-2 lg:row-start-1",
	},
	{
		number: "lg:col-start-2 lg:row-start-2",
		text: "lg:col-span-2 lg:col-start-3 lg:row-start-2",
	},
	{
		number: "lg:col-start-3 lg:row-start-3",
		text: "lg:col-start-4 lg:row-start-3",
	},
] as const;

// Closing quote, typed character by character: each one appears at `at` and the
// caret rests on it for `hold`, with a short pause after punctuation.
const quote =
	"“La salud mental es un viaje de crecimiento y descubrimiento, no un destino al que llegar.”";
const typeStep = 36;
const typePause = 280;
let typedAt = 0;
const quoteWords = quote.split(" ").map((word) =>
	[...word].map((char, index) => {
		const hold =
			(/[,.:;]/.test(char) ? typePause : typeStep) +
			(index === word.length - 1 ? typeStep : 0);
		const typed = { char, at: typedAt, hold };
		typedAt += hold;
		return typed;
	}),
);

const textLink =
	"group inline-flex min-h-11 items-center gap-2 text-small font-semibold text-teal underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color] duration-200 hover:text-teal-strong hover:decoration-current";
const arrow =
	"transition-[translate] duration-200 ease-out motion-safe:group-hover-fine:translate-x-0.5";
---

<Layout title={title} description={description}>
	<PageHero size="display" accent backgroundImage={heroImage}>
		<p
			slot="eyebrow"
			class="inline-flex items-center gap-2 rounded-field border border-teal/25 bg-mist px-4 py-2 text-small font-medium text-teal-strong"
		>
			<Icon name="info" />
			Psicoterapia en Pamplona y online
		</p>
		<Fragment slot="title">
			Terapia psicológica <span>adaptada a cada situación</span>
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Soy {therapistName}, psicóloga general sanitaria (Nº col. {
				licenseNumber
			}). Acompaño a niños, adolescentes y adultos, a parejas, a familias y a
			madres y padres en la crianza, para entender lo que está pasando y
			encontrar herramientas para sentirse mejor, sin prisas.
		</p>
		<div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
			<Button href={contactHref} arrow>{ctaLabel}</Button>
			<Button href="/servicios" variant="secondary"
				>Ver servicios y tarifas</Button
			>
		</div>
		<FactList facts={[...heroFacts]} class="mt-4" />
	</PageHero>

	<!-- Servicios -->
	<Section tone="white" aria-labelledby="servicios-titulo">
		<SectionHeader
			title="¿En qué te puedo acompañar?"
			id="servicios-titulo"
		/>
		<ul class="mt-14 grid gap-x-10 md:grid-cols-2 xl:grid-cols-4">
			{
				services.map((service) => (
					<li>
						<a
							href={service.href}
							class="group flex h-full flex-col gap-4 border-t border-line py-8 transition-[border-color] duration-200 hover:border-teal"
						>
							<span class="grid size-12 shrink-0 place-items-center rounded-full bg-mist text-2xl text-teal">
								<Icon name={service.icon} />
							</span>
							<h3 class="font-display text-subheading font-normal text-ink transition-[color] duration-200 group-hover:text-teal">
								{service.name}
							</h3>
							<p class="flex-1 text-body text-ink-muted">
								{service.summary}
							</p>

							<span class="inline-flex items-center gap-2 text-small font-semibold text-teal">
								Saber más
								<Icon name="arrow_forward" class={arrow} />
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</Section>

	<!-- Quién soy -->
	<Section>
		<div class="grid gap-x-16 gap-y-12 lg:grid-cols-12 lg:items-center">
			<Figure
				src={mariaImage}
				alt="María Sánchez, psicóloga y fundadora de INALA, en su consulta de Pamplona."
				ratio="portrait"
				class="reveal-unveil lg:col-span-5"
			>
				<Icon name="verified" class="text-teal" />
				<span>
					<span class="font-semibold text-ink"
						>Psicóloga general sanitaria</span
					>
					<span class="block">Nº col. {licenseNumber}</span>
				</span>
			</Figure>
			<!-- Text blocks rise one after another, starting just after the portrait unveils. -->
			<div class="flex flex-col gap-6 lg:col-span-7">
				<h2
					data-reveal
					style="--reveal: 2"
					class="font-display text-heading font-normal text-ink"
				>
					Hola, soy María
				</h2>
				<p data-reveal style="--reveal: 3" class="text-lead text-ink-muted">
					Fundé Inala para acompañar a personas, parejas y familias en los
					momentos complicados de la vida. Mi trabajo es crear un espacio
					en el que puedas hablar con libertad, sin sentirte juzgado/a.
				</p>
				<blockquote
					data-reveal
					style="--reveal: 4"
					class="border-l border-seafoam pl-6 font-display text-subheading font-normal text-teal"
				>
					“Para mí, la terapia es mucho más que técnicas: es empatía,
					dedicación y presencia.”
				</blockquote>
				<ul class="flex flex-col gap-3">
					{
						differentiators.map((item, index) => (
							<li
								data-reveal
								style={`--reveal: ${index + 5}`}
								class="flex items-start gap-3 text-body text-ink"
							>
								<Icon name="check" class="mt-0.5 text-teal" />
								<span>{item.text}</span>
							</li>
						))
					}
				</ul>
				<a
					data-reveal
					style={`--reveal: ${differentiators.length + 5}`}
					class={textLink}
					href="/sobre-mi"
				>
					<span>Conocer mi trayectoria</span>
					<Icon name="arrow_forward" class={arrow} />
				</a>
			</div>
		</div>
	</Section>

	<!-- Motivos de consulta -->
	<Section tone="white" class="overflow-x-clip">
		<SectionHeader title="Motivos por los que la gente viene a consulta">
			<p
				class="flex items-start gap-3 rounded-field border border-teal/25 bg-mist p-5 text-body text-teal-strong"
			>
				<Icon name="info" class="mt-0.5 text-xl" />
				<span>
					No hace falta estar en una crisis para pedir ayuda. Estos son
					algunos de los temas que trabajo con más frecuencia.
				</span>
			</p>
		</SectionHeader>
		<ul
			data-bento
			class="relative mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-6 lg:gap-5"
		>
			{
				areas.map((area, index) => (
					<li
						class:list={[
							"flex flex-col gap-5 rounded-frame border border-line p-7 lg:p-8",
							bentoCards[index].span,
							bentoCards[index].surface,
						]}
					>
						<div class="flex items-center gap-4">
							<span
								class:list={[
									"grid size-12 shrink-0 place-items-center rounded-full text-2xl text-teal",
									bentoCards[index].featured ? "bg-white" : "bg-mist",
								]}
							>
								<Icon name={area.icon} />
							</span>
							<h3
								class:list={[
									"text-ink",
									bentoCards[index].featured
										? "font-display text-subheading font-normal"
										: "text-lead font-semibold",
								]}
							>
								{area.title}
							</h3>
						</div>
						<p class="text-body text-ink-muted">{area.text}</p>
					</li>
				))
			}
		</ul>
	</Section>

	<!-- Cómo empezar -->
	<Section id="proceso">
		<SectionHeader title="Cómo empezar" />
		<ol
			class="mt-14 flex flex-col gap-10 lg:grid lg:grid-cols-4 lg:grid-rows-3 lg:gap-x-10 lg:gap-y-0"
		>
			{
				steps.map((step, index) => (
					<li class="flex gap-6 border-t border-line pt-6 lg:contents">
						<span
							data-reveal
							style={`--reveal: ${index * 2}`}
							class:list={[
								"font-display text-display leading-none text-teal tabular-nums lg:border-t lg:border-line lg:pt-6",
								stepGrid[index].number,
							]}
							aria-hidden="true"
						>
							{String(index + 1).padStart(2, "0")}
						</span>
						<div
							data-reveal
							style={`--reveal: ${index * 2 + 1}`}
							class:list={[
								"flex flex-col gap-2.5 lg:border-t lg:border-line lg:pt-6",
								stepGrid[index].text,
							]}
						>
							<h3 class="text-lead font-semibold text-ink">
								{step.title}
							</h3>
							<p class="text-body text-ink-muted">
								{withKeywords(step.text, step.keywords).map(
									({ part, match }) =>
										match ? (
											<span class="font-semibold text-teal">
												{part}
											</span>
										) : (
											part
										),
								)}
							</p>
						</div>
					</li>
				))
			}
		</ol>
		<a class:list={[textLink, "mt-6"]} href="/nuestro-metodo">
			<span>Conocer cómo trabajo</span>
			<Icon name="arrow_forward" class={arrow} />
		</a>
	</Section>

	<!-- Presencial y online -->
	<Section tone="mist" space="tight">
		<div
			class="grid gap-y-10 md:grid-cols-2 md:divide-x md:divide-line-strong"
		>
			<div class="flex flex-col gap-3 md:pr-12">
				<Icon name="location_on" class="size-7 text-teal" />
				<h2 class="font-display text-subheading font-normal text-ink">
					En Pamplona
				</h2>
				<p class="text-body text-ink-muted">
					{address}, {addressCity}. Dentro del {addressCenter}, en una
					consulta tranquila y con luz natural.
				</p>
			</div>
			<div class="flex flex-col gap-3 md:pl-12">
				<Icon name="videocam" class="size-7 text-teal" />
				<h2 class="font-display text-subheading font-normal text-ink">
					Online
				</h2>
				<p class="text-body text-ink-muted">
					Por videollamada, a través de una plataforma segura y cifrada que
					cumple la normativa de protección de datos. Puedes combinarla con
					sesiones presenciales.
				</p>
				<a class={textLink} href="/servicios/terapia-online">
					<span>Saber más sobre la terapia online</span>
					<Icon name="arrow_forward" class={arrow} />
				</a>
			</div>
		</div>
	</Section>

	<CtaBand tone="light" title="Cuando sientas que es el momento, aquí estoy">
		<p>
			Cuéntame brevemente qué buscas y te propongo una primera cita, en
			Pamplona u online.
		</p>
		<Fragment slot="actions">
			<Button href={contactHref}>{ctaLabel}</Button>
			<Button
				href={whatsappUrl}
				variant="secondary"
				icon="chat"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
			>
				<span>Escribir por WhatsApp</span>
			</Button>
		</Fragment>
		<Fragment slot="note">
			<p>{ctaNote}</p>
			
		</Fragment>
		<!-- Cita: closes the band, typed in when it scrolls into view. -->
		<Fragment slot="quote">
			<figure class="flex flex-col items-center gap-8 text-center">
				<blockquote>
					<p
						data-reveal
						class="typewriter font-display text-heading leading-snug font-normal text-ink"
					>
						<span class="sr-only">{quote}</span>
						<span aria-hidden="true">
							{
								quoteWords.map((word, index) => (
									<>
										{index > 0 && " "}
										<span class="whitespace-nowrap">
											{word.map(({ char, at, hold }) => (
												<span
													class="typewriter-char"
													style={`--at: ${at}ms; --hold: ${hold}ms`}
												>
													{char}
												</span>
											))}
										</span>
									</>
								))
							}
						</span>
					</p>
				</blockquote>
			</figure>
		</Fragment>
	</CtaBand>
</Layout>

<script>
	import "../scripts/bento";
</script>
