---
// Home Page
// ------------
// Description: The home page is a page that displays the most important information.

// Components
// - Layout
import Layout from '../layouts/Layout.astro';
// - Blocks
import Blog from '../components/blocks/blog/PostsSlider.astro';
import Hero from '../components/blocks/hero/MediaHeroCTA.astro';
import Services from '../components/blocks/services/ServicesBasic.astro';
import BrandSlider from '../components/blocks/slider/BrandSlider.astro';
import Statistics from '../components/blocks/stats/Statistics.astro';
import Testimonials from '../components/blocks/testimonials/TestimonialsBasic.astro';
import Video from '../components/blocks/video/VideoSection.astro';
import Work from '../components/blocks/work/WorkBasic.astro';

// Content
// - SEO
const SEO = {
   title: 'Inala | Psicología general sanitaria en Pamplona',
   description:
      'Inala es un centro de psicología general sanitaria que ofrece servicios de terapia y apoyo psicológico.',
};
// - Hero
const hero = {
   // title: 'We design like we mean it.',
   title: 'Salud mentalen Pamplona',
   text: 'Inala es un centro de psicología general sanitaria que ofrece servicios de terapia y apoyo psicológico.',
};
---

<Layout title={SEO.title} description={SEO.description}>
   <Hero title={hero.title} text={hero.text} />
   <Video />
   <Statistics />
   <Services />
   <BrandSlider />
   <Work />
   <Testimonials />
   <Blog />
</Layout>
