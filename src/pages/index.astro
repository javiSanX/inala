---
// Home Page
// ------------
// Description: The home page is a page that displays the most important information.

// Components
// - Layout
import Layout from '../layouts/Layout.astro';
// - Blocks
import PasosTerapia from '../components/custom/PasosTerapia.astro';
import Frases from '../components/custom/Frases.astro';
import Hero from '../components/custom/Hero.astro';
import JoinBox from '../components/custom/JoinBox.astro';
import Servicios from '../components/custom/Servicios.astro';
import SobreInala from '../components/custom/SobreInala.astro';
import VideoSection from '../components/custom/VideoSection.astro';
// Content
// - SEO
const SEO = {
   title: 'Inala | Psicología general sanitaria en Pamplona',
   description:
      'Inala es un centro de psicología general sanitaria que ofrece servicios de terapia y apoyo psicológico.',
};
---

<Layout title={SEO.title} description={SEO.description}>
   <Hero
      title="Salud mental en Pamplona"
      text="Inala es un centro de psicoterapia general sanitaria, te acompaño en tu proceso terapéutico."
   />
   <Servicios />
   <JoinBox
      title="Realiza ahora tu primera consulta psicológica"
      subtitle=" Te apoyamos como necesitas, brindándote un espacio seguro y libre de juicios."
      buttonText="Reserva tu cita"
   />
   <SobreInala />
   <Frases
      title="Te acompañamos a descubrir tu fuerza interior"
      text="Te acompañamos en cada paso para que avances hacia el bienestar pleno que mereces, brindándote apoyo y herramientas para tu crecimiento personal."
   />
   <PasosTerapia />
   <JoinBox
      title="Da el primer paso hacia tu bienestar."
      subtitle="Empieza hoy tu proceso de cambio y recibe el apoyo profesional que necesitas para cuidar tu salud emocional."
      buttonText="Reserva tu cita"
   />
   <!-- <Testimonios /> -->
   <VideoSection video="https://oxygenna-themes.b-cdn.net/toki-astro/videos/about-us-video.mp4" />
   <Frases title="La salud mental es un viaje de crecimiento y descubrimiento, no un destino al que llegar." text="Un camino hacia el bienestar emocional" type="block" />
</Layout>
