---
// Home Page
// ------------
// Description: The home page is a page that displays the most important information.

// Components
// - Layout
import Layout from '../layouts/Layout.astro';
// - Blocks
import A from '../components/custom/A.astro';
import B from '../components/custom/B.astro';
import Faq from '../components/custom/Faq.astro';
import Frases from '../components/custom/Frases.astro';
import Hero from '../components/custom/Hero.astro';
import JoinBox from '../components/custom/JoinBox.astro';
import Servicios from '../components/custom/Servicios.astro';
import Testimonios from '../components/custom/Testimonios.astro';
// Content
// - SEO
const SEO = {
   title: 'Inala | Psicología general sanitaria en Pamplona',
   description:
      'Inala es un centro de psicología general sanitaria que ofrece servicios de terapia y apoyo psicológico.',
};
// - Hero
const hero = {
   // title: 'We design like we mean it.',
   title: 'Salud mentalen Pamplona',
   // text: 'Inala es un centro de psicología general sanitaria que ofrece servicios de terapia y apoyo psicológico.',
   text: 'Inala es un centro de psicología general sanitaria, un lugar para cuidarte y sanar.',
};
---

<Layout title={SEO.title} description={SEO.description}>
   <Hero title={hero.title} text={hero.text} />
   <Servicios />
   <JoinBox />
   <A />
   <Frases text="Inala te acompaña a descubrir tu fuerza interior y avanzar hacia el bienestar que mereces." />
   <B />
   <Frases text="La salud mental es un viaje, no un destino." type='none'/>
   <!-- <Testimonios /> -->
   <JoinBox />
   <Faq />
</Layout>
