const areas = [
	{
		icon: "favorite",
		title: "Gestión emocional, autoestima y autoconfianza",
		text: "Aprender a identificar, comprender y regular las emociones. Fortalecer la relación contigo mismo/a, desarrollar una imagen más realista y amable, superando la autocrítica.",
		tag: "Bienestar intra-personal",
	},
	{
		icon: "air",
		title: "Ansiedad y estrés",
		text: "Reducir dicha sintomatología física, junto con aquellas preocupaciones, pensamientos y creencias no funcionales.",
		tag: "Regulación y serenidad",
	},
	{
		icon: "light_mode",
		title: "Depresión y desánimo",
		text: "Comprender las causas del malestar emocional, recuperar la motivación y reconstruir el sentido vital.",
		tag: "Reconexión vital",
	},
	{
		icon: "diversity_1",
		title: "Relaciones interpersonales",
		text: "Mejorar la comunicación, establecer límites saludables y cultivar vínculos más seguros y equilibrados.",
		tag: "Vínculos conscientes",
	},
	{
		icon: "healing",
		title: "Duelos y pérdidas. Traumas y experiencias difíciles",
		text: "Acompañar en el proceso de aceptación y adaptación ante pérdidas o cambios significativos, integrando el dolor. Reconstruir la sensación de seguridad y confianza en ti mismo/a.",
		tag: "Sanación e integración",
	},
	{
		icon: "psychology",
		title: "Autoconocimiento y crecimiento personal",
