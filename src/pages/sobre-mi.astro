---
import consultaImage from "../assets/images/maria1.webp";
import portraitImage from "../assets/images/maria2.webp";
import purposeImage from "../assets/images/maria3.webp";
import vocationImage from "../assets/images/maria4.webp";
import beginningsImage from "../assets/images/maria5.webp";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Figure from "../components/ui/Figure.astro";
import Icon from "../components/ui/Icon.astro";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import TopicList from "../components/ui/TopicList.astro";
import {
	addressCenter,
	contactHref,
	ctaLabel,
	ctaNote,
	email,
	instagramUrl,
	licenseNumber,
} from "../data/site";
import Layout from "../layouts/Layout.astro";

const title =
	"Sobre mí | María Sánchez, psicóloga sanitaria en Pamplona y online · Nº col. NA-02300";

const description =
	"Conoce a María Sánchez, psicóloga general sanitaria con formación en terapia familiar y de pareja y en salud mental perinatal. Un acompañamiento cercano e integrador, en Pamplona y online.";

// Credentials and story come from the existing site content on main.

const story = [
	{
		image: beginningsImage,
		alt: "María Sánchez sonriendo, de pie, con chaqueta azul marino y blusa blanca.",
		tagIcon: "psychology_alt",
		tag: "Antes, en la empresa",
		icon: "work",
		label: "01. Inicios",
		title: "Mis inicios",
		text: "Mi camino profesional comenzó en el mundo empresarial, donde aprendí a trabajar bajo presión y en entornos competitivos. Esa experiencia me permitió comprender cómo el estrés y la autoexigencia afectan tanto al rendimiento laboral como al bienestar personal y a las relaciones. Hoy, esa vivencia enriquece mi manera de acompañar, aportando una mirada más amplia, empática y real sobre los desafíos que enfrentan muchas personas en su día a día.",
	},
	{
		image: vocationImage,
		alt: "María Sánchez sonriendo, de pie, con traje verde salvia y camiseta gris.",
		tagIcon: "center_focus_strong",
		tag: "Psicología clínica y sanitaria",
		icon: "psychology",
		label: "02. Vocación",
		title: "Mi vocación",
		text: "Pronto descubrí que mi verdadero interés estaba en las emociones, las relaciones y la forma en que nos vinculamos con los demás, lo que me llevó a estudiar Psicología, graduarme con mención en clínica y realizar el Máster General Sanitario. Acompañar a personas en su salud mental me ha enseñado el valor de comprender los procesos de enfermedad, duelo y la influencia que tiene todo ello en el entorno más cercano de la persona que lo padece.",
	},
	{
		image: purposeImage,
		alt: "María Sánchez sonriendo, de pie ante una pared blanca, con chaleco negro y blusa blanca.",
		tagIcon: "volunteer_activism",
		tag: "Familia, pareja e infancia",
		icon: "favorite",
		label: "03. Propósito",
		title: "Mi propósito",
		text: "Mi propio proceso personal me permitió ver con claridad cómo la familia y el entorno en el que crecemos influyen profundamente en nuestro desarrollo y manera de relacionarnos. Esta comprensión me llevó a especializarme en terapia familiar y de pareja, y a trabajar en el ámbito de la desprotección infantil, acompañando procesos de trauma complejo y duelo en la primera infancia, reforzando mi compromiso con un acompañamiento respetuoso y humano.",
	},
];

// Only training confirmed in the existing content; institutions are pending.
const training = [
	{
		title: "Grado en Psicología, mención en Psicología Clínica",
		place: "[PENDIENTE: universidad]",
		text: "Formación de base en psicología con itinerario clínico.",
	},
	{
		title: "Máster en Psicología General Sanitaria",
		place: "[PENDIENTE: universidad o centro]",
		text: "Habilitación para el ejercicio de la psicología sanitaria.",
	},
	{
		title: "Especialización en Terapia Familiar y de Pareja",
		place: "[PENDIENTE: centro de formación]",
		text: "Formación específica para acompañar a parejas y a familias.",
	},
	{
		title: "Experiencia en desprotección infantil",
		text: "Acompañamiento de procesos de trauma complejo y duelo en la primera infancia.",
	},
	{
		title: "Formación en Salud Mental Perinatal",
		place: "[PENDIENTE: centro de formación]",
		text: "Acompañamiento de los procesos vitales que acompañan la maternidad y la crianza.",
	},
];

const spaceFeatures = [
	{ icon: "wb_sunny", label: "Luz natural" },
	{ icon: "chair", label: "Un espacio tranquilo y cómodo" },
	{ icon: "lock", label: "Secreto profesional" },
	{ icon: "location_on", label: `En el ${addressCenter}` },
];

const sessionSteps = [
	{
		icon: "hearing",
		title: "Escucha activa real",
		text: "Sin prisas, interrupciones ni diagnósticos apresurados. Escucho tu historia con atención y respeto.",
		tag: "Un espacio para ti",
	},
	{
		icon: "explore",
		title: "Claridad y dirección",
		text: "Te explicaré en qué punto estamos, qué estamos trabajando y hacia dónde vamos.",
		tag: "Transparencia activa",
	},
	{
		icon: "build_circle",
		title: "Herramientas aplicables",
		text: "No nos quedamos en la teoría: trabajaremos recursos prácticos que puedas usar en tu día a día.",
		tag: "Autonomía vital",
	},
	{
		icon: "hourglass_empty",
		title: "Respeto a tus tiempos",
		text: "Jamás te forzaré a abrir recuerdos o heridas para los que tu sistema nervioso aún no esté preparado. Caminamos a tu velocidad.",
		tag: "Seguridad primero",
	},
];
---

<Layout title={title} description={description}>
	<PageHero>
		<Fragment slot="title">
			Hola, soy María.<br />
			<span>Te acompaño a entender lo que te pasa</span> con calma y sin juicios.
		</Fragment>
		<p class="max-w-xl text-lead text-ink-muted">
			Psicóloga general sanitaria, con consulta en Pamplona y online. Trabajo con
			un enfoque integrador y basado en la evidencia, y sobre todo cercano: para
			que puedas comprender lo que te pasa y avanzar a tu ritmo.
		</p>
		<div>
			<span
				class="inline-flex min-h-9 items-center gap-2 rounded-full border border-line-strong px-4 text-label font-semibold text-ink tabular-nums"
			>
				<Icon name="verified" class="text-teal" />
				<span>Nº col. {licenseNumber}</span>
			</span>
		</div>
		<div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
			<Button href={contactHref} arrow>
				<span>{ctaLabel}</span>
			</Button>
			<Button
				href={instagramUrl}
				variant="secondary"
				icon="photo_camera"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Instagram de Inala Psicoterapia (se abre en una pestaña nueva)"
			>
				<span>@inala_psicoterapia</span>
			</Button>
		</div>
		<div slot="media">
			<Figure
				src={portraitImage}
				alt="María Sánchez, psicóloga sanitaria y fundadora de Inala, sentada en un sillón azul."
				ratio="portrait"
				priority
				sizes="(min-width: 1024px) 34vw, 100vw"
			>
				<span class="flex flex-1 flex-wrap items-center justify-between gap-x-4 gap-y-1">
					<span>
						<span class="block font-semibold text-ink">María Sánchez</span>
						<span class="block">Psicóloga general sanitaria · Fundadora</span>
					</span>
					<span class="inline-flex items-center gap-1.5 font-semibold text-teal">
						<Icon name="location_on" />
						<span>Pamplona y online</span>
					</span>
				</span>
			</Figure>
		</div>
	</PageHero>

	<!-- Historia -->
	<Section tone="white" id="historia-y-recorrido">
		<SectionHeader
			title="Mi camino hacia la psicología: vocación, experiencia y propósito"
			label="Conoce mi historia"
		>
			<p>Así llegué a la psicología y esto es lo que traigo a cada sesión.</p>
		</SectionHeader>
		<ol class="mt-16 flex flex-col gap-20 lg:gap-28">
			{
				story.map((chapter, index) => (
					<li class="grid gap-x-16 gap-y-8 lg:grid-cols-12 lg:items-center">
						<Figure
							src={chapter.image}
							alt={chapter.alt}
							ratio="tall"
							sizes="(min-width: 1024px) 34vw, 100vw"
							class:list={[
								"lg:col-span-4",
								index % 2 === 1 && "lg:order-2 lg:col-start-9",
							]}
						>
							<span class="font-semibold text-ink">{chapter.tag}</span>
						</Figure>
						<div
							class:list={[
								"flex flex-col gap-4",
								index % 2 === 1
									? "lg:order-1 lg:col-span-8 lg:col-start-1"
									: "lg:col-span-8 lg:col-start-5",
							]}
						>
							<div class="flex flex-col gap-3 sm:flex-row sm:gap-8">
								<span class="shrink-0 whitespace-nowrap font-display text-lead text-teal sm:w-36 sm:pt-3">
									{chapter.label}
								</span>
								<div class="flex flex-col gap-4">
									<h3 class="font-display text-heading font-normal text-ink">
										{chapter.title}
									</h3>
									<p class="text-lead text-ink-muted">{chapter.text}</p>
								</div>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</Section>

	<!-- Formación -->
	<Section>
		<div class="grid gap-x-16 gap-y-12 lg:grid-cols-12">
			<div class="flex flex-col gap-8 lg:col-span-5">
				<SectionHeader title="Mi formación" label="Mi trayectoria" layout="stack">
					<p>
						Entiendo la psicoterapia como un compromiso ético que exige seguir
						formándose. Esta es la formación que respalda mi trabajo.
					</p>
				</SectionHeader>
				<div class="flex flex-col gap-2 border-t border-line pt-6">
					<span class="inline-flex items-center gap-2 text-small font-semibold text-ink">
						<Icon name="info" class="text-teal" />
						Registro de centro sanitario
					</span>
					<p class="text-small text-ink-muted">
						[PENDIENTE: datos de inscripción del centro en el registro de centros
						sanitarios]
					</p>
				</div>
			</div>
			<div class="lg:col-span-7">
				<h3 class="font-display text-subheading font-normal text-ink">
					Formación y experiencia
				</h3>
				<ul class="mt-6">
					{
						training.map((item) => (
							<li class="flex flex-col gap-1.5 border-t border-line py-6">
								<h4 class="text-lead font-semibold text-ink">{item.title}</h4>
								{item.place && (
									<p class="text-label font-semibold text-ink-soft">{item.place}</p>
								)}
								<p class="text-body text-ink-muted">{item.text}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</Section>

	<!-- La consulta -->
	<Section tone="mist">
		<div class="grid gap-x-16 gap-y-12 lg:grid-cols-12 lg:items-center">
			<Figure
				src={consultaImage}
				alt="María sentada en su consulta junto a una planta y una mesa auxiliar con una taza."
				ratio="landscape"
				sizes="(min-width: 1024px) 45vw, 100vw"
				class="lg:col-span-6"
			>
				<Icon name="location_on" class="text-teal" />
				<span>C/ María Lacunza 6, portal 4, Pamplona</span>
			</Figure>
			<div class="flex flex-col gap-6 lg:col-span-6">
				<SectionHeader title="La consulta" label="El espacio" layout="stack">
					<p>
						Una consulta tranquila y con luz natural, en el {addressCenter}
						(Pamplona). Si te resulta más cómodo, también podemos vernos por
						videollamada.
					</p>
				</SectionHeader>
				<ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
					{
						spaceFeatures.map((feature) => (
							<li class="flex items-center gap-3 text-body text-ink">
								<Icon name="check" class="text-teal" />
								<span>{feature.label}</span>
							</li>
						))
					}
				</ul>
				<div class="flex flex-wrap gap-2">
					<span
						class="inline-flex min-h-9 items-center rounded-full bg-white px-4 text-label font-semibold text-ink"
					>
						Presencial en Pamplona
					</span>
					<span
						class="inline-flex min-h-9 items-center rounded-full bg-white px-4 text-label font-semibold text-ink"
					>
						Online
					</span>
				</div>
			</div>
		</div>
	</Section>

	<!-- Qué esperar -->
	<Section tone="white">
		<SectionHeader
			title="¿Qué puedes esperar en sesión conmigo?"
			label="Cómo trabajamos juntos"
		>
			<p>
				La psicoterapia no es un monólogo ni un proceso misterioso. Es una
				conversación en la que trabajamos juntas o juntos, con objetivos claros.
			</p>
		</SectionHeader>
		<TopicList
			items={sessionSteps.map((step) => ({ ...step, note: step.tag }))}
			columns={2}
			class="mt-14 lg:grid-cols-4"
		/>
	</Section>

	<CtaBand id="contacto" label="Comienza hoy tu cuidado" title="¿Damos el primer paso juntos?">
		<p>
			Si sientes que ha llegado el momento de cuidarte, estaré encantada de
			acompañarte. Solicita tu primera cita o escríbeme si tienes cualquier duda
			antes de empezar.
		</p>
		<p class="text-small">{ctaNote}</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse" icon="calendar_today">
				<span>{ctaLabel}</span>
			</Button>
			<Button href={`mailto:${email}`} variant="inverse-outline" icon="mail">
				<span>Escríbeme a {email}</span>
			</Button>
		</Fragment>
	</CtaBand>
</Layout>
