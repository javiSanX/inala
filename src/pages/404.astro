---
import Accion from "../components/Accion.astro";
import Flecha from "../components/Flecha.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Página no encontrada | Inala Psicoterapia"
	description="La página que buscas no existe o ha cambiado de dirección. Puedes volver al inicio o visitar nuestras páginas principales."
	noindex
>
	<section>
		<div class="shell grid min-h-[70dvh] content-center gap-10 py-20">
			<Flecha class="w-32 text-camino sm:w-44" direction="left" />
			<h1 class="text-display font-extrabold">Ups! <br />Esta pagina no existe</h1>
			<p class="max-w-[52ch] text-lead text-tinta-suave">
				Parece que nos hemos perdido en el camino y no hemos encontrado la página
				que buscabas. ¡No te preocupes! Vamos a volver al sendero principal
				juntos.
			</p>
			<div>
				<Accion href="/" size="lg" variant="camino">Volver al inicio</Accion>
			</div>
		</div>
	</section>
</Layout>
