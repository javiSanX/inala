---
import {
	contactHref,
	ctaLabel,
	ctaNote,
	email,
	services,
} from "../data/site";
import Layout from "../layouts/Layout.astro";

const title = "Tarifas | Terapia psicológica en Pamplona y online · Inala";
const description =
	"Tarifas y duración de las sesiones: terapia individual 65 €, de pareja o familiar 75 €. Sesiones de 60 minutos en Pamplona u online por videollamada, sin cuotas ni permanencias.";

const serviceByName = (name: string) => {
	const service = services.find((item) => item.name === name);
	if (!service) throw new Error(`Unknown service: ${name}`);
	return service;
};

const individual = serviceByName("Terapia Individual");
const couple = serviceByName("Terapia de Pareja");
const family = serviceByName("Terapia Familiar");
const parental = serviceByName("Psicología Parental");

// Prices and durations come from `services` (site.ts), which mirrors main.
const plans = [
	{
		title: individual.name,
		summary: individual.summary,
		price: individual.price,
		duration: individual.duration,
		modality: "Presencial en Pamplona u online",
		bullets: [
			"Para adultos, adolescentes y niños",
			"Ansiedad, desánimo, autoestima, duelo o cambios vitales",
			"Herramientas prácticas para tu día a día",
		],
		href: individual.href,
	},
	{
		title: couple.name,
		summary: couple.summary,
		price: couple.price,
		duration: couple.duration,
		modality: "Presencial en Pamplona u online",
		bullets: [
			"Un espacio neutral: no tomo partido",
			"Comunicación y discusiones que se repiten",
			"Distanciamiento, confianza e intimidad",
		],
		href: couple.href,
	},
	{
		title: family.name,
		summary: family.summary,
		price: family.price,
		duration: family.duration,
		modality: "Presencial en Pamplona u online",
		bullets: [
			"Un espacio donde se escucha a todos",
			"Comunicación y límites en la convivencia",
			"Cambios de etapa, separaciones y pérdidas",
		],
		href: family.href,
	},
	{
		title: parental.name,
		summary: parental.summary,
		price: parental.price,
		duration: parental.duration,
		modality: "Presencial en Pamplona u online",
		bullets: [
			"Cansancio, culpa y autoexigencia",
			"Límites, rabietas y etapas de cambio",
			"Desacuerdos de crianza en la pareja",
		],
		href: parental.href,
	},
];

// Only what main's pricing page already listed for every session.
const includes = [
	{
		icon: "lock",
		title: "Un espacio seguro y confidencial",
		text: "Lo que compartes en sesión queda protegido por el secreto profesional.",
	},
	{
		icon: "tune",
		title: "Atención personalizada",
		text: "Adapto cada sesión a tu situación, a tus necesidades y a tu ritmo.",
	},
	{
		icon: "devices",
		title: "Presencial u online",
		text: "En la consulta de Pamplona o por videollamada, según prefieras. También puedes combinar ambas.",
	},
	{
		icon: "route",
		title: "Acompañamiento durante todo el proceso",
		text: "Te acompaño desde la primera sesión hasta que sientas que puedes seguir por tu cuenta.",
	},
];

const checkIcon =
	"material-symbols-outlined text-primary text-[18px] shrink-0 mt-0.5";
const isPending = (value: string) => value.startsWith("[PENDIENTE");
---

<Layout title={title} description={description}>
	<div class="flex flex-col w-full">
		<div class="relative w-full overflow-hidden">
			<div
				class="absolute -top-32 left-1/2 -translate-x-1/2 w-[720px] h-[400px] bg-gradient-to-b from-primary-fixed/20 via-surface-container/30 to-transparent blur-3xl pointer-events-none -z-10"
			>
			</div>

			<!-- Hero -->
			<section
				class="w-full px-margin-mobile lg:px-margin pt-space-lg lg:pt-space-xl pb-space-lg"
			>
				<div class="max-w-[1240px] mx-auto flex flex-col items-center text-center">
					<h1
						class="font-headline-lg lg:font-display-xl text-headline-lg lg:text-display-xl text-on-surface max-w-4xl tracking-tight mb-space-sm text-balance"
					>
						Tarifas y duración de las sesiones
					</h1>
					<p
						class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl font-light mb-space-md"
					>
						Pagas cada sesión por separado, sin cuotas ni permanencias. Todas las
						sesiones duran 60 minutos y puedes hacerlas en Pamplona u online.
					</p>
				</div>
			</section>

			<!-- Pricing cards -->
			<section class="w-full px-margin-mobile lg:px-margin mb-space-xl">
				<div class="max-w-[1240px] mx-auto">
					<div
						class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter items-stretch"
					>
						{
							plans.map((plan) => (
								<div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md lg:p-space-lg shadow-md">
									<div>
										<h2 class="font-headline-md text-headline-md text-on-surface mb-1 text-balance">
											{plan.title}
										</h2>
										<p class="font-body-sm text-body-sm text-on-surface-variant mb-4">
											{plan.summary}
										</p>
										<div class="flex flex-col my-4 pb-4 rounded-lg p-3 bg-surface-container-low/40">
											{isPending(plan.price) ? (
												<span class="font-label-sm text-label-sm text-primary font-semibold">
													{plan.price}
												</span>
											) : (
												<div class="flex items-baseline gap-1">
													<span class="font-display-xl text-display-xl leading-none font-medium text-primary">
														{plan.price}
													</span>
													<span class="font-body-sm text-body-sm text-slate-muted">
														/ sesión
													</span>
												</div>
											)}
										</div>
										<div class="flex flex-col gap-2 font-body-sm text-body-sm text-on-surface-variant mb-6">
											<div class="flex items-center gap-2">
												<span
													class="material-symbols-outlined text-[18px] text-primary"
													aria-hidden="true"
												>
													schedule
												</span>
												<span>
													<strong>Duración:</strong> {plan.duration}
												</span>
											</div>
											<div class="flex items-center gap-2">
												<span
													class="material-symbols-outlined text-[18px] text-primary"
													aria-hidden="true"
												>
													apartment
												</span>
												<span>{plan.modality}</span>
											</div>
										</div>
										<ul class="space-y-3 pt-2">
											{plan.bullets.map((bullet) => (
												<li class="flex items-start gap-2.5">
													<span class={checkIcon} aria-hidden="true">
														check_circle
													</span>
													<span class="font-body-sm text-body-sm text-on-surface">
														{bullet}
													</span>
												</li>
											))}
										</ul>
									</div>
									<div class="pt-8 flex flex-col gap-3">
										<a
											class="w-full inline-flex items-center justify-center font-label-lg text-label-lg px-5 py-3 rounded-full bg-primary-container text-on-primary-container shadow-md hover:shadow-lg transition-shadow duration-200"
											href={contactHref}
										>
											{ctaLabel}
										</a>
										<a
											class="text-center font-label-lg text-label-lg text-primary underline underline-offset-4 hover:text-on-primary-container"
											href={plan.href}
										>
											Más sobre {plan.title.toLowerCase()}
										</a>
									</div>
								</div>
							))
						}
					</div>
					<p
						class="mt-space-md text-center font-body-md text-body-md text-on-surface-variant max-w-2xl mx-auto"
					>
						¿Primera vez? En la primera sesión revisamos tu situación y tus
						objetivos, y definimos juntos cómo empezar.
					</p>
				</div>
			</section>

			<!-- What each session includes -->
			<section class="w-full px-margin-mobile lg:px-margin mb-space-xl">
				<div
					class="max-w-[1240px] mx-auto rounded-xl bg-surface-container-low p-space-md lg:p-space-xl shadow-sm"
				>
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
						<div class="lg:col-span-5 flex flex-col gap-space-sm">
							<h2 class="font-headline-lg text-headline-lg text-on-surface leading-snug">
								¿Qué incluye cada sesión?
							</h2>
							<p class="font-body-md text-body-md text-on-surface-variant font-light">
								Sea cual sea el formato, cada sesión parte de lo mismo: escucharte
								con calma y trabajar sobre lo que necesitas.
							</p>
							<div class="relative overflow-hidden rounded-xl shadow-md h-56 mt-2">
								<img
									class="w-full h-full object-cover"
									alt="María, psicóloga de Inala, sentada en su consulta junto a una planta."
									src="/maria1.webp"
									loading="lazy"
								/>
								<div
									class="absolute inset-0 bg-gradient-to-t from-inverse-surface/60 via-transparent to-transparent flex items-end p-4"
								>
									<span
										class="text-on-secondary font-label-sm text-label-sm flex items-center gap-1.5 backdrop-blur-md px-3 py-1 rounded-full bg-surface-translucent/30"
									>
										<span class="material-symbols-outlined text-[16px]" aria-hidden="true"
											>nature</span
										>
										Consulta en Pamplona
									</span>
								</div>
							</div>
						</div>
						<div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
							{
								includes.map((item) => (
									<div class="rounded-xl bg-surface-container-lowest p-space-md shadow-sm flex flex-col gap-2">
										<div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary mb-1">
											<span
												class="material-symbols-outlined text-[20px]"
												aria-hidden="true"
											>
												{item.icon}
											</span>
										</div>
										<h3 class="font-title-md text-title-md text-on-surface">
											{item.title}
										</h3>
										<p class="font-body-sm text-body-sm text-on-surface-variant">
											{item.text}
										</p>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>

			<!-- Bottom CTA -->
			<section class="w-full px-margin-mobile lg:px-margin mb-space-xl">
				<div
					class="max-w-[1240px] mx-auto rounded-xl bg-primary text-on-primary p-space-lg lg:p-space-xl shadow-xl relative overflow-hidden"
				>
					<div
						class="absolute -right-24 -bottom-24 w-96 h-96 rounded-full bg-primary-container/20 blur-2xl pointer-events-none"
					>
					</div>
					<div class="max-w-2xl flex flex-col gap-space-sm relative z-10">
						<h2
							class="font-headline-lg lg:font-display-xl text-headline-lg lg:text-display-xl leading-tight text-on-primary text-balance"
						>
							¿Tienes dudas sobre el formato o las tarifas?
						</h2>
						<p class="font-body-lg text-body-lg text-on-primary/90 font-light">
							Escríbeme y lo vemos. Si ya lo tienes claro, solicita tu primera cita.
						</p>
						<div
							class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-sm pt-4"
						>
							<a
								class="inline-flex items-center justify-center font-label-lg text-label-lg px-8 py-3.5 rounded-full bg-on-primary text-primary shadow-lg hover:bg-surface-bright hover:-translate-y-0.5 transition-[translate,background-color] duration-300"
								href={contactHref}
							>
								{ctaLabel}
							</a>
							<a
								class="inline-flex items-center justify-center gap-2 font-label-lg text-label-lg px-6 py-3.5 rounded-full bg-primary-container/30 text-on-primary hover:bg-primary-container/40 transition-colors duration-200 backdrop-blur-sm"
								href={`mailto:${email}`}
							>
								<span class="material-symbols-outlined text-[18px]" aria-hidden="true"
									>mail</span
								>
								<span>Escribirme a {email}</span>
							</a>
						</div>
						<p class="font-body-sm text-body-sm text-on-primary/80">{ctaNote}</p>
					</div>
				</div>
			</section>
		</div>
	</div>
</Layout>
