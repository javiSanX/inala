---
import Accion from "../components/Accion.astro";
import CtaBand from "../components/CtaBand.astro";
import Frase from "../components/Frase.astro";
import Icon from "../components/Icon.astro";
import Lista from "../components/Lista.astro";
import PageHero from "../components/PageHero.astro";
import Relacionados from "../components/Relacionados.astro";
import Layout from "../layouts/Layout.astro";

const incluye = [
	"Sesión de 60 minutos para ti, enfocada en tu bienestar emocional.",
	"Espacio seguro y confidencial para expresarte libremente.",
	"Atención personalizada y adaptada a tus necesidades.",
	"Acceso online o presencial, según tu preferencia.",
	"Acompañamiento profesional durante todo el proceso terapéutico.",
];

const tarifas = [
	{
		title: "Sesion individual u online",
		price: "65",
		links: [
			{
				href: "/servicios/terapia-individual",
				label: "Saber mas individual...",
			},
			{ href: "/servicios/terapia-online", label: "Saber mas online..." },
		],
	},
	{
		title: "Sesion de pareja o familiar",
		price: "75",
		links: [
			{ href: "/servicios/terapia-de-pareja", label: "Saber mas pareja..." },
			{ href: "/servicios/terapia-familiar", label: "Saber mas familiar..." },
		],
	},
];
---

<Layout
	title="Tarifas de Terapia | Precios Psicóloga Sanitaria en Pamplona y Online"
	description="Consulta las tarifas de terapia individual, de pareja, familiar y online. Precios claros, sin sorpresas y con opción de sesiones presenciales en Pamplona u online. Conoce cómo trabajo y el valor de cada proceso terapéutico."
>
	<PageHero
		title="El primer paso hacia tu meta"
		lead="Descubre nuestras tarifas accesibles para servicios de psicología general sanitaria en Inala."
	/>

	<section class="relative z-10 -mt-8 pb-20 lg:-mt-12 lg:pb-28">
		<div class="shell grid gap-6 lg:grid-cols-2">
			{
				tarifas.map((tarifa) => (
					<article class="flex flex-col rounded-card bg-papel shadow-lift">
						<div class="flex items-start justify-between gap-6 border-b border-linea p-6 sm:p-10">
							<h2 class="text-title font-extrabold">{tarifa.title}</h2>
							<p class="tabular shrink-0 text-right leading-none font-extrabold text-camino">
								<span class="text-headline">{tarifa.price}</span>
								<span class="text-title"> €</span>
							</p>
						</div>
						<div class="flex flex-1 flex-col gap-8 p-6 sm:p-10">
							<Lista items={incluye} marker="check" />
							<ul role="list" class="flex flex-wrap gap-x-6 gap-y-2">
								{tarifa.links.map((link) => (
									<li>
										<a
											href={link.href}
											class="inline-flex min-h-11 items-center gap-2 font-semibold text-camino decoration-flecha decoration-2 hover:underline"
										>
											<Icon name="arrow-right" class="size-4" strokeWidth={2.5} />
											{link.label}
										</a>
									</li>
								))}
							</ul>
							<Accion href="/contacto" size="lg" class="mt-auto">
								Reserva tu cita
							</Accion>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<CtaBand
		variant="camino"
		title="Da el primer paso hacia tu bienestar: agenda tu sesión hoy mismo."
		label="reserva tu cita"
	/>

	<Frase
		title="Ahora es el momento de cuidar de ti"
		text="Invertir en tu bienestar emocional es el primer paso hacia una vida más plena y satisfactoria. No esperes más para comenzar tu viaje de autodescubrimiento y crecimiento personal."
	/>

	<Relacionados
		links={[
			{ href: "/servicios/terapia-individual", label: "Terapia individual" },
			{ href: "/servicios/terapia-de-pareja", label: "Terapia de pareja" },
			{ href: "/servicios/terapia-familiar", label: "Terapia familiar" },
			{ href: "/servicios/psicologia-perinatal", label: "Psicología perinatal" },
		]}
	/>
</Layout>
