---
import sessionImage from "../assets/images/maria2.webp";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Figure from "../components/ui/Figure.astro";
import Icon from "../components/ui/Icon.astro";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import TopicList from "../components/ui/TopicList.astro";
import {
	contactHref,
	ctaLabel,
	ctaNote,
	email,
	services,
} from "../data/site";
import Layout from "../layouts/Layout.astro";

const title = "Tarifas | Terapia psicológica en Pamplona y online · Inala";

const description =
	"Tarifas y duración de las sesiones: terapia individual 65 €, de pareja o familiar 75 €. Sesiones de 60 minutos en Pamplona u online por videollamada, sin cuotas ni permanencias.";

const serviceByName = (name: string) => {
	const service = services.find((item) => item.name === name);
	if (!service) throw new Error(`Unknown service: ${name}`);
	return service;
};

const individual = serviceByName("Terapia Individual");

const couple = serviceByName("Terapia de Pareja");

const family = serviceByName("Terapia Familiar");

const perinatal = serviceByName("Psicología Perinatal");

// Prices and durations come from `services` (site.ts), which mirrors main.
const plans = [
	{
		title: individual.name,
		summary: individual.summary,
		price: individual.price,
		duration: individual.duration,
		modality: "Presencial en Pamplona u online",
		bullets: [
			"Para adultos, adolescentes y niños",
			"Ansiedad, desánimo, autoestima, duelo o cambios vitales",
			"Herramientas prácticas para tu día a día",
		],
		href: individual.href,
	},
	{
		title: couple.name,
		summary: couple.summary,
		price: couple.price,
		duration: couple.duration,
		modality: "Presencial en Pamplona u online",
		bullets: [
			"Un espacio neutral: no tomo partido",
			"Comunicación y discusiones que se repiten",
			"Distanciamiento, confianza e intimidad",
		],
		href: couple.href,
	},
	{
		title: family.name,
		summary: family.summary,
		price: family.price,
		duration: family.duration,
		modality: "Presencial en Pamplona u online",
		bullets: [
			"Un espacio donde se escucha a todos",
			"Comunicación y límites en la convivencia",
			"Cambios de etapa, separaciones y pérdidas",
		],
		href: family.href,
	},
	{
		title: perinatal.name,
		summary: perinatal.summary,
		price: perinatal.price,
		duration: perinatal.duration,
		modality: "Presencial en Pamplona u online",
		bullets: [
			"Cansancio, culpa y autoexigencia",
			"Límites, rabietas y etapas de cambio",
			"Desacuerdos de crianza en la pareja",
		],
		href: perinatal.href,
	},
];

// Only what main's pricing page already listed for every session.
const includes = [
	{
		icon: "lock",
		title: "Un espacio seguro y confidencial",
		text: "Lo que compartes en sesión queda protegido por el secreto profesional.",
	},
	{
		icon: "tune",
		title: "Atención personalizada",
		text: "Adapto cada sesión a tu situación, a tus necesidades y a tu ritmo.",
	},
	{
		icon: "devices",
		title: "Presencial u online",
		text: "En la consulta de Pamplona o por videollamada, según prefieras. También puedes combinar ambas.",
	},
	{
		icon: "route",
		title: "Acompañamiento durante todo el proceso",
		text: "Te acompaño desde la primera sesión hasta que sientas que puedes seguir por tu cuenta.",
	},
];

const isPending = (value: string) => value.startsWith("[PENDIENTE");
---

<Layout title={title} description={description}>
	<PageHero title="Tarifas y duración de las sesiones">
		<p class="max-w-2xl text-lead text-ink-muted">
			Pagas cada sesión por separado, sin cuotas ni permanencias. Todas las
			sesiones duran 60 minutos y puedes hacerlas en Pamplona u online.
		</p>
	</PageHero>

	<!-- Tarifas -->
	<Section tone="white" class="pt-4 lg:pt-6">
		<div class="grid border-t border-line md:grid-cols-2 xl:grid-cols-4">
			{
				plans.map((plan) => (
					<div class="row-span-5 grid grid-rows-subgrid gap-y-6 border-b border-line py-10 md:px-8 md:odd:border-r xl:border-b-0 xl:border-r xl:first:pl-0 xl:last:border-r-0 xl:last:pr-0 md:max-xl:odd:pl-0 md:max-xl:even:pr-0">
						<div class="flex flex-col gap-3">
							<h2 class="font-display text-subheading font-normal text-ink">
								{plan.title}
							</h2>
							<p class="text-body text-ink-muted">{plan.summary}</p>
						</div>
						<div class="min-h-16">
							{isPending(plan.price) ? (
								<span class="text-small font-semibold text-ink-soft">
									{plan.price}
								</span>
							) : (
								<div class="flex items-baseline gap-2">
									<span class="font-display text-title font-normal text-teal tabular-nums">
										{plan.price}
									</span>
									<span class="text-small text-ink-muted">/ sesión</span>
								</div>
							)}
						</div>
						<div class="flex flex-col gap-2 border-t border-line pt-5 text-small text-ink">
							<div class="flex items-start gap-2.5">
								<Icon name="schedule" class="mt-0.5 text-teal" />
								<span class="tabular-nums">
									<strong class="font-semibold">Duración:</strong> {plan.duration}
								</span>
							</div>
							<div class="flex items-start gap-2.5">
								<Icon name="location_on" class="mt-0.5 text-teal" />
								<span>{plan.modality}</span>
							</div>
						</div>
						<ul class="flex flex-col gap-2.5">
							{plan.bullets.map((bullet) => (
								<li class="flex items-start gap-2.5 text-small text-ink-muted">
									<Icon name="check" class="mt-0.5 text-teal" />
									<span>{bullet}</span>
								</li>
							))}
						</ul>
						<div class="flex flex-col gap-3">
							<Button href={contactHref}>{ctaLabel}</Button>
							<a
								href={plan.href}
								class="inline-flex min-h-11 items-center justify-center text-small font-semibold text-teal underline decoration-transparent underline-offset-4 transition-[color,text-decoration-color] duration-200 hover:decoration-current"
							>
								Más sobre {plan.title.toLowerCase()}
							</a>
						</div>
					</div>
				))
			}
		</div>
		<p class="mt-10 max-w-2xl text-lead text-ink-muted">
			¿Primera vez? En la primera sesión revisamos tu situación y tus objetivos, y
			definimos juntos cómo empezar.
		</p>
	</Section>

	<!-- Qué incluye cada sesión -->
	<Section>
		<div class="grid gap-x-16 gap-y-12 lg:grid-cols-12">
			<div class="flex flex-col gap-8 lg:col-span-5">
				<SectionHeader title="¿Qué incluye cada sesión?" layout="stack">
					<p>
						Sea cual sea el formato, cada sesión parte de lo mismo: escucharte con
						calma y trabajar sobre lo que necesitas.
					</p>
				</SectionHeader>
				<Figure
					src={sessionImage}
					alt="María, psicóloga de Inala, sentada en un sillón azul en su consulta."
					ratio="tall"
					sizes="(min-width: 1024px) 34vw, 100vw"
				>
					<Icon name="location_on" class="text-teal" />
					<span>Consulta en Pamplona</span>
				</Figure>
			</div>
			<div class="lg:col-span-7 lg:pt-2">
				<TopicList items={includes} columns={1} />
			</div>
		</div>
	</Section>

	<CtaBand title="¿Tienes dudas sobre el formato o las tarifas?">
		<p>Escríbeme y lo vemos. Si ya lo tienes claro, solicita tu primera cita.</p>
		<Fragment slot="actions">
			<Button href={contactHref} variant="inverse">{ctaLabel}</Button>
			<Button href={`mailto:${email}`} variant="inverse-outline" icon="mail">
				<span>Escribirme a {email}</span>
			</Button>
		</Fragment>
		<p slot="note">{ctaNote}</p>
	</CtaBand>
</Layout>
