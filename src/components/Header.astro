---
import { contactHref, logoSrc, navLinks, servicesMenu } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string) => (path === href ? "page" : undefined);
const servicesHref = "/servicios";
const inServices = path.startsWith(servicesHref);
---

<header
	class="fixed top-0 inset-x-0 z-50 bg-surface/75 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)] transition-all duration-300"
>
	<div
		class="max-w-[1240px] mx-auto px-margin-mobile lg:px-margin h-20 flex items-center justify-between"
	>
		<a class="flex items-center gap-3 group" href="/">
			<img
				alt="Inala Centro de Psicoterapia"
				class="h-10 w-10 md:h-11 md:w-11 object-contain shrink-0"
				src={logoSrc}
				width="500"
				height="500"
			/>
			<div class="flex flex-col text-left">
				<span
					class="font-headline-md text-headline-sm text-primary tracking-tight font-medium leading-none"
					>INALA</span
				>
				<span
					class="font-label-sm text-label-sm text-slate-muted uppercase tracking-widest mt-0.5"
					>Centro de Psicoterapia</span
				>
			</div>
		</a>
		<nav class="hidden xl:flex items-center gap-8" aria-label="Principal">
			{
				navLinks.map((link) =>
					link.href === servicesHref ? (
						<div class="services-menu group relative">
							<a
								class:list={[
									"font-title-md text-body-md transition-colors py-2 inline-flex items-center gap-1",
									inServices
										? "text-primary"
										: "text-on-surface-variant hover:text-primary",
								]}
								aria-current={current(link.href)}
								aria-haspopup="true"
								href={link.href}
							>
								{link.name}
								<span
									class="material-symbols-outlined text-[18px] transition-transform duration-300 ease-exhale group-hover:rotate-180 group-focus-within:rotate-180 group-data-closed:rotate-0"
									aria-hidden="true"
								>
									expand_more
								</span>
							</a>
							<div class="absolute left-1/2 top-full -translate-x-1/2 pt-3 invisible opacity-0 motion-safe:translate-y-1 transition-[opacity,translate,visibility] duration-300 ease-exhale group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 group-data-closed:invisible group-data-closed:opacity-0">
								<ul class="min-w-64 rounded-2xl bg-surface-container-lowest border border-border-subtle shadow-ethereal p-2">
									{servicesMenu.map((service) => (
										<li>
											<a
												class:list={[
													"block rounded-xl px-4 py-2.5 font-body-md text-body-md transition-colors hover:bg-tint-hover hover:text-primary",
													current(service.href)
														? "text-primary"
														: "text-on-surface-variant",
												]}
												aria-current={current(service.href)}
												href={service.href}
											>
												{service.name}
											</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					) : (
						<a
							class:list={[
								"font-title-md text-body-md transition-colors py-2",
								current(link.href)
									? "text-primary"
									: "text-on-surface-variant hover:text-primary",
							]}
							aria-current={current(link.href)}
							href={link.href}
						>
							{link.name}
						</a>
					),
				)
			}
		</nav>
		<div class="flex items-center gap-space-sm">
			<a
				class="inline-flex items-center justify-center font-label-lg text-label-lg px-6 py-2.5 rounded-full bg-primary text-on-primary shadow-xs hover:opacity-90 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300"
				href={contactHref}
			>
				<span class="material-symbols-outlined text-[18px] mr-1.5"
					>calendar_today</span
				>Reserva tu cita
			</a>
		
		</div>
	</div>
</header>

<script>
	// Escape dismisses the hover/focus dropdown (WCAG 1.4.13); it reopens on the next hover or focus.
	for (const menu of document.querySelectorAll<HTMLElement>(".services-menu")) {
		const reopen = () => delete menu.dataset.closed;
		menu.addEventListener("keydown", (event) => {
			if (event.key === "Escape") menu.dataset.closed = "";
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && menu.matches(":hover")) {
				menu.dataset.closed = "";
			}
		});
		menu.addEventListener("mouseleave", reopen);
		menu.addEventListener("focusout", (event) => {
			if (!menu.contains(event.relatedTarget as Node | null)) reopen();
		});
	}
</script>
