---
// Statistics
// ------------
// Description: A statistics section with a title, a subtitle, a description and a grid of statistics
// Properties:
// - title: The title of the statistics section
// - text: The subtitle of the statistics section

// Components
// - Layout
import { Icon } from 'astro-icon/components';
import Row from '../ui/Row.astro';
import Section from '../ui/Section.astro';
import Card from '../ui/cards/Card.astro';

//Content
// - Data

const datos = [
   {
      iconName: 'heart',
      suffix: '+',
      title: 'Apoyo psicológico seguro y de calidad',
   },
   {
      iconName: 'sun',
      title: 'Comienza tu acompañamiento',
   },
   {
      iconName: 'shield-check',
      title: 'Crecimiento que transforma',
   },
];

// - Props
type Props = {
   title?: string;
   text?: string;
};
---

<Section decoration="all" type="none" classes="pt-0! -pt-20!">
   <Row classes="!p-0 !m-0">
      {
         datos.map(({ iconName, title }) => (
            <Card classes="relative col-span-12 lg:col-span-4 p-0">
               <div class="flex h-full flex-col gap-6 lg:gap-12">
                  <div class=" ">
                     <Icon name={iconName} class="size-20" />
                  </div>
                  <div class="flex flex-col gap-2">
                     <span class="h4 text-2xl! lg:text-3xl! lg:leading-9!">{title}</span>
                  </div>
               </div>
            </Card>
         ))
      }
   </Row>
</Section>
