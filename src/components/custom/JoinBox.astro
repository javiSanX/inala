---
// JoinBox.astro
// ------------
// Description: A join section with a title, a subtitle, a description and a call to action button
// Properties:
// - title: The title of the join section
// - text: The subtitle of the join section

// Components
// - Layout
import Col from '../ui/Col.astro';
import Row from '../ui/Row.astro';
import Section from '../ui/Section.astro';

//Content
// - Data

// - Props
type Props = {
   title?: string;
   subtitle?: string;
   buttonText?: string;
};
const { title = '', subtitle = '', buttonText = '' } = Astro.props;
---

<Section decoration="all" type="alt">
   <Row classes="">
      <Col span="9" classes="self-end justify-self-end">
         <h2 class="md:text-left">{title}</h2>
         <p class="text-lead md:text-left">
            {subtitle}
         </p>
      </Col>
      <Col span="3" classes='flex items-center'>
         <button
            class="cursor-pointer rounded bg-black px-6 py-2 text-2xl text-white hover:bg-gray-800"
            onclick="location.href='/contacto'"
         >
            {buttonText}
         </button>
      </Col>
   </Row>
</Section>
