---
import Col from '../ui/Col.astro';
import Row from '../ui/Row.astro';
import Section from '../ui/Section.astro';

const { title = '', text = '', type = 'alt' } = Astro.props;
---

<Section decoration="all" type={type}>
   <Row classes="mt-15 lg:mt-25">
      <Col span="3" />
      <Col span="9" classes="self-end justify-self-end">
         <h2 class="md:text-right">{title}</h2>
         <p class="text-lead md:text-right">
            {text}
         </p>
      </Col>
   </Row>
</Section>
