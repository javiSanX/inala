---
import Col from '../ui/Col.astro';
import Row from '../ui/Row.astro';
import Section from '../ui/Section.astro';

type Props = {
   title?: string;
   text?: string;
   classes?: string;
};
const { title, text, classes } = Astro.props;
---

<Section classes={`${classes ? classes : ''}`}>
   <Row>
      <Col span="6">
         {title && <h2>{title}</h2>}
         {text && <p>{text}</p>}
      </Col>
   </Row>
</Section>
