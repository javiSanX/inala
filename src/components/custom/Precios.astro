---
import Button from '../ui/Button.astro';
import Card from '../ui/cards/Card.astro';
import Col from '../ui/Col.astro';
import Row from '../ui/Row.astro';
import Section from '../ui/Section.astro';
// - About Section
---

<Section classes="mt-0! pt-0!">
   <Row classes="!gap-5 max-[500px]:px-0">
      <Col span="6">
         <Card>
            <div class="text-lg">
               <div class="flex">
                  <h3>Sesion individual</h3>
                  <h3 class="absolute right-10">50 €</h3>
               </div>

               <ul>
                  <li>Sesión de 60 minutos para ti, enfocada en tu bienestar emocional.</li>
                  <li>Espacio seguro y confidencial para expresarte libremente.</li>
                  <li>Atención personalizada y adaptada a tus necesidades.</li>
                  <li>Acceso online o presencial, según tu preferencia.</li>
                  <li>Acompañamiento profesional durante todo el proceso terapéutico.</li>
                  <li>
                     <a href="/nuestroMetodo">Saber mas...</a>
                  </li>
               </ul>

               <Button style="primary" type="link" link="./contacto" size="lg" classes="absolute right-0 mt-5">
                  Reserva tu cita
               </Button>
            </div>
         </Card>
      </Col>
      <Col span="6">
         <Card>
            <div class="text-lg">
               <div class="flex">
                  <h3>Sesion de pareja</h3>
                  <h3 class="absolute right-10">60 €</h3>
               </div>
               <ul>
                  <li>Sesión de 60 minutos para ti, enfocada en tu bienestar emocional.</li>
                  <li>Espacio seguro y confidencial para expresarte libremente.</li>
                  <li>Atención personalizada y adaptada a tus necesidades.</li>
                  <li>Acceso online o presencial, según tu preferencia.</li>
                  <li>Acompañamiento profesional durante todo el proceso terapéutico.</li>
                  <li>
                     <a href="/nuestroMetodo">Saber mas...</a>
                  </li>
               </ul>
               <Button style="primary" type="link" link="./contacto" size="lg" classes="absolute right-0 mt-5">
                  Reserva tu cita
               </Button>
            </div>
         </Card>
      </Col>
   </Row>
</Section>
