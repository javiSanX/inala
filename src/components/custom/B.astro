---
// Services List
// ------------
// Description: A services section with a title, a subtitle, a description and a grid of services
// Properties:
// - title: The title of the services section
// - text: The subtitle of the services section

// Components
// - Layout
import Col from '../ui/Col.astro';
import Row from '../ui/Row.astro';
import Section from '../ui/Section.astro';
// - Blocks
import TitleSection from '../blocks/basic/TitleSection.astro';
// - UI
import Card from '../ui/cards/Card.astro';

// Content
// - Data
const servicesData = [
   {
      title: 'Branding',
      text: [
         'We help brands find their voice, define their vibe, and show up sharp. Whether you’re starting fresh or need a reset, we build identities that stick — not just visually, but strategically.',
         'Logos are just the start. We craft full systems: typography, color, tone of voice, and usage rules that grow with you — not against you.',
      ],
      image: '/assets/images/image-03.webp',
   },
   {
      title: 'UX design',
      text: [
         'We think through the clicks before we design them. Our UX work is focused on flow, clarity, and making sure users don’t have to ask, “What do I do now?',
         'Wireframes, journeys, structure — we map it all out before the colors show up. Because good UX doesn’t shout, it guides.',
      ],
      image: '/assets/images/image-04.webp',
   },
   {
      title: 'Development',
      text: [
         'We write clean, scalable code that brings your design to life without surprises. Everything’s responsive, accessible, and built to perform.',
         'Whether it’s a marketing site or a complex product UI, we work closely with designers to keep every detail intact — from animations to button states.',
      ],
      image: '/assets/images/image-10.webp',
   },
   {
      title: 'Motion',
      text: [
         'Movement matters. We add motion where it counts — not just to impress, but to guide, delight, and communicate.',
         'From subtle microinteractions to full-blown scroll animations, we help your site feel more alive, more polished, and way more fun to use.',
      ],
      image: '/assets/images/image-19.webp',
   },
];
// - Props
const { title = '', text = '' } = Astro.props;
---

<TitleSection
   title="Stuff we think, and some times regret."
   text="Tips, rants, and stories from the design side of the internet. Smart takes on branding, digital, and creative work."
   link="/blog"
   classes="lg:pb-15!"
/>

<Section stickyCol classes="overflow-visible! ">
   {
      servicesData.map((service: any, index: number) => (
         <Row classes="mb-12 ">
            <Col span="4" classes="h-full min-w-[420px] max-w-[460px] w-full ">
               <div class="sticky top-32 hidden lg:block">
                  <h3 class="mb-2 flex flex-col justify-start gap-3 text-4xl! md:flex-row lg:text-5xl!">
                     <span class="text-primary-500 hidden xl:block!">
                        {String(index + 1).padStart(2, '0')}
                     </span>
                     {service.title}
                  </h3>
               </div>
            </Col>
            <Col span="8" classes="h-full w-full grow">
               <Card
                  title={service.title}
                  cardHeaderClasses="block lg:hidden!"
                  classes="h-full w-full"
                  cardBodyClasses="h-full lg:pt-7.5! "
                  cardMediaClasses="lg:order-2 h-[400px]"
                  orientation="horizontal"
                  image={service.image}
               >
                  {service.text.map((text: string) => (
                     <p class="relative z-10 text-lg">{text}</p>
                  ))}
               </Card>
            </Col>
         </Row>
      ))
   }
</Section>
