---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import TitleSection from '../custom/TitleSection.astro';
import Card from '../ui/cards/Card.astro';
import Col from '../ui/Col.astro';
import Row from '../ui/Row.astro';
import Section from '../ui/Section.astro';
---

<Section classes="mt-0! pt-0!">
   <TitleSection
      title="Nuestros Servicios"
      text="Conoce nuestros servicios de psicología, pensados para ofrecerte apoyo profesional y personalizado en cada etapa de tu bienestar emocional."
      classes="lg:pb-15! pl-0!"
   />
   <Row classes="!gap-5 max-[500px]:px-0">
      <Col span="6">
         <Card>
            <Image
               src={'/assets/images/maria4.png'}
               alt={'imagen 02'}
               width={800}
               height={800}
               inferSize
               class="object-cover aspect-[3/4]"
            />
         </Card>
      </Col>
      <Col span="6" classes="flex flex-col gap-5">
         <Card>
            <div class="mb-4 flex items-center gap-4">
               <h3>Terapia individual</h3>
            </div>

            <p class="">
               Tanto para niñas/os , adolescentes y adultos. Orientado a mejorar el bienestar
               emocional desde un acompañamiento integral.
            </p>
         </Card>
         <Card>
            <div class="mb-4 flex items-center gap-4">
               <h3>Terapia de pareja</h3>
            </div>
            <p class="">
               Acompañamiento en un entorno neutral de la dinámica relacional, la comunicación y
               fortalecer el vínculo afectivo.
            </p>
         </Card>
         <Card>
            <div class="mb-4 flex items-center gap-4">
               <h3>Terapia familiar</h3>
            </div>
            <p class="">
               Un espacio donde mirar las dinámicas que generan malestar, recuperar el diálogo y
               construir relaciones saludables.
            </p>
         </Card>
         <Card>
            <div class="mb-4 flex items-center gap-4">
             
               <h3>Acompañamiento psicológico perinatal</h3>
            </div>
            <p class="">
               Un espacio seguro y confidencial donde explorar, comprender y gestionar las emociones
               que surgen durante el embarazo, parto y posparto.
            </p>
         </Card>
      </Col>
   </Row>
</Section>
