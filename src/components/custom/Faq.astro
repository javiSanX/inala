---
import Col from '../ui/Col.astro';
import Row from '../ui/Row.astro';
import Section from '../ui/Section.astro';
import Card from '../ui/cards/Card.astro';

const preguntas = [
   {
      question: '¿La terapia es presencial, online o ambas?',
      answer:
         'Es tanto terapia presencial y online. Depende de lo que quieras.',
   },

   {
      question: '¿Qué tipos de terapia ofrecen?',
      answer:
         'Depende de cada persona y sus necesidades. Desde INALA el abordaje es integral, por lo que se ajusta a cada persona.',
   },
   {
      question: '¿Con qué frecuencia recomiendas asistir a terapia?',
      answer:
         'Depende de cada persona y la situación en la que se encuentre.',
   },
   {
      question: '¿Cuánto dura cada sesión?',
      answer:
         '60 minutos',
   },
   {
      question: '¿Trabajan con adultos, adolescentes y/o niños?',
      answer:
         'Si, trabajamos tanto con con niños/as, adolescentes y adultos',
   },
];
---

<Section decoration="all" type="" classes="">
   <Row classes="">
      <Col span="5">
         <h2 class="text-left">Preguntas Frecuentes</h2>
      </Col>
      <Col span="7">
         {
            preguntas.map((pregunta) => (
               <Card classes="mb-5">
                  <details class="group">
                     <summary class="flex cursor-pointer list-none items-center justify-between">
                        <h4 class="!m-0 p-0">{pregunta.question}</h4>
                        <span class="transition group-open:rotate-180">
                           <svg
                              fill="none"
                              height="24"
                              shape-rendering="geometricPrecision"
                              stroke="currentColor"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="1.5"
                              viewBox="0 0 24 24"
                              width="24"
                           >
                              <path d="M6 9l6 6 6-6" />
                           </svg>
                        </span>
                     </summary>
                     <p class="group-open:animate-fadeIn mt-3">
                        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
                        tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam,
                        quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo
                        consequat.
                     </p>
                  </details>
               </Card>
            ))
         }
      </Col>
   </Row>
</Section>
