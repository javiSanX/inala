---
// A reassuring sentence that closes a section, set as a quiet statement.
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["flex items-start gap-4 border-t border-line pt-8", className]}>
	<span class="mt-[0.7em] h-px w-10 shrink-0 bg-seafoam" aria-hidden="true"></span>
	<p class="max-w-3xl font-display text-subheading font-normal text-ink">
		<slot />
	</p>
</div>
