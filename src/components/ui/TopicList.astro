---
// Editorial list for topics, audiences and features: hairline rules and type,
// not a grid of icon cards.
interface Topic {
	title: string;
	text: string;
	/** Small trailing line kept from the content (a tag or a short call). */
	note?: string;
}

interface Props {
	items: Topic[];
	columns?: 1 | 2 | 3;
	/** "grid": columns of short entries. "rows": one entry per row, heading beside its text. */
	layout?: "grid" | "rows";
	level?: 3 | 4;
	/** Number each item: only for sequences the reader follows in order. */
	numbered?: boolean;
	/** Two-digit numbers (01, 02) or plain ones (1, 2), as the content had them. */
	pad?: boolean;
	/** "display" sets the numerals at display size above each step. */
	numerals?: "inline" | "display";
	class?: string;
}

const {
	items,
	columns = 3,
	layout = "grid",
	level = 3,
	numbered = false,
	pad = true,
	numerals = "inline",
	class: className,
} = Astro.props;

const Heading = `h${level}` as "h3" | "h4";
const grid = {
	1: "grid-cols-1",
	2: "sm:grid-cols-2",
	3: "sm:grid-cols-2 lg:grid-cols-3",
};
const List = numbered ? "ol" : "ul";
const rows = layout === "rows";
const display = numbered && numerals === "display";
const number = (index: number) =>
	pad ? String(index + 1).padStart(2, "0") : index + 1;
---

<List
	class:list={[
		rows ? "border-b border-line" : ["grid gap-x-10", grid[columns]],
		className,
	]}
>
	{
		items.map((item, index) => (
			<li
				class:list={[
					"border-t border-line",
					rows
						? "grid gap-x-12 gap-y-3 py-8 md:grid-cols-12"
						: display
							? "flex flex-col gap-5 pb-8 pt-6"
							: "flex gap-5 py-7",
				]}
			>
				{numbered && (
					<span
						class:list={[
							"font-display leading-none text-teal tabular-nums",
							display ? "text-display" : "w-8 shrink-0 text-subheading",
						]}
						aria-hidden="true"
					>
						{number(index)}
					</span>
				)}
				{rows ? (
					<>
						<Heading class="font-display text-subheading font-normal text-ink md:col-span-5">
							{item.title}
						</Heading>
						<div class="flex flex-col gap-2 md:col-span-7 md:pt-1">
							<p class="text-body text-ink-muted">{item.text}</p>
							{item.note && <p class="text-small text-ink-soft">{item.note}</p>}
						</div>
					</>
				) : (
					<div class="flex flex-col gap-2.5">
						<Heading class="text-lead font-semibold text-ink">{item.title}</Heading>
						<p class="text-body text-ink-muted">{item.text}</p>
						{item.note && <p class="mt-1 text-small text-ink-soft">{item.note}</p>}
					</div>
				)}
			</li>
		))
	}
</List>
