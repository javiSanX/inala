---
import { type IconName, icons } from "./icons";

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
	class:list={["size-[1.25em] shrink-0", className]}
	viewBox="0 -960 960 960"
	fill="currentColor"
	aria-hidden="true"
	focusable="false"
>
	<path d={icons[name]}></path>
</svg>
