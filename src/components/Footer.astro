---
import { Image } from "astro:assets";
import {
	address,
	addressCenter,
	addressCity,
	contactHref,
	crisisNotice,
	email,
	instagramUrl,
	legalLinks,
	logo,
	navLinks,
	serviceMenuLinks,
} from "../data/site";
import Icon from "./ui/Icon.astro";

const footerNav = navLinks.filter((link) => link.href !== "/servicios");
const year = new Date().getFullYear();
const link =
	"inline-flex min-h-10 items-center text-small text-on-dark-muted transition-[color] duration-200 hover:text-white";
const heading = "mb-3 text-label font-semibold text-seafoam";
const iconLink =
	"grid size-11 place-items-center rounded-full border border-cypress-line text-on-dark transition-[border-color,color] duration-200 hover:border-seafoam hover:text-seafoam";
---

<footer class="on-dark border-t border-cypress-line bg-cypress text-on-dark">
	<div class="mx-auto max-w-content px-5 pb-10 pt-16 sm:px-8 lg:px-10 lg:pt-20">
		<div class="grid gap-x-10 gap-y-12 md:grid-cols-2 lg:grid-cols-12">
			<div class="flex flex-col gap-4 lg:col-span-4">
				<div class="flex items-center gap-3">
					<Image
						src={logo}
						alt=""
						width={36}
						height={36}
						densities={[1, 2]}
						class="size-9"
					/>
					<span class="font-display text-2xl font-medium tracking-wide">INALA</span>
				</div>
				<p class="max-w-sm text-small text-on-dark-muted">
					Psicoterapia para adultos, parejas y familias en Pamplona y online, con
					María Sánchez, psicóloga general sanitaria.
				</p>
				<p class="inline-flex w-fit items-center gap-2 text-label font-semibold text-seafoam">
					<Icon name="verified" />
					<span>Espacio seguro y confidencial</span>
				</p>
			</div>
			<nav class="lg:col-span-2" aria-label="Navegación">
				<h2 class={heading}>Navegación</h2>
				<ul>
					{
						footerNav.map((item) => (
							<li>
								<a class={link} href={item.href}>
									{item.name}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<nav class="lg:col-span-3" aria-label="Servicios">
				<h2 class={heading}>Servicios</h2>
				<ul>
					{
						serviceMenuLinks.map((service) => (
							<li>
								<a class={link} href={service.href}>
									{service.name}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<div class="flex flex-col gap-3 lg:col-span-3">
				<h2 class={heading}>Contacto</h2>
				<p class="flex items-start gap-2.5 text-small text-on-dark-muted">
					<Icon name="mail" class="mt-0.5 text-seafoam" />
					<a class="transition-[color] duration-200 hover:text-white" href={`mailto:${email}`}
						>{email}</a
					>
				</p>
				<p class="flex items-start gap-2.5 text-small text-on-dark-muted">
					<Icon name="location_on" class="mt-0.5 text-seafoam" />
					<span>{address} ({addressCenter}) · {addressCity} · y online</span>
				</p>
				<div class="mt-2 flex items-center gap-2">
					<a class={iconLink} href={instagramUrl} target="_blank" rel="noopener">
						<Icon name="photo_camera" />
						<span class="sr-only">Instagram de Inala (se abre en una pestaña nueva)</span>
					</a>
					<a class={iconLink} href={contactHref}>
						<Icon name="calendar_today" />
						<span class="sr-only">Solicitar primera cita</span>
					</a>
				</div>
			</div>
		</div>
		<div
			class="mt-14 flex items-start gap-3 border-t border-cypress-line pt-6 text-small text-on-dark"
			role="note"
		>
			<Icon name="info" class="mt-0.5 text-seafoam" />
			<p>{crisisNotice}</p>
		</div>
		<div
			class="mt-10 flex flex-col gap-4 border-t border-cypress-line pt-6 text-label text-on-dark-muted md:flex-row md:items-center md:justify-between"
		>
			<p>© {year} INALA Centro de Psicoterapia. Todos los derechos reservados.</p>
			<div class="flex flex-wrap items-center gap-x-6">
				{
					legalLinks.map((item) => (
						<a
							class="inline-flex min-h-10 items-center transition-[color] duration-200 hover:text-white"
							href={item.href}
						>
							{item.name}
						</a>
					))
				}
			</div>
		</div>
	</div>
</footer>
