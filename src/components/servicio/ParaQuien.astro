---
// Who the service is for: ruled rows on the credential, heading beside its text.
interface Props {
	title: string;
	items: { title: string; text: string }[];
}

const { title, items } = Astro.props;
---

<section class="py-20 lg:py-28">
	<div class="shell">
		<h2 class="max-w-3xl text-headline font-extrabold">{title}</h2>
		<ul role="list" class="mt-12 border-t-2 border-tinta">
			{
				items.map((item) => (
					<li class="grid gap-3 border-b border-linea py-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 lg:py-10">
						<h3 class="text-title">{item.title}</h3>
						<p class="measure text-lead text-tinta-suave">{item.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
