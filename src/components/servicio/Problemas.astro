---
import Lista from "../Lista.astro";

// The issues worked on, as one printed list on a card.
interface Props {
	title: string;
	items: string[];
}

const { title, items } = Astro.props;
---

<section class="py-20 lg:py-28">
	<div class="shell grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
		<h2 class="text-headline font-extrabold">{title}</h2>
		<div class="rounded-card bg-papel p-6 shadow-card sm:p-10">
			<Lista items={items} columns class="text-lead" />
		</div>
	</div>
</section>
