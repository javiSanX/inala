---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Figure from "./ui/Figure.astro";

interface Props {
	/** Plain h1 text; use the "title" slot instead when it carries markup. */
	title?: string;
	/** Page label kept from the content, set as a subtitle under the h1. */
	label?: string;
	image?: ImageMetadata;
	imageAlt?: string;
	imageRatio?: "portrait" | "tall" | "landscape" | "square";
	/** Narrow pages without an image use a single centred-left column. */
	size?: "display" | "title";
	/** Colour the emphasised run of the h1 (home only, where it marks the audiences). */
	accent?: boolean;
	/** Decorative full-bleed background; the hero is at least as tall as the image at full width. */
	backgroundImage?: ImageMetadata;
}

const {
	title,
	label,
	image,
	imageAlt = "",
	imageRatio = "portrait",
	size = "title",
	accent = false,
	backgroundImage,
} = Astro.props;

const hasMedia = Boolean(image) || Astro.slots.has("media");
const hasCaption = Astro.slots.has("caption");
---

<section
	class:list={[
		"bg-paper pb-24 lg:pb-24",
		// The background hero slides under the transparent header: -mt-18 and +4.5rem of top padding.
		backgroundImage
			? "relative isolate -mt-18 overflow-hidden pt-42 lg:pt-42"
			: "pt-24 lg:pt-24",
	]}
	style={backgroundImage &&
		`min-height: calc(100vw * ${backgroundImage.height} / ${backgroundImage.width})`}
>
	{
		backgroundImage && (
			<Picture
				src={backgroundImage}
				alt=""
				formats={["avif", "webp"]}
				widths={[640, 960, 1376]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
				class="absolute inset-0 -z-10 size-full object-cover object-left-top"
			/>
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/4 bg-linear-to-b from-transparent to-white"
			/>
		)
	}
	<div class="mx-auto max-w-content px-5 sm:px-8 lg:px-10">
		<div
			class:list={[
				"grid gap-x-16 gap-y-12",
				hasMedia ? "lg:grid-cols-12 lg:items-center" : "max-w-3xl",
			]}
		>
			<div class:list={["hero-copy flex flex-col gap-6", hasMedia && "lg:col-span-7"]}>
				{Astro.slots.has("eyebrow") && (
					<div class="self-start">
						<slot name="eyebrow" />
					</div>
				)}
				<h1
					class:list={[
						"font-display font-normal text-ink [&_em]:not-italic",
						accent && "[&_span]:text-teal",
						size === "display" ? "text-display" : "text-title",
					]}
				>
					{title}<slot name="title" />
				</h1>
				{
					label && (
						<p class="font-display text-subheading text-ink-muted">{label}</p>
					)
				}
				<slot />
				{
					backgroundImage && hasCaption && (
						<p class="flex items-center gap-2 text-label text-ink-muted">
							<slot name="caption" />
						</p>
					)
				}
			</div>
			{
				hasMedia && (
					<div class="hero-media lg:col-span-5">
						{image && hasCaption && (
							<Figure
								src={image}
								alt={imageAlt}
								ratio={imageRatio}
								priority
								sizes="(min-width: 1024px) 34vw, 100vw"
							>
								<slot name="caption" />
							</Figure>
						)}
						{image && !hasCaption && (
							<Figure
								src={image}
								alt={imageAlt}
								ratio={imageRatio}
								priority
								sizes="(min-width: 1024px) 34vw, 100vw"
							/>
						)}
						{!image && <slot name="media" />}
					</div>
				)
			}
		</div>
	</div>
</section>
