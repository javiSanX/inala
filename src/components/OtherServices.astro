---
import { servicesMenu } from "../data/site";

// Closing section for every service page: compact links to all services,
// with the page being viewed marked as current.
const path = Astro.url.pathname.replace(/\/$/, "");
---

<section
	class="w-full px-margin-mobile lg:px-margin py-10 bg-surface-container-lowest border-t border-border-subtle"
	aria-labelledby="otros-servicios"
>
	<div
		class="max-w-content mx-auto flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5"
	>
		<h2
			id="otros-servicios"
			class="font-title-md text-title-md text-on-surface shrink-0"
		>
			Otros servicios
		</h2>
		<ul class="flex flex-wrap gap-2">
			{
				servicesMenu.map((service) => {
					const current = service.href === path;
					return (
						<li>
							<a
								href={service.href}
								aria-current={current ? "page" : undefined}
								class:list={[
									"inline-flex items-center gap-1.5 px-4 py-2 rounded-full border font-label-lg text-label-lg transition-colors duration-200",
									current
										? "bg-secondary-container text-primary border-transparent"
										: "border-border-soft text-on-surface-variant hover:bg-tint-hover hover:text-primary",
								]}
							>
								<span
									class="material-symbols-outlined text-[18px]"
									aria-hidden="true"
								>
									{service.icon}
								</span>
								{service.name}
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
