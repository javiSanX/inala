---
import { serviceMenuLinks } from "../data/site";

// Closing section for every service page: compact links to all services,
// with the page being viewed marked as current. It sits on the cypress field
// between the closing call to action and the footer.
const path = Astro.url.pathname.replace(/\/$/, "");
---

<section
	class="on-dark border-t border-cypress-line bg-cypress text-on-dark"
	aria-labelledby="otros-servicios"
>
	<div
		class="mx-auto flex max-w-content flex-col gap-6 px-5 py-12 sm:px-8 lg:flex-row lg:items-center lg:justify-between lg:px-10"
	>
		<h2 id="otros-servicios" class="font-display text-subheading font-normal">
			Otros servicios
		</h2>
		<ul class="flex flex-wrap gap-2">
			{
				serviceMenuLinks.map((service) => {
					const current = service.href === path;
					return (
						<li>
							<a
								href={service.href}
								aria-current={current ? "page" : undefined}
								class:list={[
									"inline-flex min-h-11 items-center rounded-full border px-5 text-small font-semibold transition-[background-color,border-color,color] duration-200",
									current
										? "border-seafoam bg-seafoam text-cypress"
										: "border-cypress-line text-on-dark hover:border-seafoam hover:text-seafoam-soft",
								]}
							>
								{service.name}
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
