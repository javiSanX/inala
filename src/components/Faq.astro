---
import Icon from "./Icon.astro";

interface Props {
	items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<section class="py-20 lg:py-28">
	<div class="shell grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
		<h2 class="text-headline font-extrabold">Preguntas Frecuentes</h2>
		<div class="rounded-card bg-papel shadow-card">
			{
				items.map((item) => (
					<details class="group border-b border-linea last:border-b-0">
						<summary class="flex cursor-pointer list-none items-start justify-between gap-6 px-5 py-5 text-lead font-semibold transition-colors duration-200 hover:text-camino sm:px-7 [&::-webkit-details-marker]:hidden">
							<span>{item.question}</span>
							<span class="mt-1 grid size-8 shrink-0 place-items-center rounded-full bg-piedra text-camino transition-[transform,background-color] duration-300 ease-out-expo group-open:rotate-45 group-open:bg-flecha group-open:text-tinta motion-reduce:transition-none">
								<Icon name="plus" class="size-4" strokeWidth={2.5} />
							</span>
						</summary>
						<p class="measure px-5 pb-6 text-tinta-suave sm:px-7">{item.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>
