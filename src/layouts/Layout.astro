---
import '@fontsource-variable/inter';
import '@fontsource-variable/outfit';
import { ClientRouter } from 'astro:transitions';
import 'swiper/css';
import 'swiper/css/autoplay';
import Footer from '../components/ui/Footer.astro';
import Main from '../components/ui/Main.astro';
import NavigationBar from '../components/ui/NavigationBar.astro';
import CookieBanner from '../components/custom/CookieBanner.astro';
import { googleSiteVerification, googleTagManagerID, googleAnalyticsMeasurementID } from '../config/analytics';
import Scripts from '../scripts/ThemeScripts.astro';
import '../styles/global.css';

// Props
type Props = {
   title?: string;
   description?: string;
   ogImage?: string;
   canonical?: string;
   ogType?: 'website' | 'article';
   noindex?: boolean;
   navigation?: 'none' | 'transparent' | 'sticky';
   footer?: 'none' | 'basic';
   structuredData?: Record<string, any> | Record<string, any>[];
};

const {
   title,
   description,
   ogImage = '/og.png',
   canonical,
   ogType = 'website',
   noindex = false,
   navigation = 'sticky',
   structuredData,
} = Astro.props;

const canonicalUrl = canonical ?? Astro.url.href;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;

const businessLdJson = {
   '@context': "https://schema.org",
   '@type': 'Psychologist',
   name: 'Maria Sanchez Cobos',
   image: ogImageUrl,
   '@id': `${canonicalUrl}#psychologist`,
   url: canonicalUrl,
   telephone: '+34 623 050 773',
   priceRange: '€50',
   description,
   address: {
      '@type': 'PostalAddress',
      streetAddress: 'Maria Lacunza 6, portal 4',
      addressLocality: 'Pamplona',
      postalCode: '31011',
      addressRegion: 'Navarra',
      addressCountry: 'ES',
   },
   geo: {
      '@type': 'GeoCoordinates',
      latitude: 42.8125,
      longitude: -1.6458,
   },
   areaServed: {
      '@type': 'City',
      name: 'Pamplona',
      url: 'https://es.wikipedia.org/wiki/Pamplona',
   },
   sameAs: [
      'https://www.instagram.com/inala_psicoterapia/',
      'https://www.facebook.com/inala.psicoterapia',
      'https://g.page/inala-psicoterapia',
   ],
   openingHoursSpecification: [
      {
         '@type': 'OpeningHoursSpecification',
         dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
         opens: '09:00',
         closes: '20:00',
      },
   ],
   makesOffer: [
      {
         '@type': 'Offer',
         itemOffered: {
            '@type': 'Service',
            name: 'Terapia individual',
            description: 'Sesiones de terapia individual adaptadas a tus necesidades y objetivos.',
            areaServed: ['Pamplona', 'España'],
         },
      },
      {
         '@type': 'Offer',
         itemOffered: {
            '@type': 'Service',
            name: 'Terapia de pareja',
            description:
               'Apoyo para parejas que buscan mejorar la comunicación, resolver conflictos y fortalecer la relación.',
            areaServed: ['Pamplona', 'España'],
         },
      },
      {
         '@type': 'Offer',
         itemOffered: {
            '@type': 'Service',
            name: 'Terapia familiar',
            description:
               'Sesiones dirigidas a familias para mejorar la dinámica, comunicación y resolución de conflictos.',
            areaServed: ['Pamplona', 'España'],
         },
      },
      {
         '@type': 'Offer',
         itemOffered: {
            '@type': 'Service',
            name: 'Terapia parental',
            description:
               'Apoyo a padres y madres para gestionar la crianza, emociones y educación de los hijos.',
            areaServed: ['Pamplona', 'España'],
         },
      },
   ],
};

const ldJson = [businessLdJson].concat(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []);

---

<!doctype html>
<html lang="es" class="scroll-animation mode-auto light">
   <head>
      <script type="application/ld+json" set:html={JSON.stringify(ldJson)}></script>

      {googleAnalyticsMeasurementID && 
         <>
            <!-- Google Analytics with Consent Mode -->
            <script type="text/partytown" define:vars={{measurementId: googleAnalyticsMeasurementID}}>
               // Initialize consent mode
               window.dataLayer = window.dataLayer || [];
               function gtag(){dataLayer.push(arguments);}
               
               // Set default consent state (denied by default for GDPR compliance)
               gtag('consent', 'default', {
                  'analytics_storage': 'denied',
                  'ad_storage': 'denied',
                  'wait_for_update': 500,
               });
               
               gtag('js', new Date());
               gtag('config', measurementId, {
                  'anonymize_ip': true,
                  'allow_google_signals': false,
                  'allow_ad_personalization_signals': false
               });
            </script>
            
            <script
               type="text/partytown"
               src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsMeasurementID}`}>
            </script>
         </>
      }
      {googleTagManagerID &&
         <script type="text/partytown" data-gtm-measurement-id={googleTagManagerID} id="gtm-init">
            const tagtId = document.getElementById('gtm-init').getAttribute('data-gtm-measurement-id')
            ;(function (w, d, s, l, i) {
               w[l] = w[l] || []
               w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
               var f = d.getElementsByTagName(s)[0],
               j = d.createElement(s),
               dl = l != 'dataLayer' ? '&l=' + l : ''
            j.async = true
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
            f.parentNode.insertBefore(j, f)
            })(window, document, 'script', 'dataLayer', tagtId)
         </script>
      }
      {
         googleSiteVerification && (
            <meta name="google-site-verification" content={googleSiteVerification} />
         )
      }
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{title}</title>
      <meta name="description" content={description} />
      <meta property="og:type" content={ogType} />
      <meta property="og:url" content={canonicalUrl} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:image" content={ogImageUrl} />
      <meta property="twitter:card" content="summary_large_image" />
      <meta property="twitter:url" content={canonicalUrl} />
      <meta property="twitter:title" content={title} />
      <meta property="twitter:description" content={description} />
      <meta property="twitter:image" content={ogImageUrl} />
      <link rel="canonical" href={canonicalUrl} item-prop="url" />
      {noindex && <meta name="robots" content="noindex,nofollow" />}
      <link rel="icon" href="/logo-light.webp" type="image/webp" />
      <link rel="sitemap" href="/sitemap-index.xml" />
      <meta name="generator" content={Astro.generator} />
      <meta name="theme-color" content="#134e4a" />
      <ClientRouter fallback="swap" />
   </head>
   <body class="mode-light scroll-animation light">
      {
         googleTagManagerID && (
            <noscript>
               <iframe
                  src={`https://www.googletagmanager.com/ns.html?id=${googleTagManagerID}`}
                  height="0"
                  width="0"
                  style="display:none;visibility:hidden"
               />
            </noscript>
         )
      }
      <NavigationBar type={navigation} />
      <Main>
         <slot />
      </Main>
      <Footer />
      <CookieBanner />
      <Scripts />
   </body>
</html>
